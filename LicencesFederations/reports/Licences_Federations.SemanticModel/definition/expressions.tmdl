/// Outil de développement (non chargé) : génère le code DAX de la table Param_Federation à partir des regroupements de T_Federation. Copier le résultat dans la table calculée Param_Federation après un changement de regroupements.
expression Code_Param_Federation =
		let
		    Source  = T_Federation,
		    Deplie  = Table.UnpivotOtherColumns(
		                  Table.SelectColumns(Source, {"Famille de fédérations", "Sous-famille de fédérations", "Groupe de fédérations"}),
		                  {}, "NiveauSrc", "Valeur"),
		    Uniques = Table.Distinct(Table.SelectRows(Deplie, each [Valeur] <> null and [Valeur] <> "")),
		    Infos   = Table.AddColumn(Uniques, "Info", each
		                  if [NiveauSrc] = "Famille de fédérations" then [p = "F · ", n = "Famille", o = 1]
		                  else if [NiveauSrc] = "Sous-famille de fédérations" then [p = "SF · ", n = "Sous-famille", o = 2]
		                  else [p = "G · ", n = "Groupe", o = 3]),
		    Tri     = Table.Sort(Infos, {{each [Info][o], Order.Ascending}, {"Valeur", Order.Ascending}}),
		    Index   = Table.AddIndexColumn(Tri, "i", 1, 1),
		    Q       = (t as text) => """" & Text.Replace(t, """", """""") & """",
		    Lignes  = Table.AddColumn(Index, "Ligne", each
		                  "    (" & Q([Valeur]) &
		                  ", NAMEOF('P_Federation'[" & Text.Replace([Info][p] & [Valeur], "]", "]]") & "]), " &
		                  Text.From([i]) & ", " & Q([Info][n]) & ", " & Q([Info][p] & [Valeur]) & ")"),
		    Code    = "Param_Federation = {#(lf)" &
		              "    (""Ensemble"", NAMEOF('P_Federation'[Ensemble]), 0, ""Ensemble"", ""Ensemble""),#(lf)" &
		              Text.Combine(Lignes[Ligne], ",#(lf)") & "#(lf)}"
		in
		    Code
	lineageTag: f562dd99-3076-4580-8560-197b27f3223a
	queryGroup: 'Tables de paramètres'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

/// Fonction de lecture d'un onglet du référentiel Excel (nettoyage commun aux 5 tables de dimension).
expression fnLireReferentiel =
		// =====================================================================
		// fnLireReferentiel : lit un onglet du référentiel Excel et le nettoie.
		//   Feuille          : nom de l'onglet (T_Federation, T_Territoire, T_Sexe, T_TrancheAge, T_Annee)
		//   ColonnesInutiles : colonnes à retirer (ex. EnBase, posée par la synchronisation SQL du classeur)
		// Les 5 tables de dimension appellent cette fonction : une seule logique de lecture à maintenir.
		// =====================================================================
		(Feuille as text, optional ColonnesInutiles as nullable list) as table =>
		let
		    // 1. Classeur (chemin = paramètre Dossier)
		    Source     = Excel.Workbook(File.Contents(Dossier & "Referentiel_Excel.xlsx"), null, true),
		    // 2. Onglet demandé (feuille de calcul, pas tableau nommé)
		    Onglet     = Source{[Item = Feuille, Kind = "Sheet"]}[Data],
		    // 3. Première ligne = en-têtes
		    Entetes    = Table.PromoteHeaders(Onglet, [PromoteAllScalars = true]),
		    Colonnes   = Table.ColumnNames(Entetes),
		    // 4. Erreurs Excel (#N/A, #REF!...) remplacées par null
		    SansErreur = Table.ReplaceErrorValues(Entetes, List.Transform(Colonnes, each {_, null})),
		    // 5. Valeurs « manquantes » saisies à la main remplacées par null
		    SansNA     = Table.ReplaceValue(SansErreur, each _, each _,
		                     (v, a, b) => if List.Contains({"NA", "N/A", "#N/A", "n.d", ""}, v) then null else v, Colonnes),
		    // 6. Retrait des colonnes techniques (sans erreur si elles n'existent pas)
		    Resultat   = Table.RemoveColumns(SansNA, if ColonnesInutiles = null then {} else ColonnesInutiles, MissingField.Ignore)
		in
		    Resultat
	lineageTag: 2aab30d1-c9bb-46a5-96d4-f06493357059
	queryGroup: Fonctions

	annotation PBI_ResultType = Function

