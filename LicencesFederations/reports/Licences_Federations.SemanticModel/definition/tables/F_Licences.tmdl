		isHidden
		lineageTag: 3f75038a-3f91-46ab-ab65-041f9034b2cc
		summarizeBy: none
		sourceColumn: Code_DEP

	partition F_Licences = m
		mode: import
		queryGroup: 'Tables de faits'
		source =
				let
				  Source = Sql.Database("diouet", "BDD"),
				  #"Navigation 1" = Source{[Schema = "dbo", Item = "Licences_Federation"]}[Data],
				  // Clé territoire stable : code département (ex. « 31 », « 2A », « 971 », « NR »), indépendant du libellé
				  CodeDep = Table.AddColumn(#"Navigation 1", "Code_DEP", each Text.Trim(Text.BeforeDelimiter(Text.From([Departement]), " - ")), type text)
				in
				  CodeDep

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

