	/// Nom de la fédération sans le préfixe « Fédération Française de … » (calculé dans Power Query). Utilisé dans les segments, titres et légendes.
	column 'Nom court'
		dataType: string
		lineageTag: 868b508d-6598-4b97-a383-3e1478e872a0
		summarizeBy: none
		sourceColumn: Nom court

	partition T_Federation = m
		mode: import
		queryGroup: 'Tables de dimensions'
		source =
				let
				    Source     = Excel.Workbook(File.Contents(Dossier & "Referentiel_Excel.xlsx"), null, true),
				    Feuilles   = Table.SelectRows(Source, each ([Kind] = "Sheet")),
				    Navigation = Feuilles{[Item = "T_Federation", Kind = "Sheet"]}[Data],
				    Entetes    = Table.PromoteHeaders(Navigation, [PromoteAllScalars = true]),
				    Colonnes   = Table.ColumnNames(Entetes),
				    SansErreur = Table.ReplaceErrorValues(Entetes, List.Transform(Colonnes, each {_, null})),
				    SansNA     = Table.ReplaceValue(SansErreur, each _, each _, (v, a, b) => if List.Contains({"NA", "N/A", "#N/A", "n.d", ""}, v) then null else v, Colonnes),
				    // Nom court : nom sans le préfixe « Fédération Française de … » (segments, titres, légendes).
				    // La liste est testée dans l'ordre : préfixes les plus longs d'abord.
				    Prefixes   = {"Fédération Française de la ", "Fédération Française des ", "Fédération Française de ", "Fédération Française du ", "Fédération Française d'", "Fédération Française d’", "Fédération Française Sportive de ", "Fédération Française ", "Fédération Nationale des ", "Fédération Nationale du ", "Fédération des ", "Fédération de ", "Fédération "},
				    NomCourt   = Table.AddColumn(SansNA, "Nom court", each
				                     if [Federation] = null then null else
				                     let
				                         _Nom     = Text.From([Federation]),
				                         _Prefixe = List.First(List.Select(Prefixes, (p) => Text.StartsWith(_Nom, p)), null),
				                         _Court   = if _Prefixe = null then _Nom else Text.Middle(_Nom, Text.Length(_Prefixe))
				                     in
				                         Text.Upper(Text.Start(_Court, 1)) & Text.Middle(_Court, 1), type text)
				in
				    NomCourt

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

