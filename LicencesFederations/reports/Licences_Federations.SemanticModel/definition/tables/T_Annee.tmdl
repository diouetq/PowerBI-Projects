/// Dimension Année (référentiel Excel, onglet T_Annee) : 2016-2025 et statut de la donnée (def = définitif, semidef = semi-définitif). Segment Année.
table T_Annee
	lineageTag: 6cfc866a-1e8b-455c-be0b-d1fb0f7ea76f

	/// Année du recensement (clé).
	column Annee
		dataType: string
		lineageTag: 487a9279-51b7-4ae5-b683-d61b473f504c
		summarizeBy: none
		sourceColumn: Annee

		annotation SummarizationSetBy = Automatic

	/// def = définitif, semidef = semi-définitif.
	column Statut
		dataType: string
		isHidden
		lineageTag: ca7da847-e1fc-4c38-85da-8f492e1e219c
