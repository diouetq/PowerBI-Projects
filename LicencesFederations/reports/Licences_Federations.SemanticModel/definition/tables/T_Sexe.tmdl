/// Dimension Sexe (référentiel Excel, onglet T_Sexe) : F, H, NR - Non réparti. La colonne Genre (Femmes, Hommes, Non réparti) alimente le segment Public.
table T_Sexe
	lineageTag: bfc28e33-c921-4ed0-a02b-d35f1fea4cc7

	/// Code source : F, H, NR - Non réparti (clé).
	column Sexe
		dataType: string
		lineageTag: 95fe1f7d-7d4e-48c4-b249-1f458e127e2e
		summarizeBy: none
		sourceColumn: Sexe

		annotation SummarizationSetBy = Automatic

	/// Ordre d'affichage.
	column Ordre
		dataType: string
		isHidden
		lineageTag: 4a35de6a-3033-4247-907f-a3e9bd6faba8
		summarizeBy: none
		sourceColumn: Ordre

		annotation SummarizationSetBy = Automatic

	/// Libellé affiché : Femmes, Hommes, Non réparti.
	column Genre = SWITCH(T_Sexe[Sexe], "F", "Femmes", "H", "Hommes", "Non réparti")
		dataType: string
		lineageTag: 390e641a-e81a-48e4-a51d-5603e7148916
		summarizeBy: none
		sortByColumn: Ordre

		annotation SummarizationSetBy = Automatic

	partition T_Sexe = m
		mode: import
		queryGroup: 'Tables de dimensions'
		source =
				// Onglet T_Sexe du référentiel : Sexe (F, H, NR - Non réparti) et Ordre d'affichage.
				let
				    Source = fnLireReferentiel("T_Sexe", {"EnBase"})
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

