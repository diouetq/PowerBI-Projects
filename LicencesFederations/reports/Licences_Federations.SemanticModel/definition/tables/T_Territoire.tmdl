	partition T_Territoire = m
		mode: import
		queryGroup: 'Tables de dimensions'
		source =
				let
				    Source     = Excel.Workbook(File.Contents(Dossier & "Referentiel_Excel.xlsx"), null, true),
				    #"Filtered Rows" = Table.SelectRows(Source, each ([Kind] = "Sheet")),
				    Navigation = #"Filtered Rows"{[Item = "T_Territoire", Kind = "Sheet"]}[Data],
				    Entetes    = Table.PromoteHeaders(Navigation, [PromoteAllScalars = true]),
				    Colonnes   = Table.ColumnNames(Entetes),
				    SansErreur = Table.ReplaceErrorValues(Entetes, List.Transform(Colonnes, each {_, null})),
				    SansNA     = Table.ReplaceValue(SansErreur, each _, each _, (v, a, b) => if List.Contains({"NA", "N/A", "#N/A", "n.d", ""}, v) then null else v, Colonnes)
				in
				    SansNA

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

