/// Copie déconnectée des fédérations pour le nuage de points de la page Comparer : affiche toujours toutes les fédérations, la sélection des segments sert seulement à colorer les points.
table T_FedNuage
	lineageTag: 6dd29935-18f0-4636-ae11-e0cae233c955

	column CodeReference
		dataType: string
		lineageTag: 691a1c12-7378-40cc-8b86-e51547030d1f
		summarizeBy: none
		isNameInferred
		sourceColumn: [CodeReference]

		annotation SummarizationSetBy = Automatic

	column Fédération
		dataType: string
		lineageTag: 1f2131b9-5ab1-4051-a789-4e8cec031634
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fédération]

		annotation SummarizationSetBy = Automatic

	column Famille
		dataType: string
		lineageTag: 1ec1d5cd-f412-4a5a-bc35-eee349d75bc9
		summarizeBy: none
		isNameInferred
		sourceColumn: [Famille]

		annotation SummarizationSetBy = Automatic

	partition T_FedNuage = calculated
		mode: import
		source =
				SELECTCOLUMNS(
				    FILTER(T_Federation, NOT ISBLANK(T_Federation[Federation])),
				    "CodeReference", T_Federation[CodeReference],
				    "Fédération", T_Federation[Federation],
				    "Famille", T_Federation[Famille de fédérations]
				)

	annotation PBI_Id = 974d661a0ea843fb940097f67963a97e

