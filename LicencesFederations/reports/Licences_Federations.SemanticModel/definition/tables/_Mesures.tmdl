	/// Bloc PROFIL, section Âge : âge moyen (âge exact), parts par grande catégorie au-dessus de la barre, comparaison au regroupement et à l'ensemble, infobulles.
	measure 'HTML Qui Âges' =
			-- =====================================================================
			-- HTML Qui Âges | section « Âge » du bloc PROFIL (assemblée par HTML Qui)
			-- Hiérarchie : âge moyen > catégories (libellé, tranche, part) > barre > comparaison (valeurs)
			-- Même structure que HTML Qui Profil : les deux colonnes restent alignées ligne à ligne.
			-- Mise en page FIXE : les 2 lignes de comparaison sont toujours là (grisées si sans objet).
			-- Regroupement entier sélectionné : il occupe la ligne « regroupement » (orange).
			-- =====================================================================
			-- 1. Charte
			VAR _ColF    = [Style Couleur femmes]
			VAR _ColH    = [Style Couleur hommes]
			VAR _ColEns  = [Style Couleur ensemble]
			VAR _ColReg  = [Style Couleur regroupement]
			VAR _ColTxt  = [Style Couleur texte]
			VAR _ColLib  = [Style Couleur texte libellé]
			VAR _ColFort = [Style Couleur texte fort]
			VAR _ColNeut = [Style Couleur neutre]
			VAR _ColPist = [Style Couleur fond neutre]
			VAR _TxtTxt  = [Style Taille texte]
			VAR _TxtVal  = [Style Taille valeur]
			VAR _TxtChif = [Style Taille chiffre]
			VAR _Gris    = "opacity:.4;"
			-- 2. Contexte
			VAR _Mode    = [Sélection mode]
			VAR _ModeReg = _Mode = "Regroupement"
			VAR _AvecSel = _Mode <> "Ensemble"
			VAR _AvecReg = _Mode IN {"Fédération", "Plusieurs fédérations"} && NOT ISBLANK([Nom regroupement])
			VAR _NomReg  = SWITCH(TRUE(), _ModeReg, [Sélection libellé], _AvecReg, [Niveau choisi] & " · " & [Nom regroupement], "Regroupement")
			VAR _PourquoiPasReg = IF(_Mode = "Ensemble", "Choisissez une fédération ou un regroupement.", "Les fédérations choisies n'appartiennent pas au même regroupement.")
			VAR _GSel    = IF(ISFILTERED(T_Sexe) && HASONEVALUE(T_Sexe[Sexe]), SELECTEDVALUE(T_Sexe[Sexe]))
			VAR _CSel    = IF(ISFILTERED(T_TrancheAge) && HASONEVALUE(T_TrancheAge[Ordre]), SELECTEDVALUE(T_TrancheAge[Ordre]))
			VAR _ColA    = SWITCH(_GSel, "F", _ColF, "H", _ColH, [Style Couleur poids])   -- couleur du genre filtré, sinon neutre
			-- 3. Âge moyen (genre choisi, toutes catégories)
			VAR _Moy    = CALCULATE([Âge moyen], REMOVEFILTERS(T_TrancheAge))
			VAR _MoyReg = SWITCH(TRUE(), _ModeReg, _Moy, _AvecReg, CALCULATE([Âge moyen], REMOVEFILTERS(T_TrancheAge), Comparaison[Comparaison] = "Regroupement"))
			VAR _MoyEns = IF(_AvecSel, CALCULATE([Âge moyen], REMOVEFILTERS(T_TrancheAge), Comparaison[Comparaison] = "Ensemble"))
			-- 4. Grandes catégories : sélection (@v) et ensemble (@e)
			VAR _TabA =
			    ADDCOLUMNS(
			        FILTER(ALL(T_TrancheAge[Ordre], T_TrancheAge[TrancheAge]), T_TrancheAge[Ordre] IN {"1", "2", "3", "4"}),
			        "@v", VAR _o = T_TrancheAge[Ordre] RETURN CALCULATE([NB Licences], REMOVEFILTERS(T_TrancheAge), T_TrancheAge[Ordre] = _o) + 0,
			        "@e", VAR _o = T_TrancheAge[Ordre] RETURN CALCULATE([NB Licences], REMOVEFILTERS(T_TrancheAge), T_TrancheAge[Ordre] = _o, Comparaison[Comparaison] = "Ensemble") + 0)
			VAR _TotA = SUMX(_TabA, [@v])
			VAR _TotE = SUMX(_TabA, [@e])
			VAR _TabA2 =
			    ADDCOLUMNS(_TabA,
			        "@p",  DIVIDE([@v], _TotA),
			        "@pe", DIVIDE([@e], _TotE),
			        "@op", VAR _o = T_TrancheAge[Ordre] RETURN IF(ISBLANK(_CSel), SWITCH(_o, "1", "1", "2", ".72", "3", ".5", ".3"), IF(_CSel = _o, "1", ".18")),
			        "@nm", VAR _L = T_TrancheAge[TrancheAge] RETURN TRIM(MID(_L, 5, SEARCH("(", _L, 1, LEN(_L) + 1) - 5)),
			        "@tr", VAR _L = T_TrancheAge[TrancheAge] RETURN SUBSTITUTE(MID(_L, SEARCH("(", _L, 1, LEN(_L)) + 1, SEARCH(")", _L, 1, LEN(_L) + 1) - SEARCH("(", _L, 1, LEN(_L)) - 1), "-", "–") & " ans")
			VAR _Tip =
			    "<div class='tip'><b>NM</b> (TR) · PP des licences<br>NN licences" & IF(_AvecSel, "<br><span>Ensemble des fédérations : EE</span>") & "</div>"
			-- 5. Valeurs au-dessus de la barre : libellé / tranche / part (3 lignes, comme le genre)
			VAR _Valeurs =
			    "<div style='display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:20px'>"
			    & CONCATENATEX(_TabA2,
			        VAR _o = T_TrancheAge[Ordre]
			        VAR _Actif = ISBLANK(_CSel) || _CSel = _o
			        RETURN
			            "<div class='tt' style='min-width:0;" & IF(_Actif, "", _Gris) & "'>"
			            & "<div style='font-size:13px;color:" & _ColNeut & ";white-space:nowrap'><i style='display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;background:" & _ColA & ";opacity:" & IF(ISBLANK(_CSel), [@op], "1") & "'></i>" & [@nm] & "</div>"
			            & "<div class='nb' style='font-size:12px;color:" & _ColNeut & ";margin-top:1px'>" & [@tr] & "</div>"
			            & "<b class='nb' style='display:block;font-size:" & _TxtVal & "px;font-weight:700;color:" & _ColTxt & ";margin-top:2px'>" & FORMAT([@p], "0.0 %") & "</b>"
			            & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_Tip, "NM", [@nm]), "TR", [@tr]), "PP", FORMAT([@p], "0.0 %")), "NN", FORMAT([@v], "#,0")), "EE", FORMAT([@pe], "0.0 %")) & "</div>",
			        "", T_TrancheAge[Ordre], ASC)
			    & "</div>"
			-- 6. Barre de répartition (une catégorie sans licence n'est pas dessinée)
			VAR _Barre =
			    "<div style='display:flex;gap:2px;height:14px;margin-top:8px'>"
			    & CONCATENATEX(FILTER(_TabA2, [@v] > 0),
			        "<div class='tt' style='width:" & FORMAT([@p] * 100, "0.0", "en-US") & "%;border-radius:4px;background:" & _ColA & ";opacity:" & [@op] & "'>"
			        & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_Tip, "NM", [@nm]), "TR", [@tr]), "PP", FORMAT([@p], "0.0 %")), "NN", FORMAT([@v], "#,0")), "EE", FORMAT([@pe], "0.0 %")) & "</div>",
			        "", T_TrancheAge[Ordre], ASC)
			    & "</div>"
			-- 7. Comparaison de l'âge moyen (toujours 2 lignes)
			VAR _LigneComp = "<div class='tt' style='display:flex;align-items:center;gap:8px;font-size:" & [Style Taille petit] & "px;color:" & _ColLib & ";OPA'><i style='flex:none;width:8px;height:8px;border-radius:50%;background:COL'></i><span class='el' style='flex:1'>NOM</span><b class='nb' style='font-size:15px;font-weight:700;color:" & _ColFort & "'>VAL</b><div class='tip'>TIP</div></div>"
			VAR _Comp =
			    "<div style='margin-top:auto;padding-top:22px;display:flex;flex-direction:column;gap:8px'>"
			    & "<div style='font-size:13px;color:" & _ColNeut & ";padding-top:10px;border-top:1px dashed " & [Style Couleur grille] & "'>Comparaison · âge moyen</div>"
			    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_LigneComp, "OPA", IF(ISBLANK(_MoyReg), _Gris, "")), "COL", _ColReg), "NOM", _NomReg), "VAL", IF(ISBLANK(_MoyReg), "–", FORMAT(_MoyReg, "0.0"))),
			        "TIP", IF(ISBLANK(_MoyReg), _PourquoiPasReg, "<b>" & _NomReg & "</b>" & IF(_ModeReg, " (sélectionné)") & "<br>Âge moyen : " & FORMAT(_MoyReg, "0.0") & " ans" & IF(NOT _ModeReg && NOT ISBLANK(_Moy), "<br><span>Écart de la sélection : " & FORMAT(_Moy - _MoyReg, "+0.0;-0.0;0.0") & " an</span>")))
			    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_LigneComp, "OPA", IF(ISBLANK(_MoyEns), _Gris, "")), "COL", _ColEns), "NOM", "Ensemble des fédérations"), "VAL", IF(ISBLANK(_MoyEns), "–", FORMAT(_MoyEns, "0.0"))),
			        "TIP", IF(ISBLANK(_MoyEns), "La sélection est déjà l'ensemble des fédérations.", "<b>Ensemble des fédérations</b><br>Âge moyen : " & FORMAT(_MoyEns, "0.0") & " ans" & IF(NOT ISBLANK(_Moy), "<br><span>Écart de la sélection : " & FORMAT(_Moy - _MoyEns, "+0.0;-0.0;0.0") & " an</span>")))
			    & "</div>"
			-- 8. En-tête
			VAR _Ico  = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='" & [Style Couleur accent] & "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><path d='M12 7v5l3 2'/></svg>"
			VAR _Tete = "<div style='display:flex;align-items:center;gap:10px;padding-bottom:10px;border-bottom:1px solid " & _ColPist & "'><span style='display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;background:" & [Style Couleur accent fond] & "'>" & _Ico & "</span><span style='font-size:" & _TxtTxt & "px;font-weight:700;color:" & _ColTxt & "'>Âge</span></div>"
			-- 9. Assemblage
			RETURN
			    "<div style='display:flex;flex-direction:column;min-width:0'>" & _Tete
			    & "<div class='tt' style='display:flex;align-items:baseline;gap:8px;margin-top:16px;width:max-content'><span class='nb' style='font-size:" & _TxtChif & "px;font-weight:700;letter-spacing:-.02em;line-height:1;color:" & _ColTxt & "'>" & IF(ISBLANK(_Moy), "–", FORMAT(_Moy, "0.0")) & "</span><span style='font-size:" & _TxtTxt & "px;color:" & _ColLib & "'>âge moyen</span>"
			    & "<div class='tip bas'><b>Note de lecture</b><br>" & IF(ISBLANK(_Moy), "Âge non renseigné pour cette sélection.", "Les licenciés ont en moyenne " & FORMAT(_Moy, "0.0") & " ans" & IF(NOT ISBLANK(_MoyEns), ",<br>soit " & FORMAT(_Moy - _MoyEns, "+0.0;-0.0;0.0") & " an(s) par rapport à l'ensemble des fédérations.", ".")) & "</div></div>"
			    & "<div style='font-size:13px;color:" & _ColNeut & ";margin-top:6px;white-space:nowrap'>sur " & FORMAT(_TotA, "#,0") & " licences (âge connu)</div>"
			    & _Valeurs & _Barre & _Comp & "</div>"
		isHidden
		displayFolder: 6. Portrait\Qui
		lineageTag: 1a046e98-cc08-4cd0-a704-214b5ff2481b

	/// Bloc PROFIL, section Genre : part de femmes (ou d'hommes si filtré), effectifs au-dessus de la barre, comparaison au regroupement et à l'ensemble, infobulles.
	measure 'HTML Qui Profil' =
			-- =====================================================================
			-- HTML Qui Profil | section « Genre » du bloc PROFIL (assemblée par HTML Qui)
			-- Hiérarchie : chiffre clé > valeurs F / H (libellé, effectif, part) > barre > comparaison (valeurs)
			-- Même structure que HTML Qui Âges : les deux colonnes restent alignées ligne à ligne.
			-- Mise en page FIXE : les 2 lignes de comparaison sont toujours là (grisées si sans objet).
			-- Regroupement entier sélectionné : il occupe la ligne « regroupement » (orange).
			-- =====================================================================
			-- 1. Charte
			VAR _ColF    = [Style Couleur femmes]
			VAR _ColH    = [Style Couleur hommes]
			VAR _ColInac = [Style Couleur neutre clair]
			VAR _ColEns  = [Style Couleur ensemble]
			VAR _ColReg  = [Style Couleur regroupement]
			VAR _ColTxt  = [Style Couleur texte]
			VAR _ColLib  = [Style Couleur texte libellé]
			VAR _ColFort = [Style Couleur texte fort]
			VAR _ColNeut = [Style Couleur neutre]
			VAR _ColPist = [Style Couleur fond neutre]
			VAR _TxtTxt  = [Style Taille texte]
			VAR _TxtVal  = [Style Taille valeur]
			VAR _TxtChif = [Style Taille chiffre]
			VAR _Gris    = "opacity:.4;"
			-- 2. Contexte
			VAR _Mode    = [Sélection mode]
			VAR _ModeReg = _Mode = "Regroupement"
			VAR _AvecSel = _Mode <> "Ensemble"
			VAR _AvecReg = _Mode IN {"Fédération", "Plusieurs fédérations"} && NOT ISBLANK([Nom regroupement])
			VAR _NomReg  = SWITCH(TRUE(), _ModeReg, [Sélection libellé], _AvecReg, [Niveau choisi] & " · " & [Nom regroupement], "Regroupement")
			VAR _PourquoiPasReg = IF(_Mode = "Ensemble", "Choisissez une fédération ou un regroupement.", "Les fédérations choisies n'appartiennent pas au même regroupement.")
			VAR _GSel    = IF(ISFILTERED(T_Sexe) && HASONEVALUE(T_Sexe[Sexe]), SELECTEDVALUE(T_Sexe[Sexe]))
			VAR _OnF     = ISBLANK(_GSel) || _GSel = "F"
			VAR _OnH     = ISBLANK(_GSel) || _GSel = "H"
			-- 3. Données
			VAR _F    = CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe), T_Sexe[Sexe] = "F") + 0
			VAR _H    = CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe), T_Sexe[Sexe] = "H") + 0
			VAR _PF   = DIVIDE(_F, _F + _H)
			VAR _Cible = IF(_GSel = "H", "H", "F")
			VAR _PartC = IF(_Cible = "H", 1 - _PF, _PF)
			VAR _ColC  = IF(_Cible = "H", _ColH, _ColF)
			VAR _LibC  = IF(_Cible = "H", "d'hommes", "de femmes")
			VAR _RegF = IF(_AvecReg, CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe), T_Sexe[Sexe] = "F", Comparaison[Comparaison] = "Regroupement"))
			VAR _RegH = IF(_AvecReg, CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe), T_Sexe[Sexe] = "H", Comparaison[Comparaison] = "Regroupement"))
			VAR _EnsF = CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe), T_Sexe[Sexe] = "F", Comparaison[Comparaison] = "Ensemble")
			VAR _EnsH = CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe), T_Sexe[Sexe] = "H", Comparaison[Comparaison] = "Ensemble")
			VAR _PRegF = IF(_ModeReg, _PF, DIVIDE(_RegF, _RegF + _RegH))          -- part de femmes du regroupement
			VAR _PEnsF = IF(_AvecSel, DIVIDE(_EnsF, _EnsF + _EnsH))                -- part de femmes de l'ensemble
			VAR _RegC  = IF(NOT ISBLANK(_PRegF), IF(_Cible = "H", 1 - _PRegF, _PRegF))
			VAR _EnsC  = IF(NOT ISBLANK(_PEnsF), IF(_Cible = "H", 1 - _PEnsF, _PEnsF))
			-- 4. Valeurs F / H au-dessus de la barre : libellé / effectif / part (3 lignes, comme les âges)
			VAR _TipF = "<div class='tip'><b>Femmes</b> · " & FORMAT(_PF, "0.0 %") & " des licences<br>" & FORMAT(_F, "#,0") & " licences" & IF(_AvecSel, "<br><span>Ensemble des fédérations : " & FORMAT(_PEnsF, "0.0 %") & "</span>") & "</div>"
			VAR _TipH = "<div class='tip'><b>Hommes</b> · " & FORMAT(1 - _PF, "0.0 %") & " des licences<br>" & FORMAT(_H, "#,0") & " licences" & IF(_AvecSel, "<br><span>Ensemble des fédérations : " & FORMAT(1 - _PEnsF, "0.0 %") & "</span>") & "</div>"
			VAR _Item = "<div class='tt' style='min-width:0;ALI'><div style='font-size:13px;color:" & _ColNeut & ";white-space:nowrap'><i style='display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;background:COL'></i>NOM</div><div class='nb' style='font-size:12px;color:" & _ColNeut & ";margin-top:1px'>SUB</div><b class='nb' style='display:block;font-size:" & _TxtVal & "px;font-weight:700;color:" & _ColTxt & ";margin-top:2px'>PCT</b>TIP</div>"
			VAR _Valeurs =
			    "<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px'>"
			    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_Item, "ALI", IF(_OnF, "", _Gris)), "COL", _ColF), "NOM", "Femmes"), "SUB", FORMAT(_F, "#,0") & " licences"), "PCT", FORMAT(_PF, "0.0 %")), "TIP", _TipF)
			    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_Item, "ALI", "text-align:right;" & IF(_OnH, "", _Gris)), "COL", _ColH), "NOM", "Hommes"), "SUB", FORMAT(_H, "#,0") & " licences"), "PCT", FORMAT(1 - _PF, "0.0 %")), "TIP", _TipH)
			    & "</div>"
			-- 5. Barre de répartition (un genre sans licence n'est pas dessiné)
			VAR _Barre =
			    "<div style='display:flex;gap:2px;height:14px;margin-top:8px'>"
			    & IF(_F > 0, "<div class='tt' style='width:" & FORMAT(_PF * 100, "0.0", "en-US") & "%;border-radius:4px;background:" & IF(_OnF, _ColF, _ColInac) & "'>" & _TipF & "</div>")
			    & IF(_H > 0, "<div class='tt' style='flex:1;border-radius:4px;background:" & IF(_OnH, _ColH, _ColInac) & "'>" & _TipH & "</div>")
			    & "</div>"
			-- 6. Comparaison : part de la cible pour le regroupement et l'ensemble (toujours 2 lignes)
			VAR _LigneComp = "<div class='tt' style='display:flex;align-items:center;gap:8px;font-size:" & [Style Taille petit] & "px;color:" & _ColLib & ";OPA'><i style='flex:none;width:8px;height:8px;border-radius:50%;background:COL'></i><span class='el' style='flex:1'>NOM</span><b class='nb' style='font-size:15px;font-weight:700;color:" & _ColFort & "'>VAL</b><div class='tip'>TIP</div></div>"
			VAR _Comp =
			    "<div style='margin-top:auto;padding-top:22px;display:flex;flex-direction:column;gap:8px'>"
			    & "<div style='font-size:13px;color:" & _ColNeut & ";padding-top:10px;border-top:1px dashed " & [Style Couleur grille] & "'>Comparaison · part " & _LibC & "</div>"
			    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_LigneComp, "OPA", IF(ISBLANK(_RegC), _Gris, "")), "COL", _ColReg), "NOM", _NomReg), "VAL", IF(ISBLANK(_RegC), "–", FORMAT(_RegC, "0.0 %"))),
			        "TIP", SWITCH(TRUE(), _ModeReg, "<b>" & _NomReg & "</b><br>Regroupement sélectionné : " & FORMAT(_RegC, "0.0 %") & " " & _LibC, ISBLANK(_RegC), _PourquoiPasReg, "<b>" & _NomReg & "</b><br>" & FORMAT(_RegC, "0.0 %") & " " & _LibC & "<br><span>Écart de la sélection : " & FORMAT((_PartC - _RegC) * 100, "+0.0;-0.0;0.0") & " pt</span>"))
			    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_LigneComp, "OPA", IF(ISBLANK(_EnsC), _Gris, "")), "COL", _ColEns), "NOM", "Ensemble des fédérations"), "VAL", IF(ISBLANK(_EnsC), "–", FORMAT(_EnsC, "0.0 %"))),
			        "TIP", IF(ISBLANK(_EnsC), "La sélection est déjà l'ensemble des fédérations.", "<b>Ensemble des fédérations</b><br>" & FORMAT(_EnsC, "0.0 %") & " " & _LibC & "<br><span>Écart de la sélection : " & FORMAT((_PartC - _EnsC) * 100, "+0.0;-0.0;0.0") & " pt</span>"))
			    & "</div>"
			-- 7. En-tête
			VAR _Ico  = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='" & [Style Couleur accent] & "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><circle cx='9' cy='8' r='3.2'/><path d='M3 20c.7-3.4 3-5.2 6-5.2s5.3 1.8 6 5.2'/><circle cx='17' cy='9' r='2.4'/><path d='M16.5 14.6c2.3.2 4 1.8 4.5 4.4'/></svg>"
			VAR _Tete = "<div style='display:flex;align-items:center;gap:10px;padding-bottom:10px;border-bottom:1px solid " & _ColPist & "'><span style='display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;background:" & [Style Couleur accent fond] & "'>" & _Ico & "</span><span style='font-size:" & _TxtTxt & "px;font-weight:700;color:" & _ColTxt & "'>Genre</span></div>"
			-- 8. Assemblage
			RETURN
			    "<div style='display:flex;flex-direction:column;min-width:0'>" & _Tete
			    & "<div class='tt' style='display:flex;align-items:baseline;gap:8px;margin-top:16px;width:max-content'><span class='nb' style='font-size:" & _TxtChif & "px;font-weight:700;letter-spacing:-.02em;line-height:1;color:" & _ColC & "'>" & IF(ISBLANK(_PartC), "–", FORMAT(_PartC, "0.0 %")) & "</span><span style='font-size:" & _TxtTxt & "px;color:" & _ColLib & "'>" & _LibC & "</span>"
			    & "<div class='tip bas'><b>Note de lecture</b><br>" & FORMAT(_PartC, "0.0 %") & " des licences sont détenues par des " & IF(_Cible = "H", "hommes", "femmes") & IF(NOT ISBLANK(_EnsC), ",<br>contre " & FORMAT(_EnsC, "0.0 %") & " pour l'ensemble des fédérations.", ".") & "</div></div>"
			    & "<div style='font-size:13px;color:" & _ColNeut & ";margin-top:6px;white-space:nowrap'>sur " & FORMAT(_F + _H, "#,0") & " licences (genre connu)</div>"
			    & _Valeurs & _Barre & _Comp & "</div>"
		isHidden
		displayFolder: 6. Portrait\Qui
		lineageTag: 03f3a563-3ab0-45cc-bb29-48c336364e1e

	/// Bloc PROFIL, section Pyramide des âges : tranches calées sur les grandes catégories (âge exact), échelle en nombre de licences, courbe de comparaison (regroupement ou ensemble, à effectif égal), total au centre, infobulles. Styles SVG en classes pour rester sous la taille maximale d'un texte (32 000 caractères).
	measure 'HTML Qui Pyramide' =
			-- =====================================================================
			-- HTML Qui Pyramide | section « Pyramide des âges » du bloc PROFIL (assemblée par HTML Qui)
			-- Barres femmes / hommes par tranche d'âge exact, regroupées par grande catégorie.
			-- Courbe de comparaison : répartition du regroupement (ou de l'ensemble) ramenée
			-- au même nombre total de licences que la sélection (« à effectif égal »).
			-- Styles SVG regroupés en classes (.py …) plutôt que répétés sur chaque ligne : texte plus court,
			-- rendu plus rapide et réglages centralisés.
			-- Mise en page FIXE : légende complète et alerte « effectif faible » dans l'en-tête (rien ne se décale).
			-- =====================================================================
			-- 1. Réglages
			VAR _Bandes =
			DATATABLE("Lo", INTEGER, "Hi", INTEGER, "Cat", INTEGER, {   -- âge min, âge max, catégorie (1 Enfants … 4 Seniors)
			{1, 5, 1}, {6, 9, 1}, {10, 13, 1},
			{14, 17, 2}, {18, 20, 2},
			{21, 25, 3}, {26, 30, 3}, {31, 35, 3}, {36, 40, 3}, {41, 45, 3}, {46, 50, 3}, {51, 55, 3},
			{56, 60, 4}, {61, 65, 4}, {66, 70, 4}, {71, 75, 4}, {76, 80, 4}, {81, 99, 4}
			})
			VAR _SeuilFaible = 2000      -- en dessous : alerte « effectif faible »
			VAR _Wp  = 678               -- largeur SVG
			VAR _Gl  = 118               -- colonne des catégories à gauche
			VAR _Lc  = 128               -- colonne centrale (âge + total)
			VAR _Hr  = 22                -- hauteur d'une ligne (bloc de 984 px de haut)
			VAR _Hb  = 13                -- épaisseur d'une barre
			VAR _Gap = 8                 -- espace entre deux catégories
			VAR _FondCat = "#F9FAFC"     -- fond très léger d'une catégorie
			-- 2. Charte
			VAR _ColF    = [Style Couleur femmes]
			VAR _ColH    = [Style Couleur hommes]
			VAR _ColInac = [Style Couleur neutre clair]
			VAR _ColTxt  = [Style Couleur texte]
			VAR _ColLib  = [Style Couleur texte libellé]
			VAR _ColFort = [Style Couleur texte fort]
			VAR _ColNeut = [Style Couleur neutre]
			VAR _ColPist = [Style Couleur fond neutre]
			VAR _ColGril = [Style Couleur grille]
			VAR _TxtTxt  = [Style Taille texte]
			VAR _TxtPet  = [Style Taille petit]
			-- 3. Contexte
			VAR _Mode    = [Sélection mode]
			VAR _AvecSel = _Mode <> "Ensemble"
			VAR _AvecReg = _Mode IN {"Fédération", "Plusieurs fédérations"} && NOT ISBLANK([Nom regroupement])
			VAR _Comp    = IF(_AvecReg, "Regroupement", IF(_AvecSel, "Ensemble"))
			VAR _NomComp = IF(_AvecReg, [Niveau choisi] & " · " & [Nom regroupement], "Ensemble des fédérations")
			VAR _ColComp = IF(_AvecReg, [Style Couleur regroupement], [Style Couleur ensemble])
			VAR _GSel    = IF(ISFILTERED(T_Sexe) && HASONEVALUE(T_Sexe[Sexe]), SELECTEDVALUE(T_Sexe[Sexe]))
			VAR _CSel    = IF(ISFILTERED(T_TrancheAge) && HASONEVALUE(T_TrancheAge[Ordre]), VALUE(SELECTEDVALUE(T_TrancheAge[Ordre])))
			VAR _ColA    = SWITCH(_GSel, "F", _ColF, "H", _ColH, [Style Couleur poids])
			VAR _ClF     = IF(ISBLANK(_GSel) || _GSel = "F", "bf", "bi")   -- classe des barres femmes
			VAR _ClH     = IF(ISBLANK(_GSel) || _GSel = "H", "bh", "bi")   -- classe des barres hommes
			-- 4. Données (toutes catégories, deux genres : la sélection est mise en évidence)
			VAR _TabP =
			ADDCOLUMNS(_Bandes,
			"@ft", VAR _a = [Lo] VAR _b = [Hi] RETURN CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe), REMOVEFILTERS(T_TrancheAge), T_Sexe[Sexe] = "F", F_Licences[Age] >= _a, F_Licences[Age] <= _b) + 0,
			"@ht", VAR _a = [Lo] VAR _b = [Hi] RETURN CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe), REMOVEFILTERS(T_TrancheAge), T_Sexe[Sexe] = "H", F_Licences[Age] >= _a, F_Licences[Age] <= _b) + 0,
			"@fc", VAR _a = [Lo] VAR _b = [Hi] RETURN IF(NOT ISBLANK(_Comp), CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe), REMOVEFILTERS(T_TrancheAge), T_Sexe[Sexe] = "F", F_Licences[Age] >= _a, F_Licences[Age] <= _b, Comparaison[Comparaison] = _Comp) + 0),
			"@hc", VAR _a = [Lo] VAR _b = [Hi] RETURN IF(NOT ISBLANK(_Comp), CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe), REMOVEFILTERS(T_TrancheAge), T_Sexe[Sexe] = "H", F_Licences[Age] >= _a, F_Licences[Age] <= _b, Comparaison[Comparaison] = _Comp) + 0))
			VAR _TotP   = SUMX(_TabP, [@ft] + [@ht])
			VAR _TotC   = SUMX(_TabP, [@fc] + [@hc])
			VAR _Ratio  = DIVIDE(_TotP, _TotC)          -- comparaison ramenée à l'effectif de la sélection
			VAR _MaxCat = MAXX(_TabP, [Cat])
			VAR _TabP2  = ADDCOLUMNS(_TabP, "@i", VAR _a = [Lo] RETURN COUNTROWS(FILTER(_Bandes, [Lo] > _a)))
			VAR _TabP3  = ADDCOLUMNS(_TabP2, "@y", [@i] * _Hr + (_MaxCat - [Cat]) * _Gap + 2)
			VAR _yAxe   = MAXX(_TabP3, [@y]) + _Hr + 6
			VAR _Hp     = _yAxe + 22
			-- 5. Échelle en nombre de licences (graduation ronde)
			VAR _Sd      = (_Wp - _Gl - _Lc) / 2
			VAR _Wmax    = _Sd - 6
			VAR _Cx      = _Gl + _Sd + _Lc / 2
			VAR _MaxV    = MAX(MAXX(_TabP, MAX(MAX([@ft], [@ht]), MAX([@fc], [@hc]) * _Ratio)), 1)
			VAR _PasBrut = _MaxV * 1.04 / 3
			VAR _Mag     = POWER(10, INT(LOG10(_PasBrut)))
			VAR _Norm    = _PasBrut / _Mag
			VAR _Pas     = SWITCH(TRUE(), _Norm <= 1, 1, _Norm <= 2, 2, _Norm <= 2.5, 2.5, _Norm <= 5, 5, 10) * _Mag
			VAR _NbT     = MAX(CEILING(_MaxV / _Pas, 1), 1)
			VAR _Echelle = _NbT * _Pas
			-- 6. Styles SVG (classes)
			VAR _Css =
			"<style>.py .bf{fill:" & _ColF & "}.py .bh{fill:" & _ColH & "}.py .bi{fill:" & _ColInac & "}.py .dim{opacity:.25}"
			& ".py .lb{font-size:" & _TxtPet & "px;font-weight:600;fill:" & _ColFort & "}.py .tv{font-size:13px;fill:" & _ColNeut & "}.py .ax{font-size:13px;fill:" & _ColNeut & "}"
			& ".py .hz{fill:#000;fill-opacity:0}.py .hl{fill:" & _ColInac & ";fill-opacity:.55}.py .tb{fill:" & _ColTxt & "}"
			& ".py .t1{font-size:" & _TxtPet & "px;font-weight:600;fill:#FFFFFF}.py .t2{font-size:13px;fill:#D0D5DD}.py .t3{font-size:13px;fill:#B7C0CF}</style>"
			-- 7. Grandes catégories : fond très léger, filet, fond renforcé si catégorie choisie
			VAR _Cats = DISTINCT(SELECTCOLUMNS(_Bandes, "@g", [Cat]))
			VAR _Groupes =
			CONCATENATEX(_Cats,
			VAR _g  = [@g]
			VAR _R  = FILTER(_TabP3, [Cat] = _g)
			VAR _yt = MINX(_R, [@y])
			VAR _yf = MAXX(_R, [@y]) + _Hr
			VAR _nr = COUNTROWS(_R)
			VAR _L  = MAXX(FILTER(ALL(T_TrancheAge[Ordre], T_TrancheAge[TrancheAge]), T_TrancheAge[Ordre] = FORMAT(_g, "0")), T_TrancheAge[TrancheAge])
			VAR _Nm = TRIM(MID(_L, 5, SEARCH("(", _L, 1, LEN(_L) + 1) - 5))
			VAR _Tr = SUBSTITUTE(MID(_L, SEARCH("(", _L, 1, LEN(_L)) + 1, SEARCH(")", _L, 1, LEN(_L) + 1) - SEARCH("(", _L, 1, LEN(_L)) - 1), "-", "–") & " ans"
			VAR _Sel = NOT ISBLANK(_CSel) && _g = _CSel
			VAR _Dim = NOT ISBLANK(_CSel) && NOT _Sel
			VAR _ym  = (_yt + _yf) / 2
			VAR _Part = DIVIDE(SUMX(_R, [@ft] + [@ht]), _TotP)
			RETURN
			"<rect x='0' y='" & (_yt - 2) & "' width='" & _Wp & "' height='" & (_yf - _yt + 4) & "' rx='6' fill='" & IF(_Sel, [Style Couleur accent fond], _FondCat) & "'/>"
			& IF(_g < _MaxCat, "<line x1='0' x2='" & _Wp & "' y1='" & FORMAT(_yt - 2 - _Gap / 2, "0.0", "en-US") & "' y2='" & FORMAT(_yt - 2 - _Gap / 2, "0.0", "en-US") & "' stroke='" & _ColGril & "'/>")
			& "<rect x='0' y='" & (_yt - 2) & "' width='3' height='" & (_yf - _yt + 4) & "' rx='1.5' fill='" & IF(_Sel, _ColA, [Style Couleur bordure forte]) & "'/>"
			& "<text x='12' y='" & FORMAT(IF(_nr >= 2, _ym - 3, _ym + 5), "0.0", "en-US") & "' font-size='" & _TxtTxt & "' font-weight='600' fill='" & IF(_Sel, _ColA, IF(_Dim, _ColNeut, _ColFort)) & "'>" & _Nm & "</text>"
			& IF(_nr >= 2, "<text x='12' y='" & FORMAT(_ym + 15, "0.0", "en-US") & "' class='ax'>" & _Tr & " · " & FORMAT(_Part, "0 %") & "</text>"),
			"")
			-- 8. Axe en nombre de licences (M sans virgule finale : 3 M, 2,5 M)
			VAR _Grille =
			CONCATENATEX(GENERATESERIES(0, _NbT, 1),
			VAR _k  = [Value]
			VAR _dx = _k / _NbT * _Wmax
			VAR _xl = FORMAT(_Gl + _Sd - _dx, "0.0", "en-US")
			VAR _xr = FORMAT(_Gl + _Sd + _Lc + _dx, "0.0", "en-US")
			VAR _t  = _k * _Pas
			VAR _Lb = SWITCH(TRUE(), _t >= 1000000, FORMAT(_t / 1000000, IF(MOD(_t, 1000000) = 0, "0", "0.0")) & " M", _t >= 10000, FORMAT(_t / 1000, "#,0") & " k", FORMAT(_t, "#,0"))
			VAR _Tr = "' y1='0' y2='" & _yAxe & "' stroke='" & IF(_k = 0, [Style Couleur bordure forte], _ColGril) & "'" & IF(_k = 0, "", " stroke-dasharray='3 3'") & "/>"
			RETURN
			"<line x1='" & _xl & "' x2='" & _xl & _Tr & "<line x1='" & _xr & "' x2='" & _xr & _Tr
			& "<text x='" & _xl & "' y='" & (_yAxe + 16) & "' text-anchor='middle' class='ax'>" & _Lb & "</text>"
			& "<text x='" & _xr & "' y='" & (_yAxe + 16) & "' text-anchor='middle' class='ax'>" & _Lb & "</text>",
			"")
			-- 9. Courbe de comparaison (contour en escalier, des deux côtés)
			VAR _CourbeF =
			IF(NOT ISBLANK(_Comp) && _TotC > 0,
			"M" & CONCATENATEX(_TabP3,
			VAR _x = FORMAT(_Gl + _Sd - DIVIDE([@fc] * _Ratio, _Echelle) * _Wmax, "0", "en-US")
			RETURN _x & "," & [@y] & "V" & ([@y] + _Hr), "L", [Lo], DESC))
			VAR _CourbeH =
			IF(NOT ISBLANK(_Comp) && _TotC > 0,
			"M" & CONCATENATEX(_TabP3,
			VAR _x = FORMAT(_Gl + _Sd + _Lc + DIVIDE([@hc] * _Ratio, _Echelle) * _Wmax, "0", "en-US")
			RETURN _x & "," & [@y] & "V" & ([@y] + _Hr), "L", [Lo], DESC))
			VAR _Courbes =
			IF(NOT ISBLANK(_CourbeF),
			"<g pointer-events='none' fill='none' stroke='" & _ColComp & "' stroke-width='1.6' stroke-dasharray='4 3' stroke-linejoin='round' opacity='.75'><path d='" & _CourbeF & "'/><path d='" & _CourbeH & "'/></g>")
			-- 10. Barres, libellés et infobulles
			VAR _LargeurBulle = 360
			VAR _XBulle = FORMAT(_Cx - _LargeurBulle / 2, "0", "en-US")
			VAR _XTxt   = FORMAT(_Cx - _LargeurBulle / 2 + 12, "0", "en-US")
			VAR _HBulle = IF(ISBLANK(_Comp), 48, 68)
			VAR _NomC   = IF(_AvecReg, "Regroupement", "Ensemble")
			VAR _Barres =
			CONCATENATEX(_TabP3,
			VAR _Lab  = IF([Hi] >= 99, [Lo] & " ans et +", [Lo] & "–" & [Hi])
			VAR _y    = [@y]
			VAR _yb   = _y + (_Hr - _Hb) / 2
			VAR _wf   = MAX(DIVIDE([@ft], _Echelle) * _Wmax, 3)
			VAR _wh   = MAX(DIVIDE([@ht], _Echelle) * _Wmax, 3)
			VAR _On   = ISBLANK(_CSel) || [Cat] = _CSel
			VAR _Dim  = IF(_On, "", " dim")
			VAR _yt   = IF([@i] > 2, _y - _HBulle - 4, _y + _Hr + 4)
			VAR _Tot  = [@ft] + [@ht]
			RETURN
			"<g class='pt'><rect class='hl' x='" & _Gl & "' y='" & _y & "' width='" & (_Wp - _Gl) & "' height='" & _Hr & "' rx='5'/>"
			& IF([@ft] > 0, "<rect class='" & _ClF & _Dim & "' x='" & FORMAT(_Gl + _Sd - _wf, "0.0", "en-US") & "' y='" & FORMAT(_yb, "0.0", "en-US") & "' width='" & FORMAT(_wf, "0.0", "en-US") & "' height='" & _Hb & "' rx='6'/>")
			& IF([@ht] > 0, "<rect class='" & _ClH & _Dim & "' x='" & (_Gl + _Sd + _Lc) & "' y='" & FORMAT(_yb, "0.0", "en-US") & "' width='" & FORMAT(_wh, "0.0", "en-US") & "' height='" & _Hb & "' rx='6'/>")
			& "<text x='" & _Cx & "' y='" & FORMAT(_y + _Hr / 2 + 5, "0.0", "en-US") & "' text-anchor='middle'" & IF(_On, "", " opacity='.45'") & "><tspan class='lb'>" & IF([Hi] >= 99, [Lo] & "+", _Lab) & "</tspan><tspan dx='7' class='tv'>" & FORMAT(_Tot, "#,0") & "</tspan></text>"
			& "<g class='ptip'><rect class='tb' x='" & _XBulle & "' y='" & _yt & "' width='" & _LargeurBulle & "' height='" & _HBulle & "' rx='8'/>"
			& "<text class='t1' x='" & _XTxt & "' y='" & (_yt + 19) & "'>" & _Lab & IF([Hi] >= 99, "", " ans") & " · " & FORMAT(_Tot, "#,0") & " licences · " & FORMAT(DIVIDE(_Tot, _TotP), "0.0 %") & "</text>"
			& "<text class='t2' x='" & _XTxt & "' y='" & (_yt + 38) & "'>Femmes " & FORMAT([@ft], "#,0") & " (" & FORMAT(DIVIDE([@ft], _TotP), "0.0 %") & ") · Hommes " & FORMAT([@ht], "#,0") & " (" & FORMAT(DIVIDE([@ht], _TotP), "0.0 %") & ")</text>"
			& IF(NOT ISBLANK(_Comp), "<text class='t3' x='" & _XTxt & "' y='" & (_yt + 57) & "'>" & _NomC & " : " & FORMAT(DIVIDE([@fc] + [@hc], _TotC), "0.0 %") & " des licences (F " & FORMAT(DIVIDE([@fc], _TotC), "0.0 %") & " · H " & FORMAT(DIVIDE([@hc], _TotC), "0.0 %") & ")</text>")
			& "</g><rect class='hz' x='0' y='" & _y & "' width='" & _Wp & "' height='" & _Hr & "'/></g>",
			"", [Lo], DESC)
			-- 11. En-tête, légende (toujours complète), alerte effectif faible
			VAR _Ico = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='" & [Style Couleur accent] & "' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 6h7M4 10h10M4 14h12M4 18h8'/><path d='M20 4v16'/></svg>"
			VAR _Pt  = "<i style='display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;background:"
			VAR _Avertissement =
			IF(_TotP > 0 && _TotP < _SeuilFaible,
			"<span class='tt' style='flex:none;display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 9px;border-radius:12px;background:" & [Style Couleur filtre actif fond] & ";font-size:13px;font-weight:600;color:" & [Style Couleur filtre actif texte] & "'>"
			& "<svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.4' stroke-linecap='round'><circle cx='12' cy='12' r='9'/><path d='M12 8v5M12 16.5v.5'/></svg>effectif faible"
			& "<span class='tip bas'><b>" & FORMAT(_TotP, "#,0") & " licences avec un âge</b> : à lire avec prudence.<br>Avec moins de " & FORMAT(_SeuilFaible, "#,0") & " licences, quelques licenciés suffisent<br>à faire varier fortement une tranche d'âge.</span></span>")
			VAR _Tete =
			"<div style='display:flex;align-items:center;gap:10px;padding-bottom:10px;border-bottom:1px solid " & _ColPist & "'><span style='flex:none;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;background:" & [Style Couleur accent fond] & "'>" & _Ico & "</span><span style='flex:none;font-size:" & _TxtTxt & "px;font-weight:700;color:" & _ColTxt & "'>Pyramide des âges</span>" & _Avertissement
			& "<span style='margin-left:auto;display:flex;align-items:center;gap:14px;font-size:" & _TxtPet & "px;color:" & _ColLib & ";min-width:0'><span style='flex:none'>" & _Pt & _ColF & "'></i>Femmes</span><span style='flex:none'>" & _Pt & _ColH & "'></i>Hommes</span>"
			& IF(NOT ISBLANK(_Comp), "<span class='tt' style='display:flex;align-items:center;min-width:0'><i style='flex:none;display:inline-block;width:16px;border-top:2px dashed " & _ColComp & ";margin-right:6px'></i><span class='el'>" & _NomComp & "</span><span class='tip bas'><b>Courbe en pointillé</b> : répartition par âge de " & _NomComp & ",<br>ramenée au même nombre de licences que la sélection.</span></span>",
			"<span class='tt' style='display:flex;align-items:center;min-width:0;opacity:.4'><i style='flex:none;display:inline-block;width:16px;border-top:2px dashed " & _ColNeut & ";margin-right:6px'></i><span class='el'>Comparaison</span><span class='tip bas'>La sélection est déjà l'ensemble des fédérations :<br>pas de courbe de comparaison.</span></span>")
			& "</span></div>"
			VAR _SansAge =
			"<div style='margin-top:12px;padding:24px;border:1.5px dashed " & [Style Couleur bordure forte] & ";border-radius:10px;text-align:center;font-size:" & _TxtTxt & "px;color:" & _ColLib & "'><b style='color:" & _ColTxt & "'>Pyramide non disponible</b><br><span style='font-size:" & _TxtPet & "px'>Aucune licence avec un âge renseigné pour cette sélection.</span></div>"
			-- 12. Assemblage
			RETURN
			_Tete
			& IF(_TotP = 0,
			_SansAge,
			_Css
			& "<svg class='py' viewBox='0 0 " & _Wp & " " & _Hp & "' width='100%' font-family='" & [Style Police] & "' style='display:block;margin-top:12px;overflow:visible'>" & _Groupes & _Grille & _Courbes & _Barres & "</svg>")
		isHidden
		displayFolder: 6. Portrait\Qui
		lineageTag: 17eeaaea-700b-470c-bdcf-46e78ae05bc1

	/// Styles du tableau des fédérations, construits sur la charte commune (dossier 0. Style).
	measure 'HTML Tableau Federations CSS' =
			VAR _Marine = [Style Couleur marine]
			VAR _Accent = [Style Couleur accent]
			VAR _Sel = [Style Couleur sélection]
			VAR _SelClair = [Style Couleur sélection clair]
			VAR _Reg = [Style Couleur regroupement]
			VAR _Grille = [Style Couleur grille]
			VAR _FondAcc = [Style Couleur accent fond]
			RETURN
			".tb { height:100%; max-height:100vh; overflow:auto; background:#FFFFFF; font-family:" & [Style Police] & "; font-size:12px; color:" & [Style Couleur texte] & "; font-variant-numeric:tabular-nums; }"
			& ".lg { display:grid; align-items:center; border-bottom:1px solid " & _Grille & "; }"
			& ".lg > div { padding:7px 10px; text-align:right; white-space:nowrap; }"
			& ".lg > div.nom { text-align:left; white-space:normal; line-height:1.3; position:sticky; left:0; z-index:2; background:inherit; display:flex; align-items:center; gap:10px; box-shadow:1px 0 0 " & _Grille & "; }"
			& ".ent { position:sticky; top:0; z-index:5; background:" & _Marine & "; color:#FFFFFF; font-size:10.5px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; border-bottom:3px solid " & _Accent & "; }"
			& ".ent > div { padding:10px; }"
			& ".tot { position:sticky; bottom:0; z-index:5; background:" & _Marine & "; color:#FFFFFF; font-weight:700; border-top:3px solid " & _Accent & "; }"
			& ".cat { background:" & _FondAcc & "; color:" & _Marine & "; font-weight:700; cursor:pointer; }"
			& ".cat > div.nom { border-left:4px solid " & _Marine & "; }"
			& ".csel { background:" & _Sel & "; color:#FFFFFF; font-weight:700; cursor:pointer; }"
			& ".csel > div.nom { border-left:4px solid " & _Reg & "; }"
			& ".fed { background:#FFFFFF; }"
			& ".fed:hover, .fsel:hover { background:" & [Style Couleur fond neutre] & "; }"
			& ".fed > div.nom, .fsel > div.nom { padding-left:30px; font-weight:500; }"
			& ".fsel { background:" & _SelClair & "; font-weight:700; }"
			& ".fsel > div.nom { border-left:4px solid " & _Sel & "; padding-left:26px; font-weight:700; }"
			& "summary { list-style:none; } summary::-webkit-details-marker { display:none; }"
			& ".pm { display:inline-flex; align-items:center; justify-content:center; width:18px; height:18px; border-radius:50%; background:rgba(11,28,79,.10); font-weight:700; font-size:13px; line-height:1; flex-shrink:0; }"
			& ".csel .pm { background:rgba(255,255,255,.25); }"
			& "details .pm::before { content:'+'; } details[open] .pm::before { content:'−'; }"
			& ".nb { font-weight:400; opacity:.7; font-size:11px; }"
			& ".logo { width:22px; height:22px; object-fit:contain; flex-shrink:0; border-radius:4px; background:#FFFFFF; }"
			& ".up, .dn, .eq { display:inline-block; min-width:64px; padding:2px 8px; border-radius:12px; font-weight:600; font-size:11px; text-align:center; }"
			& ".up { background:" & [Style Couleur hausse fond] & "; color:" & [Style Couleur hausse] & "; }"
			& ".dn { background:" & [Style Couleur baisse fond] & "; color:" & [Style Couleur baisse] & "; }"
			& ".eq { background:" & [Style Couleur fond neutre] & "; color:" & [Style Couleur texte libellé] & "; }"
			& ".csel .up, .csel .dn, .csel .eq { background:rgba(255,255,255,.92); }"
			& ".trk { height:3px; border-radius:2px; background:" & _Grille & "; margin-top:4px; margin-left:auto; }"
			& ".barre { height:3px; border-radius:2px; background:" & _Sel & "; margin-left:auto; }"
			& ".csel .trk { background:rgba(255,255,255,.35); } .csel .barre { background:#FFFFFF; }"
			& ".cat .barre { background:" & _Marine & "; }"
			& ".fsel .barre { background:" & _Marine & "; }"
		isHidden
		displayFolder: 2. Affichage
		lineageTag: 090c5c3a-73cb-407c-b72d-ef5cecb02fcd

	/// Âge moyen des licenciés (âge exact de la table, pondéré par le nombre de licences), année la plus récente de la sélection. Licences sans âge exclues.
	measure 'Âge moyen' =
			VAR _AnneeRef = MAX(T_Annee[Annee])
			RETURN
			    CALCULATE(
			        DIVIDE(SUMX(F_Licences, F_Licences[Age] * F_Licences[NbLicences]), SUM(F_Licences[NbLicences])),
			        T_Annee[Annee] = _AnneeRef,
			        NOT ISBLANK(F_Licences[Age])
			    )
		formatString: 0.0
		displayFolder: 6. Portrait\Qui
		lineageTag: 266d90a8-0a7a-42d7-8ced-a1fae02e1e7a

	/// Charte : taille du titre d'un bloc (px, nombre en texte). Page de 1920 x 1400 : tailles pensées pour rester lisibles une fois la page réduite à l'écran.
	measure 'Style Taille titre' = "22"
		displayFolder: 0. Style\Tailles
		lineageTag: ed48362f-96e5-4923-96be-ad50509af5b9

	/// Charte : taille du texte courant (libellés, légendes, valeurs secondaires), en px.
	measure 'Style Taille texte' = "15"
		displayFolder: 0. Style\Tailles
		lineageTag: 188fc36d-0e18-412e-87a9-30db73d4a7ab

	/// Charte : taille des notes, axes et sous-titres, en px.
	measure 'Style Taille petit' = "14"
		displayFolder: 0. Style\Tailles
		lineageTag: 93659b6b-8696-448a-9cfd-aa8190d99db2

	/// Charte : taille du chiffre principal d'une carte ou d'une section, en px.
	measure 'Style Taille chiffre' = "32"
		displayFolder: 0. Style\Tailles
		lineageTag: 2ae0e485-6a3d-4f4b-9397-c52e6973d8c2

	/// Charte : taille d'une valeur mise en avant dans une liste ou une légende, en px.
	measure 'Style Taille valeur' = "17"
		displayFolder: 0. Style\Tailles
		lineageTag: da2eb3c5-9803-4ee2-bb47-d2f82039fcd2

	/// Charte : couleur des zones sans donnée ou non calculables (carte, graphiques).
	measure 'Style Couleur sans donnée' = "#D9DDE5"
		displayFolder: 0. Style\Couleurs et police
		lineageTag: 912e9df6-7a8d-4e36-a0b2-bde135001c1f

	/// Nature de la sélection fédération : Ensemble (rien de choisi ou Ensemble), Regroupement (famille, sous-famille ou groupe sans fédération), Fédération (une seule), Plusieurs fédérations. Référence commune de tous les blocs HTML.
	measure 'Sélection mode' =
			-- =====================================================================
			-- Sélection mode : nature de la sélection fédération (texte)
			--   Segment Regroupement = P_Niveaux[Famille | Sous-famille | Groupe] (paramètre Param_Niveau)
			--                          → clé P_Niveaux[Cle] (« Ensemble » = pas de regroupement)
			--   Segment Fédération   = colonnes de P_Federation (paramètre Param_Federation)
			-- Résultat : Ensemble | Regroupement | Fédération | Plusieurs fédérations
			-- =====================================================================
			VAR _FedFiltree = ISFILTERED(P_Federation)
			VAR _NbFed      = COUNTROWS(VALUES(T_Federation[CodeReference]))
			VAR _CleNiv     = IF(ISFILTERED(P_Niveaux) && HASONEVALUE(P_Niveaux[Cle]), VALUES(P_Niveaux[Cle]))
			VAR _ClePar     = IF(ISFILTERED(Param_Federation) && HASONEVALUE(Param_Federation[Cle]), VALUES(Param_Federation[Cle]))
			VAR _CleReg     = COALESCE(_CleNiv, _ClePar)
			RETURN
			    SWITCH(TRUE(),
			        _FedFiltree && _NbFed = 1, "Fédération",
			        _FedFiltree && _NbFed > 1, "Plusieurs fédérations",
			        NOT ISBLANK(_CleReg) && _CleReg <> "Ensemble", "Regroupement",
			        "Ensemble")
		displayFolder: 4. Indicateurs\Sélection
		lineageTag: 73b70a43-3ef8-4a3e-8820-5a44cc07a653

	/// Libellé de la sélection pour les titres et légendes : nom court de la fédération, nom du regroupement, « Plusieurs fédérations » ou « Ensemble des fédérations ».
	measure 'Sélection libellé' =
			-- =====================================================================
			-- Sélection libellé : texte affiché pour la sélection fédération
			-- Le regroupement se lit dans la clé « F · Nom », « SF · Nom » ou « G · Nom »
			-- (P_Niveaux[Cle] pour le segment Regroupement, Param_Federation[Cle] en secours).
			-- =====================================================================
			VAR _Mode   = [Sélection mode]
			VAR _CleReg = COALESCE(
			                  IF(HASONEVALUE(P_Niveaux[Cle]), VALUES(P_Niveaux[Cle])),
			                  SELECTEDVALUE(Param_Federation[Cle]))
			VAR _NomReg = TRIM(MID(_CleReg, SEARCH(" · ", _CleReg, 1, 0) + 3, 200))
			RETURN
			    SWITCH(_Mode,
			        "Fédération",            SELECTEDVALUE(T_Federation[Nom court]),
			        "Plusieurs fédérations", "Plusieurs fédérations",
			        "Regroupement",           COALESCE(_NomReg, [Nom regroupement], "Regroupement"),
			        "Ensemble des fédérations")
		displayFolder: 4. Indicateurs\Sélection
		lineageTag: 958bfa61-3a5f-4c7d-95fd-307f0d285e94

	/// Liste des fédérations sélectionnées (noms courts, par licences décroissantes), limitée à _NbMax noms puis « et n autres ». Sert aux infobulles quand plusieurs fédérations sont choisies.
	measure 'Sélection liste' =
			-- =====================================================================
			-- Sélection liste : noms des fédérations choisies (infobulles)
			-- =====================================================================
			-- 1. Réglages
			VAR _NbMax = 6
			VAR _Sep   = ", "
			-- 2. Données
			VAR _Feds  = ADDCOLUMNS(VALUES(T_Federation[Nom court]), "@Lic", [NB Licences])
			VAR _Nb    = COUNTROWS(_Feds)
			VAR _Top   = TOPN(_NbMax, _Feds, [@Lic], DESC, T_Federation[Nom court], ASC)
			-- 3. Résultat
			RETURN
			    CONCATENATEX(_Top, T_Federation[Nom court], _Sep, [@Lic], DESC)
			        & IF(_Nb > _NbMax, " et " & (_Nb - _NbMax) & " autre" & IF(_Nb - _NbMax > 1, "s", ""))
		displayFolder: 4. Indicateurs\Sélection
		lineageTag: c6ef508f-0ecf-40a1-a397-0f8e09abdd05

	/// Charte : balise <style> commune à tous les blocs HTML (infobulles .tt/.tip, survol SVG .pt, texte tronqué .el, chiffres insécables .nb). À placer une fois au début de chaque mesure HTML.
	measure 'Style CSS commun' =
			-- =====================================================================
			-- Style CSS commun : classes partagées par tous les blocs HTML
			--   .tt  : élément qui porte une infobulle (.tip à l'intérieur)
			--   .tip : infobulle sombre, affichée au survol de .tt
			--          (alignée à gauche pour le 1er élément d'une ligne, à droite pour le dernier)
			--   .bas : infobulle affichée sous l'élément (pour le haut des blocs)
			--   .pt  : groupe SVG survolable ; .hl (surbrillance) et .ptip (infobulle SVG) visibles au survol
			--   .el  : texte tronqué avec « … » (le texte complet est dans l'infobulle)
			--   .nb  : valeur chiffrée, jamais coupée
			-- =====================================================================
			VAR _Fond  = [Style Couleur texte]
			VAR _Petit = [Style Taille petit]
			RETURN
			    "<style>html,body{margin:0;padding:0;overflow:hidden}*{box-sizing:border-box}"
			    & ".tt{position:relative}"
			    & ".tt .tip{opacity:0;visibility:hidden;pointer-events:none;position:absolute;z-index:20;left:50%;bottom:calc(100% + 8px);transform:translateX(-50%);"
			    & "background:" & _Fond & ";color:#FFFFFF;font-size:" & _Petit & "px;font-weight:400;line-height:1.45;text-align:left;letter-spacing:0;"
			    & "padding:8px 11px;border-radius:8px;white-space:nowrap;box-shadow:0 8px 20px rgba(16,24,40,.22);transition:opacity .12s}"
			    & ".tt:first-child .tip{left:0;transform:none}.tt:last-child .tip{left:auto;right:0;transform:none}"
			    & ".tt .tip.bas{bottom:auto;top:calc(100% + 8px)}"
			    & ".tt:hover .tip{opacity:1;visibility:visible}.tip b{font-weight:600}.tip span{color:#B7C0CF}"
			    & ".pt .ptip,.pt .hl{opacity:0;transition:opacity .12s}.pt:hover .ptip,.pt:hover .hl{opacity:1}"
			    & ".el{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
			    & ".nb{flex:none;white-space:nowrap;font-variant-numeric:tabular-nums}</style>"
		displayFolder: 0. Style\Blocs CSS
		lineageTag: 0ad459eb-aec1-43df-86b2-3ea5a5dca245

	/// Nombre de fédérations dans la sélection (toutes si rien n'est choisi).
	measure 'Sélection nb fédérations' = COUNTROWS(VALUES(T_Federation[CodeReference]))
		formatString: 0
		displayFolder: 4. Indicateurs\Sélection
		lineageTag: 6699d438-c65b-41f7-bdc4-6e46b2b3cf80

	/// 1 quand un département est choisi : la carte est forcée au niveau département, le segment Niveau géo n'a plus d'effet et doit disparaître. Lu par les mesures Segment Niveau géo …
	measure 'Segment Niveau géo masqué' =
			-- 1 = un département est choisi (segment Département, champ de Param_Departement → P_TerrDep)
			IF(ISFILTERED(P_TerrDep), 1, 0)
		formatString: 0
		displayFolder: 3. Filtres de segments\Masquage
		lineageTag: 51b1bd34-9d72-4909-9973-bad34f4b8d56

	/// Couleur du texte des boutons du segment Niveau géo (fx) : couleur du fond du bloc quand un département est choisi (segment invisible), sinon couleur normale. À mettre sur les états Par défaut et Sélectionné.
	measure 'Segment Niveau géo couleur texte' =
			-- Texte invisible (couleur du fond du bloc) quand un département est choisi
			IF([Segment Niveau géo masqué] = 1, [Style Couleur fond cadre], [Style Couleur texte])
		displayFolder: 3. Filtres de segments\Masquage
		lineageTag: 6311606a-075a-49ff-b19e-f86db71eb95d

	/// Couleur du texte du bouton sélectionné du segment Niveau géo (fx) : blanc sur indigo, ou couleur du fond du bloc quand un département est choisi.
	measure 'Segment Niveau géo couleur texte sélection' = IF([Segment Niveau géo masqué] = 1, [Style Couleur fond cadre], "#FFFFFF")
		displayFolder: 3. Filtres de segments\Masquage
		lineageTag: efabde5d-60e7-4f7e-a2f0-caecfa9680a0

	/// Remplissage des boutons non sélectionnés du segment Niveau géo (fx) : couleur du fond du bloc (blanc).
	measure 'Segment Niveau géo couleur fond' = [Style Couleur fond cadre]
		displayFolder: 3. Filtres de segments\Masquage
		lineageTag: d9046684-3ae4-485e-a9cc-e8d0fabb770f

	/// Remplissage du bouton sélectionné du segment Niveau géo (fx) : marine, ou couleur du fond du bloc quand un département est choisi (segment invisible).
	measure 'Segment Niveau géo couleur fond sélection' = IF([Segment Niveau géo masqué] = 1, [Style Couleur fond cadre], [Style Couleur marine])
		displayFolder: 3. Filtres de segments\Masquage
		lineageTag: a550a6b9-a840-4adb-b3d0-c3c844376c00

	/// Bordure des boutons du segment Niveau géo (fx) : bordure normale, ou couleur du fond du bloc quand un département est choisi.
	measure 'Segment Niveau géo couleur bordure' = IF([Segment Niveau géo masqué] = 1, [Style Couleur fond cadre], [Style Couleur bordure forte])
		displayFolder: 3. Filtres de segments\Masquage
		lineageTag: 3bfe76f4-81bd-47dc-a113-846f89c54d48

	column _
		isHidden
		lineageTag: d2cf5779-78ce-4624-8c0d-6ed2b896cdd8
		isNameInferred
		sourceColumn: [_]

	partition _Mesures = calculated
		mode: import
		source = ROW("_", BLANK())

