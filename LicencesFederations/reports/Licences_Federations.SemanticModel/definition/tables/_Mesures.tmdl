	measure 'Style CSS légende' =
			-- Texte des légendes
			"font-size:" & [Style Taille texte] & "px;line-height:1.3;color:" & [Style Couleur texte secondaire]
		displayFolder: 00. Charte graphique\Blocs CSS
		lineageTag: ca8961a5-ab1f-4844-be6b-d37a148cc620

	/// Cadre du bloc TERRITOIRES (visuel HTML Content placé sous la carte Azure Maps) : titre, sous-titre sur 1 ligne pleine largeur suivi d'une icône note de lecture (définition et calcul de l'indicateur, au survol) et d'une alerte si l'indicateur n'est pas calculable ; les infobulles s'ouvrent sous le sous-titre, alignées à gauche, sans être coupées. Légende des couleurs (même rendu que la carte), case « sans donnée », territoire choisi. Charte : dossier 0. Style.
	measure 'HTML Carte' =
			-- =====================================================================
			-- HTML Carte | bloc TERRITOIRES | page Portrait | visuel HTML Content ~745 x 500
			-- Visuel placé SOUS la carte Azure Maps (marges intérieures 0, arrière-plan désactivé) :
			-- la carte (fond transparent) se pose dans la zone vide entre le titre et la légende.
			-- Sous-titre sur 1 ligne pleine largeur, suivi d'une icône « note de lecture » (infobulle au survol)
			-- et d'alertes (infobulle au survol) : indicateur non calculable, calculable en partie seulement,
			-- ou population estimée par âge (taux de licences avec une catégorie d'âge choisie).
			-- Les infobulles du sous-titre s'ouvrent sous la ligne, alignées à son bord gauche : jamais coupées.
			-- =====================================================================
			-- 1. Réglages
			VAR _HauteurCadre   = 572      -- hauteur du visuel - 20 environ (barre de défilement sinon)
			VAR _PlaceSegments  = 380      -- place libre en haut à droite (segments Indicateur et Niveau géo) pour la ligne du titre
			VAR _LargeurDegrade = 180      -- largeur de la barre de couleurs
			VAR _LargeurInfo    = 400      -- largeur max des infobulles (note de lecture, alerte)
			VAR _EspaceSousTitre = 12      -- espace au-dessus du sous-titre (px)
			VAR _OpaciteCarte   = ".85"    -- même opacité que le remplissage des zones dans Azure Maps (à caler sur la carte)
			-- 2. Charte
			VAR _ColTxt  = [Style Couleur texte]
			VAR _ColSel  = [Style Couleur marine]          -- contour du territoire choisi sur la carte
			VAR _ColVide = [Style Couleur sans donnée]
			VAR _TxtPet  = [Style Taille petit]
			-- 3. Données
			VAR _Ind    = SELECTEDVALUE(T_CarteIndicateur[Ordre], 1)
			VAR _Nom    = SELECTEDVALUE(T_CarteIndicateur[Indicateur], "Licences")
			VAR _Diverg = _Ind IN {2, 3, 5}
			VAR _Centre = IF(_Ind = 5, 1, 0)
			VAR _Fmt    = SWITCH(_Ind, 1, "#,0", 4, "0.0 %", 5, "0.00", 6, "#,0.0", "+0.0 %;-0.0 %;0.0 %")
			VAR _Lo     = [Carte Min]
			VAR _Hi     = [Carte Max]
			VAR _Amp    = MAX(ABS(_Hi - _Centre), ABS(_Lo - _Centre))
			VAR _Pal    = [Carte Palette]
			VAR _C1     = LEFT(_Pal, 7)
			VAR _C2     = MID(_Pal, 9, 7)
			VAR _C3     = RIGHT(_Pal, 7)
			VAR _Niv    = [Carte Niveau]
			VAR _Force  = ISFILTERED(P_TerrDep) && SELECTEDVALUE(T_NiveauGeo[Ordre], 1) = 1
			VAR _Groupe = SELECTEDVALUE(P_TerrChoix[Id territoire]) IN {"DROM", "COM", "AUT"}
			VAR _Annee  = VALUE(MAX(T_Annee[Annee]))   -- T_Annee[Annee] est un texte
			VAR _Terr   = [Libellé territoire]
			VAR _SurCarte = NOT ISEMPTY(FILTER(ALL(T_CarteAffichage[Id carte]), [Carte Visible] = 1))
			VAR _SousTitre =
			    _Nom & IF(_Ind IN {1, 4, 5, 6}, " " & _Annee, " (" & _Annee & ")")
			    & " · " & [Sélection libellé]
			    & " · " & IF(_Groupe, "par territoire", IF(_Niv = 1, "par région", "par département" & IF(_Force, " (département choisi)")))
			-- zones affichées sans valeur (taux de licences : territoires sans population INSEE)
			VAR _NbSansPop =
			    IF(_Ind = 6,
			        COUNTROWS(
			            CALCULATETABLE(
			                FILTER(VALUES(T_CarteAffichage[Id carte]), [Carte Visible] = 1 && ISBLANK([Carte Valeur])),
			                REMOVEFILTERS(T_CarteAffichage[Id carte], T_CarteAffichage[Latitude], T_CarteAffichage[Longitude], T_CarteAffichage[Rôle])
			            )
			        ))
			-- évolutions et indice : bornes de la légende = 90e centile de chaque côté (mêmes bornes que Carte Couleur), « ≤ » / « ≥ » si des zones les dépassent
			VAR _TabZ = CALCULATETABLE(ADDCOLUMNS(FILTER(VALUES(T_CarteAffichage[Id carte]), [Carte Visible] = 1), "@v", [Carte Valeur]), REMOVEFILTERS(T_CarteAffichage[Id carte], T_CarteAffichage[Latitude], T_CarteAffichage[Longitude], T_CarteAffichage[Rôle]))
			VAR _ZP = FILTER(_TabZ, NOT ISBLANK([@v]) && [@v] > _Centre)
			VAR _ZN = FILTER(_TabZ, NOT ISBLANK([@v]) && [@v] < _Centre)
			VAR _MaxP = MAXX(_ZP, [@v] - _Centre)
			VAR _MaxN = MAXX(_ZN, _Centre - [@v])
			VAR _AmpP = IF(COUNTROWS(_ZP) >= 5, PERCENTILEX.INC(_ZP, [@v] - _Centre, 0.9), _MaxP)
			VAR _AmpN = IF(COUNTROWS(_ZN) >= 5, PERCENTILEX.INC(_ZN, _Centre - [@v], 0.9), _MaxN)
			VAR _L1 = IF(_Diverg, IF(_MaxN > _AmpN, "≤ ") & FORMAT(_Centre - COALESCE(_AmpN, _AmpP, 0), _Fmt), FORMAT(_Lo, _Fmt))
			VAR _L2 = IF(_Diverg, "<span>" & FORMAT(_Centre, _Fmt) & "</span>", "")
			VAR _L3 = IF(_Diverg, IF(_MaxP > _AmpP, "≥ ") & FORMAT(_Centre + COALESCE(_AmpP, _AmpN, 0), _Fmt), FORMAT(_Hi, _Fmt))
			-- 4. Note de lecture par indicateur (infobulle du sous-titre) et raison d'un calcul impossible
			VAR _Lecture =
			    SWITCH(_Ind,
			        1, "<b>Licences</b> : nombre de licences de la sélection dans chaque zone en " & _Annee & ".<br>Plus la couleur est foncée, plus la zone compte de licences (couleurs réparties par rang entre les zones affichées).",
			        2, "<b>Évolution sur 1 an</b> : (licences " & _Annee & " − licences " & (_Annee - 1) & ") ÷ licences " & (_Annee - 1) & ".<br>Vert = hausse, rouge = baisse.<br>À champ constant (méthode INJEP) : seules les fédérations présentes chaque année depuis 2016 comptent.<br>Zones de moins de 20 licences l'année de départ : non calculées (pourcentage trop instable).<br>Couleurs bornées au 90e centile : les évolutions extrêmes prennent la couleur la plus foncée.",
			        3, "<b>Évolution depuis 2019</b> : (licences " & _Annee & " − licences 2019) ÷ licences 2019, 2019 étant l'année d'avant la crise sanitaire.<br>Vert = hausse, rouge = baisse.<br>À champ constant (méthode INJEP) : seules les fédérations présentes chaque année depuis 2016 comptent.<br>Zones de moins de 20 licences l'année de départ : non calculées (pourcentage trop instable).<br>Couleurs bornées au 90e centile : les évolutions extrêmes prennent la couleur la plus foncée.",
			        4, "<b>Part de femmes</b> : licences féminines ÷ licences de la zone en " & _Annee & ".<br>Plus la couleur est foncée, plus la part est élevée.",
			        5, "<b>Indice de spécificité</b> : poids de la sélection dans la zone ÷ son poids dans l'ensemble des licences (territoire Total).<br>Poids = licences de la sélection ÷ toutes les licences de la zone.<br>1 = même poids qu'au total ; 1,45 = 45 % de plus ; 0,80 = 20 % de moins.<br>Vert = plus représentée, rouge = moins représentée.",
			        6, "<b>Licences pour 1 000 habitants</b> : licences de la sélection en " & _Annee & " ÷ population INSEE au 1er janvier " & _Annee & ", × 1 000.<br>Suit le sexe et la catégorie d'âge choisis (la population est celle du même sexe et du même âge).<br>On compte des licences, pas des personnes : une personne licenciée dans plusieurs fédérations compte plusieurs fois. COM, Monaco, étranger et non réparti n'ont pas de population : ils sont grisés et leurs licences ne comptent pas.",
			        "")
			VAR _Ensemble = _Ind = 5 && [Sélection mode] = "Ensemble"
			VAR _Raison =
			    IF(_Ensemble,
			        "l'indice compare une sélection à l'ensemble des fédérations : choisissez une fédération ou un regroupement",
			        SWITCH(_Ind,
			            2, "aucune licence en " & (_Annee - 1) & " pour comparer",
			            3, IF(_Annee <= 2019, "l'année choisie est antérieure ou égale à 2019", "aucune licence en 2019 pour comparer"),
			            6, "la population INSEE ne couvre pas ce territoire (COM, Monaco, étranger, non réparti) ou n'a pas d'habitants pour ce sexe et cet âge",
			            "aucune licence pour cette sélection"))
			-- alerte : calcul impossible partout (Vrai) ou seulement pour une partie des zones affichées (Partiel)
			VAR _Vrai    = ISBLANK(_Hi) || _Ensemble
			VAR _Partiel = _Ind = 6 && NOT _Vrai && _NbSansPop > 0
			VAR _Alertee = _Vrai || _Partiel
			-- alerte d'approximation : une catégorie d'âge est choisie, la population par âge est estimée
			VAR _Approx  = _Ind = 6 && NOT _Vrai && ISFILTERED(T_TrancheAge)
			-- Infobulle ancrée à la ligne du sous-titre (et non à l'icône) : s'ouvre dessous, à gauche, sur toute la largeur utile
			-- (bottom:auto annule le bottom de la classe .tip, sinon la boîte est écrasée entre top et bottom)
			VAR _Tip = "left:0;right:auto;bottom:auto;transform:none;top:calc(100% + 8px);height:auto;width:" & _LargeurInfo & "px;max-width:100%;white-space:normal;font-size:" & [Style Taille texte] & "px"
			VAR _StylePastille = "position:static;flex:none;display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:999px;cursor:help;font-size:" & _TxtPet & "px;background:" & [Style Couleur filtre actif fond] & ";color:" & [Style Couleur filtre actif texte] & ";border:1.5px solid " & [Style Couleur filtre actif bordure]
			VAR _SvgAlerte = "<svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.4' stroke-linecap='round'><circle cx='12' cy='12' r='9'/><path d='M12 8v5M12 16.5v.5'/></svg>"
			-- 5. Titre : 1re ligne = rubrique + titre ; 2e ligne = sous-titre sur 1 ligne pleine largeur, puis icônes (note de lecture, alertes)
			VAR _IcoInfo =
			    "<span class='tt' style='position:static;flex:none;display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;cursor:help;background:" & [Style Couleur accent fond] & ";color:" & [Style Couleur accent] & ";border:1.5px solid " & [Style Couleur accent] & "'>"
			    & "<svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round'><path d='M12 11v6M12 6.5v.5'/></svg>"
			    & "<span class='tip' style='" & _Tip & "'><b>Note de lecture</b><br>" & _Lecture & "</span></span>"
			VAR _IcoAlerte =
			    IF(_Alertee,
			        "<span class='tt' style='" & _StylePastille & "'>" & _SvgAlerte
			        & "<span style='font-weight:600'>" & IF(_Ensemble, "Pas de données", IF(_Vrai, "Non calculable", "Zones sans population")) & "</span>"
			        & "<span class='tip' style='" & _Tip & "'>"
			        & IF(_Vrai,
			            "<b>" & _Nom & " non calculable</b><br>" & UPPER(LEFT(_Raison, 1)) & MID(_Raison, 2, 300) & ".<br>Les zones sont grisées.",
			            "<b>" & _NbSansPop & IF(_NbSansPop > 1, " zones sans population", " zone sans population") & "</b><br>La population INSEE ne couvre pas les COM, Monaco, l'étranger ni le non réparti : ces zones sont grisées et leurs licences ne comptent pas dans les taux.")
			        & "</span></span>")
			VAR _IcoApprox =
			    IF(_Approx,
			        "<span class='tt' style='" & _StylePastille & "'>" & _SvgAlerte
			        & "<span style='font-weight:600'>Taux approximatif</span>"
			        & "<span class='tip' style='" & _Tip & "'><b>Population estimée par âge</b><br>L'INSEE donne la population par tranches de 5 ans, qui ne coïncident pas avec les catégories d'âge (Enfants 1–13, Jeunes 14–20, Adultes 21–55, Seniors 56–99). Chaque tranche est répartie également entre ses âges : le dénominateur, donc le taux, est approximatif.<br>Sans catégorie d'âge choisie, la population est exacte.</span></span>")
			VAR _Titre =
			    "<div style='padding-right:" & _PlaceSegments & "px'>"
			    & "<div style='" & [Style CSS ligne titre] & "'>"
			    & "<span style='" & [Style CSS rubrique] & "'>TERRITOIRES</span>"
			    & "<span style='" & [Style CSS titre bloc] & "'>Répartition territoriale</span></div></div>"
			    & "<div style='" & [Style CSS sous-titre] & ";margin-top:" & _EspaceSousTitre & "px;position:relative;display:flex;align-items:center;gap:10px;min-width:0'>"
			    & "<span class='el' style='min-width:0'>" & _SousTitre & "</span>" & _IcoInfo & _IcoAlerte & _IcoApprox & "</div>"
			-- 6. Zone de la carte (vide : la carte Azure Maps se pose dessus) ou message hors carte
			VAR _Zone =
			    IF(_SurCarte,
			        "<div style='flex:1;min-height:0'></div>",
			        "<div style='flex:1;margin:14px 0 4px 0;border:1.5px dashed " & [Style Couleur bordure forte] & ";border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;padding:0 24px;" & [Style CSS légende] & "'>"
			        & "<b style='color:" & _ColTxt & ";font-size:" & [Style Taille texte] & "px'>Territoire hors carte</b>"
			        & "<span>Ce territoire n'a pas de zone sur la carte. Les chiffres de la page portent sur : <b style='color:" & _ColTxt & "'>" & _Terr & "</b></span></div>")
			-- 7. Légende : chiffres AU-DESSUS du dégradé ; le dégradé est aligné en bas avec les autres éléments
			--    (case « sans donnée », territoire choisi) ; même opacité que la carte
			VAR _Choix =
			    IF(_Terr <> "Tous territoires",
			        "<div style='display:flex;align-items:center;gap:8px'><i style='flex:none;display:inline-block;width:16px;height:11px;border:2.5px solid " & _ColSel & ";border-radius:2px'></i>"
			        & "<span>Territoire choisi : <b style='color:" & _ColTxt & "'>" & _Terr & "</b></span></div>")
			VAR _CaseVide =
			    "<div class='tt' style='display:flex;align-items:center;gap:8px'><i style='flex:none;display:inline-block;width:16px;height:11px;border-radius:2px;background:" & _ColVide & ";opacity:" & _OpaciteCarte & "'></i><span>" & SWITCH(_Ind, 1, "Aucune licence", 6, "Sans population", "Non calculable") & "</span>"
			    & "<span class='tip'>" & SWITCH(_Ind, 1, "Zone sans licence pour cette sélection.", 6, "Zone sans population INSEE (COM, Monaco, étranger, non réparti)<br>ou sans licence pour cette sélection.", "Indicateur non calculable dans la zone :<br>" & _Raison & ".") & "</span></div>"
			VAR _Degrade =
			    "<div style='width:" & _LargeurDegrade & "px'>"
			    & IF(_Diverg, "<div style='display:flex;justify-content:space-between;font-size:13px;color:" & [Style Couleur texte discret] & "'><span>" & IF(_Ind = 5, "moins représentée", "baisse") & "</span><span>" & IF(_Ind = 5, "plus représentée", "hausse") & "</span></div>")
			    & "<div style='display:flex;justify-content:space-between;font-size:" & _TxtPet & "px;margin-bottom:4px'><span class='nb'>" & _L1 & "</span>" & _L2 & "<span class='nb'>" & _L3 & "</span></div>"
			    & "<div style='height:10px;margin-bottom:4px;border-radius:5px;opacity:" & _OpaciteCarte & ";background:linear-gradient(90deg," & _C1 & "," & _C2 & "," & _C3 & ")'></div></div>"
			VAR _Legende =
			    IF(_SurCarte,
			        "<div style='display:flex;align-items:flex-end;justify-content:space-between;gap:10px 22px;flex-wrap:wrap;margin-top:8px;" & [Style CSS légende] & "'>"
			        & "<div style='display:flex;align-items:flex-end;gap:22px'>"
			        & IF(_Vrai, _CaseVide, _Degrade & _CaseVide) & "</div>"
			        & _Choix
			        & "</div>")
			-- 8. Assemblage
			RETURN
			    [Style CSS commun]
			    & "<div style='" & [Style CSS cadre] & ";height:" & _HauteurCadre & "px;color:" & _ColTxt & "'>"
			    & _Titre & _Zone & _Legende & "</div>"
		displayFolder: 07. Page Portrait\Carte
		lineageTag: d1571e21-2e73-46f0-a9f0-356131150e8a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

