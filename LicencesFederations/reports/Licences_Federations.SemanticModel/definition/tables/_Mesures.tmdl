	/// Charte : texte courant (légendes, étiquettes).
	measure 'Style Couleur texte secondaire' = "#475467"
		displayFolder: 0. Style\Couleurs et police
		lineageTag: b4e014f4-e4b1-4ca3-86ee-c6be6748a243

	/// Charte : texte discret (sous-titres, axes).
	measure 'Style Couleur texte discret' = "#8A94A6"
		displayFolder: 0. Style\Couleurs et police
