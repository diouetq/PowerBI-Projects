/// Table de mesures : regroupe toutes les mesures du rapport (aucune donnée).
table _Mesures
	lineageTag: b41e1dc9-0453-4301-a1b5-3635294a63fe

	/// Nombre de licences annuelles. Si plusieurs années sont sélectionnées (ou aucune), prend la plus récente de la sélection, pour ne jamais additionner des années entre elles.
	measure 'NB Licences' =
			VAR _AnneeRef = MAX(T_Annee[Annee])          -- année la plus récente de la sélection
			RETURN
			    CALCULATE(
			        SUM(F_Licences[NbLicences]),
			        T_Annee[Annee] = _AnneeRef
			    )
		formatString: #,0
		displayFolder: 1. Licences
		lineageTag: 01f1e173-d500-43c9-aca0-5d2f43db538b

	/// Filtre visuel du segment Regroupement (est 1) : masque l'élément « (Vide) ». Un regroupement = 1 ligne de P_Niveaux ; (Vide) = plusieurs.
	measure 'Filtre Niveau non vide' = IF(COUNTROWS(P_Niveaux) = 1, 1)
		formatString: 0
		displayFolder: 3. Filtres de segments
		lineageTag: 122f75cd-55ec-4f60-abf2-52f55e0260b2

	/// Filtre visuel du segment Fédération (est 1) : masque l'élément « (Vide) ». Une fédération = 1 ligne de P_Federation ; (Vide) = plusieurs.
	measure 'Filtre Fede non vide' = IF(COUNTROWS(P_Federation) = 1, 1)
		formatString: 0
		displayFolder: 3. Filtres de segments
		lineageTag: 183eae17-c7b1-461d-b47e-65cc206d14a9

	/// Tableau HTML repliable (visuel HTML Content) : catégorie = niveau choisi (Famille / Sous-famille / Groupe), sous-catégorie = fédérations avec logo. +/− pour déplier, colonne Fédération, en-tête et Total figés. Indicateurs : licences, évol. 1 an, évol. depuis 2019, âge moyen, % enfants, % femmes. Chiffres indépendants de tous les segments (dernière année disponible) ; les segments servent seulement à mettre en avant le regroupement et la fédération choisis. Réglages et CSS en haut de la mesure.
	measure 'HTML Tableau Federations' =
			-- =====================================================================
			-- HTML Tableau Federations | page Détails fédération | visuel HTML Content ~876 x 862
			-- Tableau repliable : regroupements (famille, sous-famille ou groupe selon le segment Niveau),
			-- puis fédérations (nom court, nom complet au survol). Indépendant des segments : dernière année.
			-- Le regroupement / la fédération choisis sont mis en avant. Styles : HTML Tableau Federations CSS.
			-- =====================================================================
			-- 1. Réglages
			VAR _AnneeComparaison = 2019                       -- 2e évolution (avant Covid)
			VAR _TrancheEnfants   = "1 - Enfants (1-13)"       -- libellé source de la tranche enfants
			VAR _CodeFemmes       = "F"
			VAR _LibelleNonClasse = "Non classé"
			VAR _OuvrirTout       = TRUE()                     -- TRUE = tout déplié au départ ; FALSE = seule la catégorie choisie
			VAR _SeuilNeutre      = 0.01                       -- évolution entre -1 % et +1 % = neutre (≈)
			VAR _LargeurNom       = 236                        -- largeur de la colonne Fédération (px) : nom court, nom complet au survol
			VAR _LargeurCol       = 100                        -- largeur des colonnes d'indicateurs (px) ; 236 + 6 x 100 = 836 px < largeur du visuel
			-- Styles : mesure HTML Tableau Federations CSS (charte commune, dossier 0. Style)
			VAR _CSS = [HTML Tableau Federations CSS]
			VAR _FlecheHaut = "▲"
			VAR _FlecheBas  = "▼"
			VAR _FlecheNeutre = "≈"
			VAR _FormatNombre = "#,0"
			VAR _FormatPct    = "0.0 %"
			VAR _FormatEvol   = "+0.0 %;-0.0 %;0.0 %"
			VAR _FormatAge    = "0.0"
			-- 2. Sélections (mise en avant seulement)
			VAR _Niveau     = SWITCH(SELECTEDVALUE(Param_Niveau[Paramètre Commande]), 1, "Sous-famille", 2, "Groupe", "Famille")
			VAR _RegroupSel =
			    SWITCH(_Niveau,
			        "Famille",      SELECTEDVALUE(P_Niveaux[Famille]),
			        "Sous-famille", SELECTEDVALUE(P_Niveaux[Sous-famille]),
			        "Groupe",       SELECTEDVALUE(P_Niveaux[Groupe]))
			VAR _FedSel     = IF(ISFILTERED(P_Federation), SELECTEDVALUE(P_Federation[CodeReference]))
			-- 3. Données : indépendantes de TOUS les segments (dernière année disponible)
			VAR _AnneeMax = CALCULATE(MAX(F_Licences[Annee]), REMOVEFILTERS())
			VAR _Base =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            ALL(T_Federation[CodeReference], T_Federation[Federation], T_Federation[Nom court], T_Federation[Logo],
			                T_Federation[Famille de fédérations], T_Federation[Sous-famille de fédérations], T_Federation[Groupe de fédérations]),
			            "@Cat",
			                VAR _c = SWITCH(_Niveau,
			                            "Famille",      T_Federation[Famille de fédérations],
			                            "Sous-famille", T_Federation[Sous-famille de fédérations],
			                            T_Federation[Groupe de fédérations])
			                RETURN IF(ISBLANK(_c) || _c = "", _LibelleNonClasse, _c),
			            "@Lic",    CALCULATE(SUM(F_Licences[NbLicences]), F_Licences[Annee] = _AnneeMax) + 0,
			            "@LicN1",  CALCULATE(SUM(F_Licences[NbLicences]), F_Licences[Annee] = _AnneeMax - 1),
			            "@LicRef", CALCULATE(SUM(F_Licences[NbLicences]), F_Licences[Annee] = _AnneeComparaison),
			            "@Enf",    CALCULATE(SUM(F_Licences[NbLicences]), F_Licences[Annee] = _AnneeMax, F_Licences[GrandeTrancheAge] = _TrancheEnfants),
			            "@Fem",    CALCULATE(SUM(F_Licences[NbLicences]), F_Licences[Annee] = _AnneeMax, F_Licences[Sexe] = _CodeFemmes),
			            "@AgeNb",  CALCULATE(SUM(F_Licences[NbLicences]), F_Licences[Annee] = _AnneeMax, NOT ISBLANK(F_Licences[Age])),
			            "@AgeSom", CALCULATE(SUMX(F_Licences, F_Licences[Age] * F_Licences[NbLicences]), F_Licences[Annee] = _AnneeMax, NOT ISBLANK(F_Licences[Age]))
			        ),
			        REMOVEFILTERS()
			    )
			VAR _MaxFed = MAXX(_Base, [@Lic])
			VAR _Cats =
			    ADDCOLUMNS(
			        DISTINCT(SELECTCOLUMNS(_Base, "@Cat", [@Cat])),
			        "@Lic",    VAR _c = [@Cat] RETURN SUMX(FILTER(_Base, [@Cat] = _c), [@Lic]),
			        "@LicN1",  VAR _c = [@Cat] RETURN SUMX(FILTER(_Base, [@Cat] = _c), [@LicN1]),
			        "@LicRef", VAR _c = [@Cat] RETURN SUMX(FILTER(_Base, [@Cat] = _c), [@LicRef]),
			        "@Enf",    VAR _c = [@Cat] RETURN SUMX(FILTER(_Base, [@Cat] = _c), [@Enf]),
			        "@Fem",    VAR _c = [@Cat] RETURN SUMX(FILTER(_Base, [@Cat] = _c), [@Fem]),
			        "@AgeNb",  VAR _c = [@Cat] RETURN SUMX(FILTER(_Base, [@Cat] = _c), [@AgeNb]),
			        "@AgeSom", VAR _c = [@Cat] RETURN SUMX(FILTER(_Base, [@Cat] = _c), [@AgeSom]),
			        "@Nb",     VAR _c = [@Cat] RETURN COUNTROWS(FILTER(_Base, [@Cat] = _c)),
			        "@Sel",    IF([@Cat] = _RegroupSel, 1, 0)
			    )
			VAR _MaxCat = MAXX(_Cats, [@Lic])
			-- 4. Affichage (en-têtes avec infobulle de définition)
			VAR _Colonnes = "grid-template-columns:" & _LargeurNom & "px repeat(6, " & _LargeurCol & "px);"
			VAR _MinLarg  = _LargeurNom + 6 * _LargeurCol
			VAR _Entete =
			    "<div class='lg ent' style='" & _Colonnes & "'>" &
			    "<div class='nom' title='Cliquez sur un regroupement pour le replier ou le déplier'>" & _Niveau & " / Fédération</div>" &
			    "<div title='Nombre de licences en " & _AnneeMax & "'>Licences " & _AnneeMax & "</div>" &
			    "<div title='Évolution des licences entre " & (_AnneeMax - 1) & " et " & _AnneeMax & " (≈ : entre -1 % et +1 %)'>Évol. 1 an</div>" &
			    "<div title='Évolution des licences depuis " & _AnneeComparaison & ", avant Covid'>Évol. " & _AnneeComparaison & "</div>" &
			    "<div title='Âge exact moyen des licenciés, pondéré par le nombre de licences'>Âge moyen</div>" &
			    "<div title='Part des licences détenues par des enfants de 1 à 13 ans'>% enfants</div>" &
			    "<div title='Part des licences détenues par des femmes'>% femmes</div></div>"
			VAR _Lignes =
			    CONCATENATEX(
			        _Cats,
			        VAR _c      = [@Cat]
			        VAR _estSel = [@Sel] = 1
			        VAR _lic = [@Lic]
			        VAR _e1  = DIVIDE(_lic, [@LicN1]) - 1
			        VAR _er  = DIVIDE(_lic, [@LicRef]) - 1
			        VAR _Pill1 = IF(ISBLANK([@LicN1]), "–", "<span class='" & IF(_e1 > _SeuilNeutre, "up", IF(_e1 < -_SeuilNeutre, "dn", "eq")) & "'>" & IF(ABS(_e1) <= _SeuilNeutre, _FlecheNeutre, IF(_e1 > 0, _FlecheHaut, _FlecheBas)) & " " & FORMAT(_e1, _FormatEvol) & "</span>")
			        VAR _PillR = IF(ISBLANK([@LicRef]), "–", "<span class='" & IF(_er > _SeuilNeutre, "up", IF(_er < -_SeuilNeutre, "dn", "eq")) & "'>" & IF(ABS(_er) <= _SeuilNeutre, _FlecheNeutre, IF(_er > 0, _FlecheHaut, _FlecheBas)) & " " & FORMAT(_er, _FormatEvol) & "</span>")
			        VAR _Resume =
			            "<summary class='lg " & IF(_estSel, "csel", "cat") & "' style='" & _Colonnes & "'>" &
			            "<div class='nom'><span class='pm'></span>" & SUBSTITUTE(_c, "&", "&amp;") & " <span class='nb'>(" & [@Nb] & ")</span></div>" &
			            "<div>" & FORMAT(_lic, _FormatNombre) & "<div class='trk' style='width:" & (_LargeurCol - 20) & "px'><div class='barre' style='width:" & ROUND(DIVIDE(_lic, _MaxCat) * (_LargeurCol - 20), 0) & "px'></div></div></div>" &
			            "<div>" & _Pill1 & "</div><div>" & _PillR & "</div>" &
			            "<div>" & FORMAT(DIVIDE([@AgeSom], [@AgeNb]), _FormatAge) & "</div>" &
			            "<div>" & FORMAT(DIVIDE([@Enf], _lic), _FormatPct) & "</div>" &
			            "<div>" & FORMAT(DIVIDE([@Fem], _lic), _FormatPct) & "</div></summary>"
			        VAR _LignesFed =
			            CONCATENATEX(
			                FILTER(_Base, [@Cat] = _c),
			                VAR _f   = [@Lic]
			                VAR _fe1 = DIVIDE(_f, [@LicN1]) - 1
			                VAR _fer = DIVIDE(_f, [@LicRef]) - 1
			                VAR _fp1 = IF(ISBLANK([@LicN1]) || _f = 0, "–", "<span class='" & IF(_fe1 > _SeuilNeutre, "up", IF(_fe1 < -_SeuilNeutre, "dn", "eq")) & "'>" & IF(ABS(_fe1) <= _SeuilNeutre, _FlecheNeutre, IF(_fe1 > 0, _FlecheHaut, _FlecheBas)) & " " & FORMAT(_fe1, _FormatEvol) & "</span>")
			                VAR _fpr = IF(ISBLANK([@LicRef]) || _f = 0, "–", "<span class='" & IF(_fer > _SeuilNeutre, "up", IF(_fer < -_SeuilNeutre, "dn", "eq")) & "'>" & IF(ABS(_fer) <= _SeuilNeutre, _FlecheNeutre, IF(_fer > 0, _FlecheHaut, _FlecheBas)) & " " & FORMAT(_fer, _FormatEvol) & "</span>")
			                VAR _img = IF(ISBLANK([Logo]) || [Logo] = "", "<span class='logo'></span>", "<img class='logo' src='" & SUBSTITUTE([Logo], "'", "%27") & "'>")
			                RETURN
			                    "<div class='lg " & IF([CodeReference] = _FedSel, "fsel", "fed") & "' style='" & _Colonnes & "'>" &
			                    "<div class='nom' title='" & SUBSTITUTE(SUBSTITUTE([Federation], "&", "&amp;"), "'", "&#39;") & "'>" & _img & "<span style='min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap'>" & SUBSTITUTE([Nom court], "&", "&amp;") & "</span></div>" &
			                    "<div>" & IF(_f = 0, "–", FORMAT(_f, _FormatNombre)) & "<div class='trk' style='width:" & (_LargeurCol - 20) & "px'><div class='barre' style='width:" & ROUND(DIVIDE(_f, _MaxFed) * (_LargeurCol - 20), 0) & "px'></div></div></div>" &
			                    "<div>" & _fp1 & "</div><div>" & _fpr & "</div>" &
			                    "<div>" & IF(_f = 0, "–", FORMAT(DIVIDE([@AgeSom], [@AgeNb]), _FormatAge)) & "</div>" &
			                    "<div>" & IF(_f = 0, "–", FORMAT(DIVIDE([@Enf], _f), _FormatPct)) & "</div>" &
			                    "<div>" & IF(_f = 0, "–", FORMAT(DIVIDE([@Fem], _f), _FormatPct)) & "</div></div>",
			                "",
			                [@Lic], DESC
			            )
			        RETURN "<details" & IF(_OuvrirTout || _estSel, " open", "") & ">" & _Resume & _LignesFed & "</details>",
			        "",
			        [@Sel], DESC,
			        [@Lic], DESC
			    )
			-- 5. Total (figé en bas)
			VAR _T    = SUMX(_Base, [@Lic])
			VAR _TN1  = SUMX(_Base, [@LicN1])
			VAR _TRef = SUMX(_Base, [@LicRef])
			VAR _te1  = DIVIDE(_T, _TN1) - 1
			VAR _ter  = DIVIDE(_T, _TRef) - 1
			VAR _Total =
			    "<div class='lg tot' style='" & _Colonnes & "'>" &
			    "<div class='nom'>Ensemble des fédérations</div>" &
			    "<div>" & FORMAT(_T, _FormatNombre) & "</div>" &
			    "<div>" & IF(ABS(_te1) <= _SeuilNeutre, _FlecheNeutre, IF(_te1 > 0, _FlecheHaut, _FlecheBas)) & " " & FORMAT(_te1, _FormatEvol) & "</div>" &
			    "<div>" & IF(ABS(_ter) <= _SeuilNeutre, _FlecheNeutre, IF(_ter > 0, _FlecheHaut, _FlecheBas)) & " " & FORMAT(_ter, _FormatEvol) & "</div>" &
			    "<div>" & FORMAT(DIVIDE(SUMX(_Base, [@AgeSom]), SUMX(_Base, [@AgeNb])), _FormatAge) & "</div>" &
			    "<div>" & FORMAT(DIVIDE(SUMX(_Base, [@Enf]), _T), _FormatPct) & "</div>" &
			    "<div>" & FORMAT(DIVIDE(SUMX(_Base, [@Fem]), _T), _FormatPct) & "</div></div>"
			RETURN
			    "<style>" & _CSS & "</style>" &
			    "<div class='tb'><div style='min-width:" & _MinLarg & "px'>" &
			    _Entete & _Lignes & _Total &
			    "</div></div>"
		displayFolder: 2. Affichage
		lineageTag: b81be063-a1b9-4db0-b6dc-9724a9252bd2

	/// Année de référence (la plus récente de la sélection), en nombre.
	measure 'Annee Ref' = VALUE(MAX(T_Annee[Annee]))
		formatString: 0
		isHidden
		displayFolder: 4. Indicateurs\Outils
		lineageTag: 478237db-a6cc-4395-a1e9-487816d2f33d

	/// Licences de l'année précédant l'année de référence, mêmes filtres.
	measure 'Licences N-1' =
			VAR _A = [Annee Ref]
			RETURN CALCULATE([NB Licences], REMOVEFILTERS(T_Annee), T_Annee[Annee] = FORMAT(_A - 1, "0"))
		formatString: #,0
		displayFolder: 4. Indicateurs\Évolutions
		lineageTag: da1e206a-fcdb-4653-8f71-02e19441111e

	/// Licences en 2019 (année de comparaison avant crise sanitaire), mêmes filtres.
	measure 'Licences 2019' = CALCULATE([NB Licences], REMOVEFILTERS(T_Annee), T_Annee[Annee] = "2019")
		formatString: #,0
		displayFolder: 4. Indicateurs\Évolutions
		lineageTag: 5673c8ec-7ddc-4a39-a99e-9b6648c13a9a

	/// Évolution des licences par rapport à l'année précédente.
	measure 'Évol 1 an' =
			VAR _P = [Licences N-1]
			RETURN IF(NOT ISBLANK(_P), DIVIDE([NB Licences], _P) - 1)
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Indicateurs\Évolutions
		lineageTag: 08d802b4-c0bc-45c4-bfaf-7e469408e700

	/// Évolution des licences depuis 2019.
	measure 'Évol depuis 2019' =
			VAR _P = [Licences 2019]
			RETURN IF(NOT ISBLANK(_P), DIVIDE([NB Licences], _P) - 1)
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 4. Indicateurs\Évolutions
		lineageTag: d908aeb6-722f-41e2-ab7d-aa38215d5479

	/// Licences féminines (ignore le segment Sexe).
	measure 'Licences femmes' = CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe), T_Sexe[Sexe] = "F")
		formatString: #,0
		displayFolder: 4. Indicateurs\Publics
		lineageTag: c53ffdb6-6530-45b1-af26-e6510e929ed5

	/// Part des femmes parmi les licences (ignore le segment Sexe).
	measure 'Part femmes' = DIVIDE([Licences femmes], CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe)))
		formatString: 0.0 %
		displayFolder: 4. Indicateurs\Publics
		lineageTag: c91b9309-5cea-482b-86c6-7858c37a2d27

	/// Licences de toutes les fédérations (retire les filtres fédération, garde territoire, public et année).
	measure 'Licences ensemble' =
			CALCULATE(
			    [NB Licences],
			    REMOVEFILTERS(T_Federation), REMOVEFILTERS(P_Federation), REMOVEFILTERS(P_Niveaux),
			    REMOVEFILTERS(P_Appartenance), REMOVEFILTERS(Param_Federation)
			)
		formatString: #,0
		displayFolder: 4. Indicateurs\Comparaisons
		lineageTag: 3b80aad6-ab71-46b7-b41a-0223bc1a0b67

	/// Poids de la sélection dans l'ensemble des licences du même territoire.
	measure 'Part dans l''ensemble' = DIVIDE([NB Licences], [Licences ensemble])
		formatString: 0.0 %
		displayFolder: 4. Indicateurs\Comparaisons
		lineageTag: 0f625843-6e48-4c86-a405-46bdd1dd77c4

	/// Poids de la sélection dans le territoire divisé par son poids en France entière. 1 = même poids qu'en France ; 1,45 = 45 % de plus.
	measure 'Indice de spécificité' =
			DIVIDE(
			    [Part dans l'ensemble],
			    CALCULATE(
			        [Part dans l'ensemble],
			        REMOVEFILTERS(T_Territoire), REMOVEFILTERS(P_TerrChoix), REMOVEFILTERS(P_TerrAppartenance),
			        REMOVEFILTERS(P_TerrDep), REMOVEFILTERS(Param_Departement)
			    )
			)
		formatString: 0.00
		displayFolder: 4. Indicateurs\Comparaisons
		lineageTag: 6b5b133d-1081-4de8-82d6-781e2960f5d2

	/// Nom du niveau de regroupement choisi dans le segment Niveau (Sous-famille par défaut).
	measure 'Niveau choisi' = SWITCH(SELECTEDVALUE(Param_Niveau[Paramètre Commande], 1), 0, "Famille", 1, "Sous-famille", 2, "Groupe")
		isHidden
		displayFolder: 4. Indicateurs\Outils
		lineageTag: 8a4ecf4c-076a-44de-ad87-14edb7e1195c

	/// Nom du regroupement de la sélection au niveau choisi (vide si la sélection couvre plusieurs regroupements).
	measure 'Nom regroupement' =
			IF(
			    ISCROSSFILTERED(T_Federation),
			    SWITCH(
			        SELECTEDVALUE(Param_Niveau[Paramètre Commande], 1),
			        0, SELECTEDVALUE(T_Federation[Famille de fédérations]),
			        1, TRIM(SELECTEDVALUE(T_Federation[Sous-famille de fédérations])),
			        2, SELECTEDVALUE(T_Federation[Groupe de fédérations])
			    )
			)
		displayFolder: 4. Indicateurs\Outils
		lineageTag: b6057f40-4c7d-41d6-8c9b-8fc97070f241

	/// Licences de chaque fédération de T_FedNuage, indépendamment des segments fédération (garde territoire, public, année).
	measure 'Nuage Licences' =
			CALCULATE(
			    [NB Licences],
			    REMOVEFILTERS(T_Federation), REMOVEFILTERS(P_Federation), REMOVEFILTERS(P_Niveaux), REMOVEFILTERS(P_Appartenance), REMOVEFILTERS(Param_Federation),
			    TREATAS(VALUES(T_FedNuage[CodeReference]), T_Federation[CodeReference])
			)
		formatString: #,0
		displayFolder: 5. Nuage (page Comparer)
		lineageTag: a4003af6-e745-4635-b1ea-dd10e4738c12

	/// Évolution depuis 2019 de chaque fédération de T_FedNuage (axe X du nuage).
	measure 'Nuage Évol depuis 2019' =
			CALCULATE(
			    [Évol depuis 2019],
			    REMOVEFILTERS(T_Federation), REMOVEFILTERS(P_Federation), REMOVEFILTERS(P_Niveaux), REMOVEFILTERS(P_Appartenance), REMOVEFILTERS(Param_Federation),
			    TREATAS(VALUES(T_FedNuage[CodeReference]), T_Federation[CodeReference])
			)
		formatString: +0.0 %;-0.0 %;0.0 %
		displayFolder: 5. Nuage (page Comparer)
		lineageTag: 7b3c6548-4f08-4ee4-8e9b-4f5a3f15f6df

	/// Part de femmes de chaque fédération de T_FedNuage (axe Y du nuage).
	measure 'Nuage Part femmes' =
			CALCULATE(
			    [Part femmes],
			    REMOVEFILTERS(T_Federation), REMOVEFILTERS(P_Federation), REMOVEFILTERS(P_Niveaux), REMOVEFILTERS(P_Appartenance), REMOVEFILTERS(Param_Federation),
			    TREATAS(VALUES(T_FedNuage[CodeReference]), T_Federation[CodeReference])
			)
		formatString: 0.0 %
		displayFolder: 5. Nuage (page Comparer)
		lineageTag: 557e5c55-41e4-4f3d-bf89-da840e27a302

	/// Couleur du point : orange si la fédération fait partie de la sélection des segments, bleu clair sinon (mise en forme conditionnelle).
	measure 'Nuage Couleur' =
			VAR _Code = SELECTEDVALUE(T_FedNuage[CodeReference])
			RETURN IF(ISCROSSFILTERED(T_Federation) && _Code IN VALUES(T_Federation[CodeReference]), [Style Couleur regroupement], [Style Couleur sélection clair])
		displayFolder: 5. Nuage (page Comparer)
		lineageTag: fba7419d-2c98-470a-a5b4-43d3993793a0

	/// Filtre visuel du nuage (est 1) : garde les fédérations de plus de 20 000 licences, plus celles de la sélection.
	measure 'Nuage Filtre' =
			VAR _Code = SELECTEDVALUE(T_FedNuage[CodeReference])
			VAR _Sel = ISCROSSFILTERED(T_Federation) && _Code IN VALUES(T_Federation[CodeReference])
			RETURN IF(NOT ISBLANK([Nuage Évol depuis 2019]) && ([Nuage Licences] >= 20000 || _Sel), 1)
		formatString: 0
		displayFolder: 5. Nuage (page Comparer)
		lineageTag: 097560c6-6b1b-47fc-a06b-c7af04080b58

	/// Nom du territoire sélectionné (France entière, zone, région ou département).
	measure 'Libellé territoire' =
			-- Segment Territoire (Param_Departement ou P_TerrChoix) et segment Département (valeurs du champ Param_Departement → P_TerrDep)
			VAR _DepChoisi = ISFILTERED(P_TerrDep)
			VAR _NbDep     = COUNTROWS(VALUES(T_Territoire[Code_DEP]))
			VAR _NbTot     = COUNTROWS(ALLNOBLANKROW(T_Territoire[Code_DEP]))
			VAR _Choix     = IF(ISCROSSFILTERED(P_TerrChoix), SELECTEDVALUE(P_TerrChoix[Libellé]))
			VAR _Dep       = SELECTEDVALUE(T_Territoire[Departement])
			RETURN
			    SWITCH(TRUE(),
			        _DepChoisi && _NbDep = 1, TRIM(MID(_Dep, SEARCH(" - ", _Dep, 1, 0) + 3, 100)),
			        _DepChoisi, "Plusieurs départements",
			        NOT ISBLANK(_Choix) && SELECTEDVALUE(P_TerrChoix[Id territoire]) = "TOT", "Tous territoires",
			        NOT ISBLANK(_Choix), _Choix,
			        NOT ISCROSSFILTERED(T_Territoire) || _NbDep >= _NbTot, "Tous territoires",
			        _NbDep = 1, TRIM(MID(_Dep, SEARCH(" - ", _Dep, 1, 0) + 3, 100)),
			        HASONEVALUE(T_Territoire[Zone_Slicer]), SELECTEDVALUE(T_Territoire[Zone_Slicer]),
			        HASONEVALUE(T_Territoire[GD_Zone_Slicer]), SELECTEDVALUE(T_Territoire[GD_Zone_Slicer]),
			        "Plusieurs territoires")
		isHidden
		displayFolder: 4. Indicateurs\Outils
		lineageTag: b75cd7e6-6681-462b-937d-7bb1a2ca3eca

	/// En-tête de la page Portrait (visuel HTML Content) : logo et nom de la fédération choisie, puis ses étiquettes Famille / Sous-famille / Groupe. Sans fédération unique : le regroupement choisi ou « Toutes les fédérations ». Les filtres (territoire, public, année) sont dans HTML Filtres actifs.
	measure 'HTML Titre' =
			-- =====================================================================
			-- HTML Titre | haut des pages Détails / Comparaison | visuel HTML Content ~1544 x 66
			-- Une seule ligne : logo, nom de la sélection, rattachement ou nombre de fédérations.
			-- Même logique et mêmes libellés que HTML En-tête (page Portrait).
			-- Hauteur bloquée (100vh + overflow:hidden) : jamais de barre de défilement.
			-- =====================================================================
			-- 1. Réglages
			VAR _TailleLogo = 56
			VAR _MargeLogo  = 6
			-- 2. Charte
			VAR _ColTxt  = [Style Couleur texte]
			VAR _ColLib  = [Style Couleur texte libellé]
			VAR _ColBord = [Style Couleur bordure]
			VAR _ColFond = [Style Couleur fond cadre]
			-- 3. Contexte
			VAR _Mode    = [Sélection mode]
			VAR _UneFed  = _Mode = "Fédération"
			VAR _Logo    = IF(_UneFed, SELECTEDVALUE(T_Federation[Logo]))
			VAR _NomLong = IF(_UneFed, SELECTEDVALUE(T_Federation[Federation]), [Sélection libellé])
			VAR _AnRef   = MAX(T_Annee[Annee])
			VAR _NbFed   = [Sélection nb fédérations]
			-- 4. Gabarits
			VAR _Gras     = "<b style='color:" & _ColTxt & ";font-weight:600'>"
			VAR _Pastille = "<span style='flex:none;display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 11px;border-radius:13px;background:#FFFFFF;border:1px solid " & _ColBord & ";font-size:13px;color:" & _ColLib & ";white-space:nowrap'>"
			VAR _IcoToutes = "<svg width='30' height='30' viewBox='0 0 24 24' fill='none' stroke='" & [Style Couleur icône] & "' stroke-width='1.8'><rect x='4' y='4' width='7' height='7' rx='1.5'/><rect x='13' y='4' width='7' height='7' rx='1.5'/><rect x='4' y='13' width='7' height='7' rx='1.5'/><rect x='13' y='13' width='7' height='7' rx='1.5'/></svg>"
			VAR _Visuel =
			    IF(NOT ISBLANK(_Logo) && _Logo <> "",
			        "<img src='" & SUBSTITUTE(_Logo, "'", "%27") & "' style='max-width:" & (_TailleLogo - 2 * _MargeLogo) & "px;max-height:" & (_TailleLogo - 2 * _MargeLogo) & "px;object-fit:contain'/>",
			        _IcoToutes)
			VAR _Rattachement =
			    SWITCH(_Mode,
			        "Fédération",
			            _Pastille & "Famille " & _Gras & SELECTEDVALUE(T_Federation[Famille de fédérations]) & "</b></span>"
			            & _Pastille & "Sous-famille " & _Gras & TRIM(SELECTEDVALUE(T_Federation[Sous-famille de fédérations])) & "</b></span>"
			            & _Pastille & "Groupe " & _Gras & SELECTEDVALUE(T_Federation[Groupe de fédérations]) & "</b></span>",
			        "Ensemble",
			            _Pastille & _Gras & _NbFed & "</b> fédérations agréées en " & _AnRef & "</span>",
			        _Pastille & _Gras & _NbFed & "</b> fédération" & IF(_NbFed > 1, "s") & "</span>")
			-- 5. Assemblage (nom complet en infobulle native : rien ne déborde du visuel)
			RETURN
			    [Style CSS commun]
			    & "<div style='font-family:" & [Style Police] & ";display:flex;align-items:center;gap:16px;height:100vh;overflow:hidden'>"
			    & "<div style='width:" & _TailleLogo & "px;height:" & _TailleLogo & "px;flex:none;border-radius:14px;background:" & _ColFond & ";border:1px solid " & _ColBord & ";display:flex;align-items:center;justify-content:center'>" & _Visuel & "</div>"
			    & "<span class='el' title='" & SUBSTITUTE(SUBSTITUTE(_NomLong, "&", "&amp;"), "'", "&#39;") & "' style='font-size:24px;font-weight:700;color:" & _ColTxt & ";letter-spacing:-.01em'>" & SUBSTITUTE(_NomLong, "&", "&amp;") & "</span>"
			    & "<div style='display:flex;gap:8px;flex:none'>" & _Rattachement & "</div>"
			    & "</div>"
		displayFolder: 2. Affichage
		lineageTag: e51f50f3-071c-41a7-88eb-57001e95ae57

	/// Licences de l'année de l'axe (T_AnneeAxe). Ignore le segment Année pour que le graphique montre toujours toute la période.
	measure 'Evo Licences' =
			CALCULATE(
			    [NB Licences],
			    REMOVEFILTERS(T_Annee),
			    TREATAS(VALUES(T_AnneeAxe[Annee]), T_Annee[Annee])
			)
		formatString: #,0
		displayFolder: 6. Portrait\Évolution
		lineageTag: 6c282a2b-f7c0-479a-b958-34f451b1b8e2

	/// Base 100 = première année disponible, sur l'axe T_AnneeAxe.
	measure 'Evo Indice' =
			VAR _A0 = CALCULATE(MIN(T_Annee[Annee]), REMOVEFILTERS(T_Annee))
			RETURN
			    DIVIDE(
			        [Evo Licences],
			        CALCULATE([NB Licences], REMOVEFILTERS(T_Annee), T_Annee[Annee] = _A0)
			    ) * 100
		formatString: 0.0
		isHidden
		displayFolder: 6. Portrait\Évolution
		lineageTag: 6aad76c0-d7db-4d80-8c82-3b2aebaf1535

	/// Ligne 1 du graphique Base 100.
	measure 'Evo Indice sélection' = CALCULATE([Evo Indice], Comparaison[Comparaison] = "Sélection")
		formatString: 0.0
		displayFolder: 6. Portrait\Évolution
		lineageTag: cafb8414-c439-45a7-849f-9f5cad3b678b

	/// Ligne 2 du graphique Base 100 : regroupement de la sélection au niveau choisi.
	measure 'Evo Indice regroupement' = CALCULATE([Evo Indice], Comparaison[Comparaison] = "Regroupement")
		formatString: 0.0
		displayFolder: 6. Portrait\Évolution
		lineageTag: cc97025c-81aa-4a07-ba35-97fc585a1900

	/// Ligne 3 du graphique Base 100 : toutes les fédérations.
	measure 'Evo Indice ensemble' = CALCULATE([Evo Indice], Comparaison[Comparaison] = "Ensemble")
		formatString: 0.0
		displayFolder: 6. Portrait\Évolution
		lineageTag: 9090f2f0-9a1b-4200-b8a4-fe7d4403956c

	/// Valeur de l'indicateur pour la zone dessinée (Id carte) : ignore les segments territoire et applique les départements de la zone (T_CarteZoneDep, codes). Seul TREATAS de la carte.
	measure 'Carte Valeur' =
			VAR _Ind  = SELECTEDVALUE(T_CarteIndicateur[Ordre], 1)
			-- départements (codes) de la zone dessinée
			VAR _Ids  = VALUES(T_CarteAffichage[Id carte])
			VAR _Deps = SELECTCOLUMNS(FILTER(T_CarteZoneDep, T_CarteZoneDep[Id carte] IN _Ids), "Code_DEP", T_CarteZoneDep[Code_DEP])
			RETURN
			    CALCULATE(
			        SWITCH(_Ind,
			            1, [NB Licences],
			            2, [Évol 1 an],
			            3, [Évol depuis 2019],
			            4, [Part femmes],
			            5, [Indice de spécificité]
			        ),
			        REMOVEFILTERS(T_Territoire), REMOVEFILTERS(P_TerrChoix), REMOVEFILTERS(P_TerrAppartenance),
			        REMOVEFILTERS(P_TerrDep), REMOVEFILTERS(Param_Departement),
			        TREATAS(_Deps, T_Territoire[Code_DEP])
			    )
		displayFolder: 6. Portrait\Carte
		lineageTag: 8ca56dc4-be06-48da-b081-785fbfbcf0a7

		formatStringDefinition = SWITCH(SELECTEDVALUE(T_CarteIndicateur[Ordre], 1), 1, "#,0", 4, "0.0 %", 5, "0.00", "+0.0 %;-0.0 %;0.0 %")

	/// 1 si la zone est dessinée (filtre du visuel Azure Maps : Carte Visible = 1). Zones données par T_CarteAffichage (territoire × niveau) ; sans territoire choisi, celles de TOT.
	measure 'Carte Visible' =
			-- Territoire choisi : segment sur Param_Departement (ou P_TerrChoix), d'où ISCROSSFILTERED
			VAR _Niv = [Carte Niveau]
			VAR _NbLignes =
			    IF(ISCROSSFILTERED(P_TerrChoix),
			        CALCULATE(COUNTROWS(T_CarteAffichage), T_CarteAffichage[Niveau affiché] = _Niv),
			        CALCULATE(COUNTROWS(T_CarteAffichage), T_CarteAffichage[Niveau affiché] = _Niv, T_CarteAffichage[Id territoire] = "TOT"))
			RETURN IF(_NbLignes > 0, 1)
		formatString: 0
		displayFolder: 6. Portrait\Carte
		lineageTag: 68700e5c-8968-4fa6-a75c-a590eea7da8b

	/// Plus petite valeur de l'indicateur parmi les zones dessinées au niveau courant.
	measure 'Carte Min' =
			VAR _Pref = IF([Carte Niveau] = 1, "R", "D")
			RETURN
			    CALCULATE(
			        MINX(FILTER(VALUES(T_CarteAffichage[Id carte]), LEFT(T_CarteAffichage[Id carte], 1) = _Pref && [Carte Visible] = 1), [Carte Valeur]),
			        REMOVEFILTERS(T_CarteAffichage[Id carte], T_CarteAffichage[Latitude], T_CarteAffichage[Longitude], T_CarteAffichage[Rôle])
			    )
		isHidden
		displayFolder: 6. Portrait\Carte
		lineageTag: dc3590cd-ce49-4d9c-b625-59ad19b73073

	/// Plus grande valeur de l'indicateur parmi les zones dessinées au niveau courant.
	measure 'Carte Max' =
			VAR _Pref = IF([Carte Niveau] = 1, "R", "D")
			RETURN
			    CALCULATE(
			        MAXX(FILTER(VALUES(T_CarteAffichage[Id carte]), LEFT(T_CarteAffichage[Id carte], 1) = _Pref && [Carte Visible] = 1), [Carte Valeur]),
			        REMOVEFILTERS(T_CarteAffichage[Id carte], T_CarteAffichage[Latitude], T_CarteAffichage[Longitude], T_CarteAffichage[Rôle])
			    )
		isHidden
		displayFolder: 6. Portrait\Carte
		lineageTag: 700dfcc2-7c34-41fb-af51-ed50ec573832

	/// RÉGLAGES DES COULEURS DE LA CARTE (lus par Carte Couleur et HTML Carte). Renvoie « début|milieu|fin » (codes #RRGGBB). Palette continue pour volumes et parts, divergente pour évolutions et indice de spécificité.
	measure 'Carte Palette' =
			-- =====================================================================
			-- Carte Palette : 3 couleurs « début|milieu|fin » (codes #RRGGBB à 7 caractères)
			-- =====================================================================
			-- 1. Réglages : palette continue (volumes, parts), indigo soutenu dès le début
			VAR _Debut  = "#B4C2F8"
			VAR _Milieu = "#6580EA"
			VAR _Fin    = [Style Couleur icône]
			-- 2. Réglages : palette divergente (évolutions, indice de spécificité)
			VAR _Baisse = "#E5484D"
			VAR _Neutre = "#DDE2EA"
			VAR _Hausse = "#12A150"
			-- 3. Choix selon l'indicateur
			VAR _Ind = SELECTEDVALUE(T_CarteIndicateur[Ordre], 1)
			RETURN IF(_Ind IN {2, 3, 5}, _Baisse & "|" & _Neutre & "|" & _Hausse, _Debut & "|" & _Milieu & "|" & _Fin)
		isHidden
		displayFolder: 6. Portrait\Carte
		lineageTag: 493c2166-c690-48c5-9886-923aa8783bcd

	/// Couleur de remplissage d'une zone (Azure Maps, fx valeur de champ) : dégradé de Carte Palette ; pour les volumes et parts, l'échelle mélange la valeur (30 %) et le rang parmi les zones affichées (70 %) afin de bien distinguer les territoires malgré les valeurs extrêmes ; échelle linéaire centrée pour les évolutions et l'indice ; couleur « sans donnée » si la valeur est absente (ou 0 licence) ; transparent pour une zone en rôle Contour.
	measure 'Carte Couleur' =
			-- =====================================================================
			-- Carte Couleur : couleur #RRGGBB d'une zone de la carte
			-- =====================================================================
			-- 1. Réglages
			VAR _ContourSeul = "rgba(0,0,0,0)"            -- zone dont on ne montre que le contour
			VAR _SansDonnee  = [Style Couleur sans donnée] -- pas de licence ou calcul impossible
			VAR _PartRang    = 0.7                          -- poids du rang (0 = valeur seule, 1 = rang seul) pour volumes et parts
			-- 2. Valeur et bornes
			VAR _Ind    = SELECTEDVALUE(T_CarteIndicateur[Ordre], 1)
			VAR _Diverg = _Ind IN {2, 3, 5}
			VAR _Centre = IF(_Ind = 5, 1, 0)
			VAR _V      = [Carte Valeur]
			VAR _Vide   = ISBLANK(_V) || (_Ind = 1 && _V = 0)
			VAR _Lo     = [Carte Min]
			VAR _Hi     = [Carte Max]
			VAR _Amp    = MAX(ABS(_Hi - _Centre), ABS(_Lo - _Centre))
			-- 2b. Rang de la zone parmi les zones affichées (volumes et parts seulement)
			VAR _Pref  = IF([Carte Niveau] = 1, "R", "D")
			VAR _Zones =
			    CALCULATETABLE(
			        FILTER(VALUES(T_CarteAffichage[Id carte]), LEFT(T_CarteAffichage[Id carte], 1) = _Pref && [Carte Visible] = 1),
			        REMOVEFILTERS(T_CarteAffichage[Id carte], T_CarteAffichage[Latitude], T_CarteAffichage[Longitude], T_CarteAffichage[Rôle])
			    )
			VAR _NbZones = COUNTROWS(_Zones)
			VAR _Rang    = IF(_Diverg || _Vide, 0, COUNTROWS(FILTER(_Zones, [Carte Valeur] < _V)))
			VAR _TRang   = DIVIDE(_Rang, _NbZones - 1, 0.5)
			VAR _TLin    = DIVIDE(_V - _Lo, _Hi - _Lo, 0.5)
			VAR _T0      = IF(_Diverg, 0.5 + DIVIDE(_V - _Centre, 2 * _Amp, 0), _PartRang * _TRang + (1 - _PartRang) * _TLin)
			VAR _T       = MAX(0, MIN(1, _T0))
			-- 3. Interpolation entre deux couleurs de la palette
			VAR _Pal = [Carte Palette]
			VAR _C1  = LEFT(_Pal, 7)
			VAR _C2  = MID(_Pal, 9, 7)
			VAR _C3  = RIGHT(_Pal, 7)
			VAR _CA  = IF(_T <= 0.5, _C1, _C2)
			VAR _CB  = IF(_T <= 0.5, _C2, _C3)
			VAR _U   = IF(_T <= 0.5, _T / 0.5, (_T - 0.5) / 0.5)
			VAR _Hex = "0123456789ABCDEF"
			VAR _Degrade =
			    "#" & CONCATENATEX(
			        GENERATESERIES(0, 2),
			        VAR _P = 2 + 2 * [Value]
			        VAR _A = (SEARCH(MID(_CA, _P, 1), _Hex) - 1) * 16 + SEARCH(MID(_CA, _P + 1, 1), _Hex) - 1
			        VAR _B = (SEARCH(MID(_CB, _P, 1), _Hex) - 1) * 16 + SEARCH(MID(_CB, _P + 1, 1), _Hex) - 1
			        VAR _X = ROUND(_A + (_B - _A) * _U, 0)
			        RETURN MID(_Hex, INT(_X / 16) + 1, 1) & MID(_Hex, MOD(_X, 16) + 1, 1),
			        "", [Value], ASC)
			-- 4. Résultat
			RETURN
			    SWITCH(TRUE(),
			        [Carte Rôle] = "Contour", _ContourSeul,
			        NOT HASONEVALUE(T_CarteAffichage[Id carte]), BLANK(),
			        _Vide, _SansDonnee,
			        _Degrade)
		displayFolder: 6. Portrait\Carte
		lineageTag: 97e71a85-d9b8-4a66-b6d4-4f76b56fb4c2

	/// Légende de la carte (visuel HTML Content) : nom de l'indicateur, barre de dégradé (couleurs de Carte Palette), minimum et maximum des zones affichées, territoire choisi.
	measure 'HTML Légende carte' =
			-- Réglages
			VAR _Police      = [Style Police]
			VAR _CouleurTexte = [Style Couleur texte]
			VAR _CouleurSecondaire = [Style Couleur texte secondaire]
			VAR _CouleurSelection  = [Style Couleur marine]   -- même couleur que Carte Contour couleur
			-- Données
			VAR _Ind    = SELECTEDVALUE(T_CarteIndicateur[Ordre], 1)
			VAR _Nom    = SELECTEDVALUE(T_CarteIndicateur[Indicateur], "Licences")
			VAR _Diverg = _Ind IN {2, 3, 5}
			VAR _Centre = IF(_Ind = 5, 1, 0)
			VAR _Fmt    = SWITCH(_Ind, 1, "#,0", 4, "0.0 %", 5, "0.00", "+0.0 %;-0.0 %;0.0 %")
			VAR _Lo     = [Carte Min]
			VAR _Hi     = [Carte Max]
			VAR _Amp    = MAX(ABS(_Hi - _Centre), ABS(_Lo - _Centre))
			VAR _Pal    = [Carte Palette]
			VAR _C1     = LEFT(_Pal, 7)
			VAR _C2     = MID(_Pal, 9, 7)
			VAR _C3     = RIGHT(_Pal, 7)
			VAR _Niv    = [Carte Niveau]
			VAR _Force  = ISFILTERED(P_TerrDep) && SELECTEDVALUE(T_NiveauGeo[Ordre], 1) = 1
			VAR _Annee  = MAX(T_Annee[Annee])
			VAR _Titre  = _Nom & IF(_Ind IN {1, 4, 5}, " " & _Annee, " (" & _Annee & ")") & " · " & IF(_Niv = 1, "par région", "par département" & IF(_Force, " (département choisi)"))
			VAR _Terr   = [Libellé territoire]
			VAR _L1     = IF(_Diverg, FORMAT(_Centre - _Amp, _Fmt), FORMAT(_Lo, _Fmt))
			VAR _L2     = IF(_Diverg, "<span>" & FORMAT(_Centre, _Fmt) & "</span>", "")
			VAR _L3     = IF(_Diverg, FORMAT(_Centre + _Amp, _Fmt), FORMAT(_Hi, _Fmt))
			VAR _Choix  =
			    IF(_Terr <> "Tous territoires",
			        "<div style='margin-top:10px;font-size:12px;color:" & _CouleurSecondaire & ";display:flex;align-items:center;gap:7px'><i style='flex:none;display:inline-block;width:14px;height:10px;border:2.5px solid " & _CouleurSelection & ";border-radius:2px'></i><span>Territoire choisi : <b style='color:" & _CouleurTexte & "'>" & _Terr & "</b></span></div>")
			-- carte affichée ? (aucune zone pour DROM, COM, Autres)
			VAR _SurCarte = NOT ISEMPTY(FILTER(ALL(T_CarteAffichage[Id carte]), [Carte Visible] = 1))
			RETURN
			    IF(NOT _SurCarte,
			        "<div style='font-family:" & _Police & ";font-size:13px;color:" & _CouleurSecondaire & ";line-height:1.5'><b style='color:" & [Style Couleur filtre actif texte] & "'>Territoire hors carte</b><br>La carte couvre la métropole. Les chiffres de la page portent sur : <b style='color:" & _CouleurTexte & "'>" & _Terr & "</b></div>",
			    IF(NOT ISBLANK(_Hi),
			        "<div style='font-family:" & _Police & ";color:" & _CouleurTexte & "'>"
			        & "<div style='font-size:12.5px;font-weight:600;margin-bottom:7px'>" & _Titre & "</div>"
			        & "<div style='height:12px;border-radius:6px;background:linear-gradient(90deg," & _C1 & "," & _C2 & "," & _C3 & ")'></div>"
			        & "<div style='display:flex;justify-content:space-between;font-size:12px;color:" & _CouleurSecondaire & ";margin-top:5px'><span>" & _L1 & "</span>" & _L2 & "<span>" & _L3 & "</span></div>"
			        & IF(_Diverg, "<div style='display:flex;justify-content:space-between;font-size:11px;color:" & _CouleurSecondaire & "'><span>" & IF(_Ind = 5, "moins représenté", "baisse") & "</span><span>" & IF(_Ind = 5, "plus représenté", "hausse") & "</span></div>")
			        & _Choix
			        & "</div>"
			    ))
		displayFolder: 6. Portrait\Carte
		lineageTag: 41baf7ed-af56-41d4-b8a6-f1e640d5df8b

	/// Chiffres clés de la page Portrait (visuel HTML Content, ~1500 x 205) : 4 cartes. Licences (+ logo de la fédération) ; évolution sur 1 an ; évolution depuis 2019 ; poids. Libellés longs tronqués avec « … » et texte complet au survol ; chiffres jamais coupés ; infobulles de lecture.
	measure 'HTML Chiffres clés' =
			-- =====================================================================
			-- HTML Chiffres clés | page Portrait | visuel HTML Content ~1558 x 205
			-- 4 cartes : Licences / Évolution 1 an / Évolution depuis 2019 / Poids
			-- Mise en page FIXE : chaque carte garde les mêmes lignes quels que soient les segments
			-- (une valeur sans objet s'affiche « – » en gris, avec la raison au survol).
			-- Dépend de : Sélection mode, Sélection libellé, Évol 1 an, Évol depuis 2019,
			--             Licences ensemble, charte (dossier 0. Style)
			-- =====================================================================
			-- 1. Réglages
			VAR _Colonnes        = "1fr 1fr 1fr 1.15fr"   -- largeur relative des 4 cartes
			VAR _AnneeAvantCovid = 2019
			VAR _FmtEvol         = "+0.0 %;-0.0 %;0.0 %"
			VAR _FmtEcart        = "+#,0;-#,0;0"
			VAR _TexteHerosClair = "#B7C9F0"
			-- 2. Charte
			VAR _Police  = [Style Police]
			VAR _ColTxt  = [Style Couleur texte]
			VAR _ColFort = [Style Couleur texte fort]
			VAR _ColLib  = [Style Couleur texte libellé]
			VAR _ColNeut = [Style Couleur neutre]
			VAR _ColGril = [Style Couleur grille]
			VAR _ColVide = [Style Couleur bordure forte]
			VAR _TxtTxt  = [Style Taille texte]
			VAR _TxtPet  = [Style Taille petit]
			VAR _TxtChif = [Style Taille chiffre]
			-- 3. Contexte (sélection)
			VAR _Mode    = [Sélection mode]
			VAR _UneFed  = _Mode = "Fédération"
			VAR _AvecReg = _Mode IN {"Fédération", "Plusieurs fédérations"} && NOT ISBLANK([Nom regroupement])
			VAR _NomSel  = [Sélection libellé]
			VAR _ModeReg = _Mode = "Regroupement"      -- regroupement entier sélectionné : il occupe la ligne « regroupement » (orange)
			VAR _NomReg  = IF(_AvecReg, [Niveau choisi] & " · " & [Nom regroupement], IF(_ModeReg, [Niveau choisi] & " · " & _NomSel, "Regroupement"))
			VAR _PourquoiPasReg =
			    SWITCH(_Mode,
			        "Ensemble",     "Aucun regroupement : choisissez une fédération ou un regroupement.",
			        "Regroupement", "La sélection est déjà un regroupement.",
			        "Les fédérations choisies n'appartiennent pas au même regroupement.")
			VAR _AnRef   = VALUE(MAX(T_Annee[Annee]))
			VAR _Logo    = IF(_UneFed, SELECTEDVALUE(T_Federation[Logo]))
			-- 4. Données
			VAR _Lic     = [NB Licences]
			VAR _LicN1   = [Licences N-1]
			VAR _Lic19   = [Licences 2019]
			VAR _E1      = [Évol 1 an]
			VAR _E19     = IF(_AnRef > _AnneeAvantCovid, [Évol depuis 2019])
			VAR _E1Reg   = IF(_AvecReg, CALCULATE([Évol 1 an], Comparaison[Comparaison] = "Regroupement"), IF(_ModeReg, _E1))
			VAR _E19Reg  = IF(_AvecReg && _AnRef > _AnneeAvantCovid, CALCULATE([Évol depuis 2019], Comparaison[Comparaison] = "Regroupement"), IF(_ModeReg, _E19))
			VAR _E1Ens   = CALCULATE([Évol 1 an], Comparaison[Comparaison] = "Ensemble")
			VAR _E19Ens  = IF(_AnRef > _AnneeAvantCovid, CALCULATE([Évol depuis 2019], Comparaison[Comparaison] = "Ensemble"))
			VAR _LicEns  = [Licences ensemble]
			VAR _Groupe  = IF(_UneFed, SELECTEDVALUE(T_Federation[Groupe de fédérations]))
			VAR _Famille = IF(_UneFed, SELECTEDVALUE(T_Federation[Famille de fédérations]))
			VAR _LicGroupe = IF(_UneFed, CALCULATE([NB Licences], REMOVEFILTERS(T_Federation), REMOVEFILTERS(P_Federation), REMOVEFILTERS(P_Niveaux), REMOVEFILTERS(P_Appartenance), REMOVEFILTERS(Param_Federation), T_Federation[Groupe de fédérations] = _Groupe))
			VAR _LicFam    = IF(_UneFed, CALCULATE([NB Licences], REMOVEFILTERS(T_Federation), REMOVEFILTERS(P_Federation), REMOVEFILTERS(P_Niveaux), REMOVEFILTERS(P_Appartenance), REMOVEFILTERS(Param_Federation), T_Federation[Famille de fédérations] = _Famille))
			VAR _Ecart1  = IF(NOT ISBLANK(_LicN1), _Lic - _LicN1)
			VAR _Ecart19 = IF(_AnRef > _AnneeAvantCovid && NOT ISBLANK(_Lic19), _Lic - _Lic19)
			-- 5. Icônes (CC = couleur du trait, PP = tracé de la flèche)
			VAR _Svg     = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='CC' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'>"
			VAR _IcoLic  = _Svg & "<circle cx='9' cy='8' r='3.2'/><path d='M3 20c.7-3.4 3-5.2 6-5.2s5.3 1.8 6 5.2'/><circle cx='17' cy='9' r='2.4'/><path d='M16.5 14.6c2.3.2 4 1.8 4.5 4.4'/></svg>"
			VAR _IcoE1   = _Svg & "<path d='M4 17l6-6 4 4 6-7'/><path d='M14 8h6v6'/></svg>"
			VAR _IcoE19  = _Svg & "<path d='M3 12a9 9 0 1 0 3-6.7'/><path d='M3 4v5h5'/><path d='M12 8v4l3 2'/></svg>"
			VAR _IcoPds  = _Svg & "<path d='M12 3a9 9 0 1 0 9 9h-9z'/><path d='M15 3.5A9 9 0 0 1 20.5 9H15z'/></svg>"
			VAR _Fleche  = "<svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='CC' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'><path d='PP'/></svg>"
			VAR _Haut    = "M12 19V5M5 12l7-7 7 7"
			VAR _Bas     = "M12 5v14M5 12l7 7 7-7"
			-- 6. Gabarits
			VAR _Carte   = "<div style='background:#FFFFFF;border:1px solid " & _ColGril & ";border-radius:16px;padding:12px 16px;display:flex;flex-direction:column;min-width:0;box-shadow:0 1px 2px rgba(16,24,40,.04)'>"
			VAR _Tete    = "<div style='display:flex;align-items:center;gap:10px;padding-bottom:8px;border-bottom:1px solid " & [Style Couleur fond neutre] & "'><span style='flex:none;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;background:"
			VAR _TeteMil = "'>"
			VAR _TeteTxt = "</span><span class='el' style='font-size:" & _TxtTxt & "px;font-weight:700;color:" & _ColTxt & "'>"
			VAR _TeteFin = "</span></div>"
			VAR _Note    = "<div class='el' style='font-size:" & _TxtPet & "px;color:" & _ColNeut & ";margin-top:4px'>"
			VAR _Vide    = "<span style='font-size:" & _TxtChif & "px;font-weight:700;color:" & _ColVide & ";line-height:1'>–</span>"
			-- lignes de comparaison (toujours 2) : regroupement (grisé si sans objet) et ensemble
			VAR _LigneReg = "<div class='tt' style='display:flex;align-items:center;gap:8px;font-size:" & _TxtPet & "px;color:" & _ColLib & ";OPA'><i style='flex:none;width:8px;height:8px;border-radius:50%;background:" & [Style Couleur regroupement] & "'></i><span class='el' style='flex:1'>" & _NomReg & "</span><b class='nb' style='font-weight:600;color:" & _ColFort & "'>VAL</b><div class='tip'>TIP</div></div>"
			VAR _LigneEns = "<div class='tt' style='display:flex;align-items:center;gap:8px;font-size:" & _TxtPet & "px;color:" & _ColLib & "'><i style='flex:none;width:8px;height:8px;border-radius:50%;background:" & [Style Couleur ensemble] & "'></i><span class='el' style='flex:1'>Ensemble des fédérations</span><b class='nb' style='font-weight:600;color:" & _ColFort & "'>VAL</b><div class='tip'>TIP</div></div>"
			VAR _DebComp  = "<div style='margin-top:auto;padding-top:7px;display:flex;flex-direction:column;gap:3px;border-top:1px dashed " & _ColGril & "'>"
			VAR _TipRegVide = "<b>Regroupement</b><br>" & _PourquoiPasReg
			VAR _Comp1 =
			    _DebComp
			    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_LigneReg, "OPA", IF(ISBLANK(_E1Reg), "opacity:.45", "")), "VAL", IF(ISBLANK(_E1Reg), "–", FORMAT(_E1Reg, _FmtEvol))), "TIP", IF(ISBLANK(_E1Reg), _TipRegVide, "<b>" & _NomReg & "</b><br>Évolution sur 1 an : " & FORMAT(_E1Reg, _FmtEvol)))
			    & SUBSTITUTE(SUBSTITUTE(_LigneEns, "VAL", IF(ISBLANK(_E1Ens), "–", FORMAT(_E1Ens, _FmtEvol))), "TIP", "<b>Ensemble des fédérations</b><br>Évolution sur 1 an : " & IF(ISBLANK(_E1Ens), "non calculable", FORMAT(_E1Ens, _FmtEvol)))
			    & "</div>"
			VAR _Comp19 =
			    _DebComp
			    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_LigneReg, "OPA", IF(ISBLANK(_E19Reg), "opacity:.45", "")), "VAL", IF(ISBLANK(_E19Reg), "–", FORMAT(_E19Reg, _FmtEvol))), "TIP", IF(ISBLANK(_E19Reg), _TipRegVide, "<b>" & _NomReg & "</b><br>Évolution depuis " & _AnneeAvantCovid & " : " & FORMAT(_E19Reg, _FmtEvol)))
			    & SUBSTITUTE(SUBSTITUTE(_LigneEns, "VAL", IF(ISBLANK(_E19Ens), "–", FORMAT(_E19Ens, _FmtEvol))), "TIP", "<b>Ensemble des fédérations</b><br>Évolution depuis " & _AnneeAvantCovid & " : " & IF(ISBLANK(_E19Ens), "non calculable", FORMAT(_E19Ens, _FmtEvol)))
			    & "</div>"
			-- 7. Données absentes
			VAR _SansDonnees =
			    "<div style='font-family:" & _Police & ";height:100%;display:flex;align-items:center;gap:16px;padding:18px 22px;background:#FFFFFF;border:1px dashed " & _ColVide & ";border-radius:16px'>"
			    & "<span style='display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:12px;background:" & [Style Couleur fond neutre] & "'>" & SUBSTITUTE(SUBSTITUTE(_Svg, "CC", _ColLib), "16", "22") & "<circle cx='11' cy='11' r='7'/><path d='M20 20l-3.5-3.5'/></svg></span>"
			    & "<div><div style='font-size:" & _TxtTxt & "px;font-weight:700;color:" & _ColTxt & "'>Aucune licence pour cette sélection en " & _AnRef & "</div>"
			    & "<div style='font-size:" & _TxtPet & "px;color:" & _ColLib & ";margin-top:4px'>Cette combinaison de fédération, territoire, public et année ne compte aucune licence. Élargissez un filtre ou réinitialisez la sélection.</div></div></div>"
			-- 8. Carte 1 : licences (+ logo)
			VAR _Mini    = "<div class='tt' style='flex:1;min-width:0;padding:5px 10px;border-radius:9px;background:rgba(255,255,255,.08)'><div style='font-size:13px;color:" & _TexteHerosClair & "'>"
			VAR _LogoHtml =
			    IF(NOT ISBLANK(_Logo) && _Logo <> "",
			        "<span style='flex:none;margin-left:auto;display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:#FFFFFF;box-shadow:0 2px 6px rgba(0,0,0,.25)'><img src='" & SUBSTITUTE(_Logo, "'", "%27") & "' style='max-width:32px;max-height:32px;object-fit:contain'></span>")
			VAR _C1 =
			    "<div style='border-radius:16px;padding:12px 16px;color:#FFFFFF;background:linear-gradient(135deg," & [Style Couleur marine] & " 0%," & [Style Couleur marine 2] & " 100%);display:flex;flex-direction:column;min-width:0'>"
			    & "<div style='display:flex;align-items:center;gap:10px;padding-bottom:8px;border-bottom:1px solid rgba(255,255,255,.14);height:37px'>"
			    & "<span style='flex:none;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;background:rgba(255,255,255,.14)'>" & SUBSTITUTE(_IcoLic, "CC", "#FFFFFF") & "</span>"
			    & "<div class='tt' style='display:flex;min-width:0'><span class='el' style='font-size:" & _TxtTxt & "px;font-weight:700'>" & _NomSel & "</span>"
			    & "<div class='tip bas'><b>" & _NomSel & "</b>" & IF(_Mode = "Plusieurs fédérations", "<br>" & [Sélection liste]) & "<br><span>Licences " & _AnRef & " · " & [Libellé territoire] & "</span></div></div>"
			    & _LogoHtml & "</div>"
			    & "<div class='nb' style='font-size:36px;font-weight:700;letter-spacing:-.02em;line-height:1.1;margin-top:8px'>" & FORMAT(_Lic, "#,0") & "</div>"
			    & "<div class='el' style='font-size:13px;color:" & _TexteHerosClair & "'>licences en " & _AnRef & " · " & [Libellé territoire] & "</div>"
			    & "<div style='display:flex;gap:8px;margin-top:auto'>"
			    & _Mini & "en un an</div><div class='nb' style='font-size:" & _TxtTxt & "px;font-weight:700'>" & IF(ISBLANK(_Ecart1), "–", FORMAT(_Ecart1, _FmtEcart)) & "</div>"
			    & "<div class='tip'>" & IF(ISBLANK(_Ecart1), "Pas de licence en " & (_AnRef - 1) & " : écart non calculable", "<b>" & FORMAT(_Ecart1, _FmtEcart) & " licences</b> entre " & (_AnRef - 1) & " et " & _AnRef & "<br><span>" & FORMAT(_LicN1, "#,0") & " → " & FORMAT(_Lic, "#,0") & "</span>") & "</div></div>"
			    & _Mini & "depuis " & _AnneeAvantCovid & "</div><div class='nb' style='font-size:" & _TxtTxt & "px;font-weight:700'>" & IF(ISBLANK(_Ecart19), "–", FORMAT(_Ecart19, _FmtEcart)) & "</div>"
			    & "<div class='tip'>" & IF(ISBLANK(_Ecart19), "Pas de licence en " & _AnneeAvantCovid & " (ou année choisie ≤ " & _AnneeAvantCovid & ") : écart non calculable", "<b>" & FORMAT(_Ecart19, _FmtEcart) & " licences</b> entre " & _AnneeAvantCovid & " et " & _AnRef & "<br><span>" & FORMAT(_Lic19, "#,0") & " → " & FORMAT(_Lic, "#,0") & "</span>") & "</div></div>"
			    & "</div></div>"
			-- 9. Cartes 2 et 3 : évolutions (même gabarit)
			VAR _Evo    = "<div class='tt' style='display:flex;align-items:center;gap:10px;margin-top:8px;width:max-content'>"
			VAR _ValEvo = "<span class='nb' style='font-size:" & _TxtChif & "px;font-weight:700;letter-spacing:-.02em;line-height:1;color:"
			VAR _Coul1  = IF(_E1 < 0, [Style Couleur baisse], [Style Couleur hausse])
			VAR _C2 =
			    _Carte & _Tete & [Style Couleur accent fond] & _TeteMil & SUBSTITUTE(_IcoE1, "CC", [Style Couleur accent]) & _TeteTxt & "Évolution sur 1 an" & _TeteFin
			    & IF(ISBLANK(_E1), "<div class='tt' style='margin-top:8px;width:max-content'>" & _Vide & "<div class='tip bas'>Pas de licence en " & (_AnRef - 1) & " pour la sélection :<br>évolution non calculable. Les comparaisons restent affichées.</div></div>",
			        _Evo & "<span style='display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;background:" & IF(_E1 < 0, [Style Couleur baisse fond], [Style Couleur hausse fond]) & "'>" & SUBSTITUTE(SUBSTITUTE(_Fleche, "CC", _Coul1), "PP", IF(_E1 < 0, _Bas, _Haut)) & "</span>"
			        & _ValEvo & _Coul1 & "'>" & FORMAT(_E1, _FmtEvol) & "</span>"
			        & "<div class='tip bas'><b>Note de lecture</b><br>" & FORMAT(_Lic, "#,0") & " licences en " & _AnRef & " contre " & FORMAT(_LicN1, "#,0") & " en " & (_AnRef - 1) & ",<br>soit " & FORMAT(_E1, _FmtEvol) & " (" & FORMAT(_Ecart1, _FmtEcart) & " licences).</div></div>")
			    & _Note & IF(ISBLANK(_E1), "Pas de licence en " & (_AnRef - 1) & " : non calculable", "vs " & (_AnRef - 1) & " · " & FORMAT(_LicN1, "#,0") & " licences") & "</div>"
			    & _Comp1 & "</div>"
			VAR _Coul19 = IF(_E19 < 0, [Style Couleur baisse], [Style Couleur hausse])
			VAR _C3 =
			    _Carte & _Tete & [Style Couleur accent fond] & _TeteMil & SUBSTITUTE(_IcoE19, "CC", [Style Couleur accent]) & _TeteTxt & "Évolution depuis " & _AnneeAvantCovid & _TeteFin
			    & IF(ISBLANK(_E19), "<div class='tt' style='margin-top:8px;width:max-content'>" & _Vide & "<div class='tip bas'>" & IF(_AnRef <= _AnneeAvantCovid, "L'année choisie est " & _AnRef & ".", "Pas de licence en " & _AnneeAvantCovid & " pour la sélection :<br>évolution non calculable. Les comparaisons restent affichées.") & "</div></div>",
			        _Evo & "<span style='display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;background:" & IF(_E19 < 0, [Style Couleur baisse fond], [Style Couleur hausse fond]) & "'>" & SUBSTITUTE(SUBSTITUTE(_Fleche, "CC", _Coul19), "PP", IF(_E19 < 0, _Bas, _Haut)) & "</span>"
			        & _ValEvo & _Coul19 & "'>" & FORMAT(_E19, _FmtEvol) & "</span>"
			        & "<div class='tip bas'><b>Note de lecture</b><br>" & FORMAT(_Lic, "#,0") & " licences en " & _AnRef & " contre " & FORMAT(_Lic19, "#,0") & " en " & _AnneeAvantCovid & " (avant Covid),<br>soit " & FORMAT(_E19, _FmtEvol) & " (" & FORMAT(_Ecart19, _FmtEcart) & " licences).</div></div>")
			    & _Note & SWITCH(TRUE(),
			        _AnRef <= _AnneeAvantCovid, "Non calculée : l'année choisie est " & _AnRef,
			        ISBLANK(_E19), "Pas de licence en " & _AnneeAvantCovid & " : non calculable",
			        "vs " & _AnneeAvantCovid & ", avant Covid · " & FORMAT(_Lic19, "#,0") & " licences") & "</div>"
			    & _Comp19 & "</div>"
			-- 10. Carte 4 : poids (toujours 3 lignes : groupe, famille, ensemble)
			VAR _PGroupe = DIVIDE(_Lic, _LicGroupe)
			VAR _PFam    = DIVIDE(_Lic, _LicFam)
			VAR _PEns    = DIVIDE(_Lic, _LicEns)
			VAR _TitrePoids = SWITCH(_Mode, "Fédération", "Poids de la fédération", "Regroupement", "Poids du regroupement", "Plusieurs fédérations", "Poids de la sélection", "Poids de l'ensemble")
			VAR _PasFed  = "Choisissez une seule fédération pour voir son poids<br>dans son groupe et dans sa famille."
			VAR _Barre   = "<div class='tt' style='"
			VAR _BarreLb = "'><div style='display:flex;align-items:baseline;gap:8px;font-size:" & _TxtPet & "px;color:" & _ColLib & "'><span class='el' style='flex:1'>"
			VAR _BarreVal = "</span><b class='nb' style='font-size:" & _TxtTxt & "px;color:" & _ColTxt & ";font-weight:700'>"
			VAR _BarrePiste = "</b></div><div style='height:7px;border-radius:4px;background:" & [Style Couleur poids fond] & ";margin-top:4px'><div style='height:7px;border-radius:4px;background:" & [Style Couleur poids] & ";"
			VAR _B1 = _Barre & IF(ISBLANK(_PGroupe), "opacity:.45", "") & _BarreLb & "dans le groupe <b style='color:" & _ColFort & ";font-weight:600'>" & COALESCE(_Groupe, "…") & "</b>" & _BarreVal & IF(ISBLANK(_PGroupe), "–", IF(NOT ISBLANK(_PGroupe) && _PGroupe < 0.001, "< 0,1 %", FORMAT(_PGroupe, "0.0 %"))) & _BarrePiste & "width:" & FORMAT(MIN(_PGroupe + 0, 1) * 100, "0.0", "en-US") & "%'></div></div><div class='tip'>" & IF(ISBLANK(_PGroupe), _PasFed, "<b>" & IF(NOT ISBLANK(_PGroupe) && _PGroupe < 0.001, "< 0,1 %", FORMAT(_PGroupe, "0.0 %")) & "</b> des licences du groupe " & _Groupe & "<br><span>" & FORMAT(_Lic, "#,0") & " sur " & FORMAT(_LicGroupe, "#,0") & "</span>") & "</div></div>"
			VAR _B2 = _Barre & IF(ISBLANK(_PFam), "opacity:.45", "") & _BarreLb & "dans la famille <b style='color:" & _ColFort & ";font-weight:600'>" & COALESCE(_Famille, "…") & "</b>" & _BarreVal & IF(ISBLANK(_PFam), "–", IF(NOT ISBLANK(_PFam) && _PFam < 0.001, "< 0,1 %", FORMAT(_PFam, "0.0 %"))) & _BarrePiste & "opacity:.75;width:" & FORMAT(MIN(_PFam + 0, 1) * 100, "0.0", "en-US") & "%'></div></div><div class='tip'>" & IF(ISBLANK(_PFam), _PasFed, "<b>" & IF(NOT ISBLANK(_PFam) && _PFam < 0.001, "< 0,1 %", FORMAT(_PFam, "0.0 %")) & "</b> des licences de la famille " & _Famille & "<br><span>" & FORMAT(_Lic, "#,0") & " sur " & FORMAT(_LicFam, "#,0") & "</span>") & "</div></div>"
			VAR _B3 = _Barre & _BarreLb & "dans l'ensemble <b style='color:" & _ColFort & ";font-weight:600'>des fédérations</b>" & _BarreVal & IF(NOT ISBLANK(_PEns) && _PEns < 0.001, "< 0,1 %", FORMAT(_PEns, "0.0 %")) & _BarrePiste & "opacity:.5;width:" & FORMAT(MIN(_PEns, 1) * 100, "0.0", "en-US") & "%'></div></div><div class='tip'><b>" & IF(NOT ISBLANK(_PEns) && _PEns < 0.001, "< 0,1 %", FORMAT(_PEns, "0.0 %")) & "</b> de l'ensemble des licences<br><span>" & FORMAT(_Lic, "#,0") & " sur " & FORMAT(_LicEns, "#,0") & " · " & [Libellé territoire] & "</span></div></div>"
			VAR _C4 =
			    _Carte & _Tete & [Style Couleur poids fond] & _TeteMil & SUBSTITUTE(_IcoPds, "CC", [Style Couleur poids]) & _TeteTxt & _TitrePoids & _TeteFin
			    & "<div style='display:flex;flex-direction:column;justify-content:space-between;gap:4px;flex:1;margin-top:6px'>" & _B1 & _B2 & _B3 & "</div></div>"
			-- 11. Assemblage (hauteur et débordements bloqués : jamais de barre de défilement)
			RETURN
			    [Style CSS commun]
			    & IF(ISBLANK(_Lic),
			        _SansDonnees,
			        "<div style='font-family:" & _Police & ";display:grid;grid-template-columns:" & _Colonnes & ";gap:14px;width:100%;height:100vh;overflow:hidden;padding:1px;color:" & _ColTxt & "'>"
			        & _C1 & _C2 & _C3 & _C4 & "</div>")
		displayFolder: 6. Portrait\HTML
		lineageTag: 49c5a780-d93f-4119-924e-87c1692dd47f

	/// Bloc PROFIL de la page Portrait (visuel HTML Content ~680 x 870) : assemble les sections Genre (HTML Qui Profil), Âge (HTML Qui Âges) et Pyramide (HTML Qui Pyramide).
	measure 'HTML Qui' =
			-- =====================================================================
			-- HTML Qui | bloc PROFIL | page Portrait | visuel HTML Content ~680 x 984
			-- Assemble : HTML Qui Profil (Genre), HTML Qui Âges (Âge), HTML Qui Pyramide
			-- =====================================================================
			-- 1. Réglages
			VAR _HauteurCadre = 985      -- hauteur du visuel (984) - 19 : jamais de barre de défilement
			-- 2. Contexte : filtres de public actifs (pastille en haut à droite)
			VAR _GSel  = IF(ISFILTERED(T_Sexe) && HASONEVALUE(T_Sexe[Sexe]), SELECTEDVALUE(T_Sexe[Sexe]))
			VAR _CSel  = IF(ISFILTERED(T_TrancheAge) && HASONEVALUE(T_TrancheAge[Ordre]), SELECTEDVALUE(T_TrancheAge[Ordre]))
			VAR _CLib  = IF(NOT ISBLANK(_CSel), SELECTEDVALUE(T_TrancheAge[TrancheAge]))
			VAR _CNom  = IF(NOT ISBLANK(_CLib), TRIM(MID(_CLib, 5, SEARCH("(", _CLib, 1, LEN(_CLib) + 1) - 5)))
			VAR _GNom  = SWITCH(_GSel, "F", "Femmes", "H", "Hommes")
			VAR _Actif = CONCATENATEX(FILTER({_GNom, _CNom}, NOT ISBLANK([Value])), [Value], " · ")
			VAR _NbLic = CALCULATE([NB Licences], REMOVEFILTERS(T_Sexe))
			-- 3. Gabarits
			VAR _Pastille =
			    IF(NOT ISBLANK(_Actif),
			        "<span class='tt' style='flex:none;display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 11px;border-radius:13px;background:" & [Style Couleur filtre actif fond] & ";border:1px solid " & [Style Couleur filtre actif bordure] & ";color:" & [Style Couleur filtre actif texte] & ";font-size:" & [Style Taille petit] & "px;font-weight:600'><i style='width:6px;height:6px;border-radius:50%;background:" & [Style Couleur filtre actif point] & "'></i>" & _Actif
			        & "<span class='tip bas'>Filtre de public actif : les chiffres portent sur ce public.<br><span>Le genre ou l'âge choisi est mis en évidence dans les graphiques.</span></span></span>")
			VAR _Titre =
			    "<div style='display:flex;align-items:flex-start;justify-content:space-between;gap:12px'>"
			    & "<div style='min-width:0'><div style='" & [Style CSS ligne titre] & "'>"
			    & "<span style='" & [Style CSS rubrique] & "'>PROFIL</span>"
			    & "<span style='" & [Style CSS titre bloc] & "'>Profil des licenciés</span></div>"
			    & "<div class='el' style='" & [Style CSS sous-titre] & "'>Genre et âge · " & [Sélection libellé] & " · " & [Libellé territoire] & " · " & MAX(T_Annee[Annee]) & "</div></div>"
			    & _Pastille & "</div>"
			VAR _Corps =
			    IF(ISBLANK(_NbLic),
			        "<div style='flex:1;margin-top:16px;border:1.5px dashed " & [Style Couleur bordure forte] & ";border-radius:10px;display:flex;flex-direction:column;gap:4px;align-items:center;justify-content:center;text-align:center;font-size:" & [Style Taille texte] & "px;color:" & [Style Couleur texte libellé] & "'><b style='color:" & [Style Couleur texte] & "'>Aucune licence pour cette sélection</b><span style='font-size:" & [Style Taille petit] & "px'>Élargissez un filtre (fédération, territoire, public).</span></div>",
			        "<div style='display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:20px'>" & [HTML Qui Profil] & [HTML Qui Âges] & "</div>"
			        & "<div style='margin-top:30px'>" & [HTML Qui Pyramide] & "</div>")
			-- 4. Assemblage
			RETURN
			    [Style CSS commun]
			    & "<div style='" & [Style CSS cadre] & ";height:" & _HauteurCadre & "px;color:" & [Style Couleur texte] & "'>"
			    & _Titre & _Corps & "</div>"
		displayFolder: 6. Portrait\HTML
		lineageTag: 91681c6c-4982-48c1-b4a9-c972ea6275b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Bloc ÉVOLUTION de la page Portrait (visuel HTML Content ~745 x 390) : licences par année (vue Volume) ou indice base 100 (vue Base 100) pour la sélection, son regroupement et l'ensemble. Courbes tracées seulement quand l'indice est calculable ; étiquettes de l'année choisie réparties sans chevauchement ; infobulles au survol.
	measure 'HTML Évolution' =
			-- =====================================================================
			-- HTML Évolution | page Portrait | visuel HTML Content ~745 x 390
			-- Vue Volume (T_VueEvol = 1) : barres des licences par année
			-- Vue Base 100 (T_VueEvol = 2) : indice de la sélection, du regroupement, de l'ensemble
			-- Regroupement entier sélectionné : courbe orange (couleur regroupement), entrée « Fédération » grisée.
			-- Mise en page FIXE : la légende garde ses 3 entrées quel que soit le segment (grisées si sans objet)
			-- Si l'indice de la sélection est impossible, regroupement et ensemble restent tracés.
			-- Dépend de : Evo Licences, Evo Indice sélection / regroupement / ensemble,
			--             Sélection mode, Sélection libellé, Sélection liste, charte
			-- =====================================================================
			-- 1. Réglages
			VAR _HauteurCadre = 370      -- hauteur du visuel - 20 environ (barre de défilement sinon)
			VAR _PlaceSegment = 230      -- place libre en haut à droite pour le segment Volume / Base 100
			VAR _W = 709                 -- zone du graphique (unités SVG)
			VAR _H = 272
			VAR _PL = 66                 -- marge gauche (axe)
			VAR _PR = 78                 -- marge droite (étiquettes de la dernière année)
			VAR _PT = 26
			VAR _PB = 34
			VAR _LargeurBulle = 280
			VAR _EcartEtiq = 27          -- écart vertical minimal entre deux étiquettes
			-- 2. Charte
			VAR _Police  = [Style Police]
			VAR _ColSel  = [Style Couleur sélection]
			VAR _ColReg  = [Style Couleur regroupement]
			VAR _ColEns  = [Style Couleur ensemble]
			VAR _ColBar  = [Style Couleur sélection clair]
			VAR _ColBand = [Style Couleur accent fond]
			VAR _ColGril = [Style Couleur grille]
			VAR _ColAxe  = [Style Couleur texte discret]
			VAR _ColEtiq = [Style Couleur texte secondaire]
			VAR _ColTxt  = [Style Couleur texte]
			VAR _TxtPet  = [Style Taille petit]
			VAR _TxtTxt  = [Style Taille texte]
			VAR _F1      = "0.0"
			-- 3. Contexte (sélection, vue, année)
			VAR _Mode    = [Sélection mode]
			VAR _AvecSel = _Mode <> "Ensemble"
			VAR _AvecReg = _Mode IN {"Fédération", "Plusieurs fédérations"} && NOT ISBLANK([Nom regroupement])
			VAR _Vue     = SELECTEDVALUE(T_VueEvol[Ordre], 2)
			VAR _AnSel   = MAX(T_Annee[Annee])
			VAR _NomSel  = [Sélection libellé]
			VAR _NomReg  = [Nom regroupement]
			VAR _NomSelB = IF(LEN(_NomSel) > 26, LEFT(_NomSel, 25) & "…", _NomSel)
			VAR _NomRegB = IF(LEN(_NomReg) > 26, LEFT(_NomReg, 25) & "…", _NomReg)
			VAR _Liste   = IF(_Mode = "Plusieurs fédérations", [Sélection liste])
			-- regroupement entier sélectionné (sans fédération) : sa courbe prend la couleur « regroupement »
			VAR _ModeReg   = _Mode = "Regroupement"
			VAR _ColCourbe = IF(_ModeReg, _ColReg, _ColSel)
			-- 4. Données (une ligne par année de l'axe)
			VAR _A0  = MINX(ALL(T_AnneeAxe[Annee]), VALUE(T_AnneeAxe[Annee]))
			VAR _Tab0 =
			ADDCOLUMNS(
			ALL(T_AnneeAxe[Annee]),
			"@i", VALUE(T_AnneeAxe[Annee]) - _A0,
			"@v", [Evo Licences],
			"@s", [Evo Indice sélection],
			"@r", IF(_AvecReg, [Evo Indice regroupement]),
			"@e", IF(_AvecSel, [Evo Indice ensemble])
			)
			VAR _Tab  = ADDCOLUMNS(_Tab0, "@p", VAR _Rang = [@i] RETURN MAXX(FILTER(_Tab0, [@i] = _Rang - 1), [@v]))
			VAR _N    = COUNTROWS(_Tab)
			VAR _ISel = VALUE(_AnSel) - _A0
			VAR _YAn  = _H - 8
			VAR _Css  = [Style CSS commun]
			VAR _Ombre = "<defs><filter id='omb' x='-20%' y='-20%' width='140%' height='160%'><feDropShadow dx='0' dy='3' stdDeviation='4' flood-color='#101828' flood-opacity='.14'/></filter></defs>"
			-- 5. Vue Volume (grands nombres en M / k ; valeur exacte dans l'infobulle)
			VAR _VMax    = MAXX(_Tab, [@v])
			VAR _PasBrut = MAX(_VMax, 1) * 1.12 / 4
			VAR _Mag     = POWER(10, INT(LOG10(_PasBrut)))
			VAR _Norm    = _PasBrut / _Mag
			VAR _Pas     = SWITCH(TRUE(), _Norm <= 1, 1, _Norm <= 2, 2, _Norm <= 2.5, 2.5, _Norm <= 3, 3, _Norm <= 4, 4, _Norm <= 5, 5, 10) * _Mag
			VAR _Plafond = 4 * _Pas
			VAR _StV     = (_W - _PL - 4) / _N
			VAR _YV0     = _H - _PB
			VAR _FmtAxeK = SWITCH(TRUE(), _Plafond >= 2000000, "M", _Plafond >= 10000, "k", "")
			VAR _GrilleV =
			CONCATENATEX(GENERATESERIES(0, 4),
			VAR _t = _Plafond * [Value] / 4
			VAR _y = _YV0 - (_t / _Plafond) * (_H - _PT - _PB)
			RETURN "<line x1='" & _PL & "' x2='" & (_W - 4) & "' y1='" & FORMAT(_y, _F1, "en-US") & "' y2='" & FORMAT(_y, _F1, "en-US") & "' stroke='" & _ColGril & "'/>"
			& "<text x='" & (_PL - 14) & "' y='" & FORMAT(_y + 5, _F1, "en-US") & "' text-anchor='end' font-size='" & _TxtPet & "' fill='" & _ColAxe & "'>"
			& SWITCH(_FmtAxeK,
			"M", FORMAT(_t / 1000000, IF(MOD(_t, 1000000) = 0, "0", "0.0")) & " M",
			"k", FORMAT(_t / 1000, IF(MOD(_t, 1000) = 0, "#,0", "#,0.0")) & " k",
			FORMAT(_t, "#,0")) & "</text>",
			"", [Value], ASC)
			VAR _Barres =
			CONCATENATEX(FILTER(_Tab, NOT ISBLANK([@v])),
			VAR _x  = _PL + [@i] * _StV + _StV * 0.17
			VAR _bw = _StV * 0.66
			VAR _y  = _YV0 - DIVIDE([@v], _Plafond) * (_H - _PT - _PB)
			VAR _cx = _x + _bw / 2
			VAR _Lab = SWITCH(TRUE(), [@v] >= 1000000, FORMAT([@v] / 1000000, "0.00") & " M", [@v] >= 10000, FORMAT([@v] / 1000, "#,0") & " k", FORMAT([@v], "#,0"))
			VAR _EstSel = [@i] = _ISel
			RETURN
			"<rect x='" & FORMAT(_x, _F1, "en-US") & "' y='" & FORMAT(_y, _F1, "en-US") & "' width='" & FORMAT(_bw, _F1, "en-US") & "' height='" & FORMAT(_YV0 - _y, _F1, "en-US") & "' rx='4' fill='" & IF(_EstSel, _ColSel, _ColBar) & "'/>"
			& IF(_EstSel,
			"<rect x='" & FORMAT(_cx - 38, _F1, "en-US") & "' y='" & FORMAT(_y - 27, _F1, "en-US") & "' width='76' height='22' rx='5' fill='" & _ColTxt & "'/>"
			& "<text x='" & FORMAT(_cx, _F1, "en-US") & "' y='" & FORMAT(_y - 11, _F1, "en-US") & "' text-anchor='middle' font-size='" & _TxtPet & "' font-weight='700' fill='#FFFFFF'>" & _Lab & "</text>",
			"<text x='" & FORMAT(_cx, _F1, "en-US") & "' y='" & FORMAT(_y - 7, _F1, "en-US") & "' text-anchor='middle' font-size='13' font-weight='600' fill='" & _ColEtiq & "'>" & _Lab & "</text>"),
			"", [@i], ASC)
			VAR _AnneesV =
			CONCATENATEX(_Tab,
			VAR _cx = _PL + [@i] * _StV + _StV / 2
			RETURN IF([@i] = _ISel,
			"<rect x='" & FORMAT(_cx - 27, _F1, "en-US") & "' y='" & (_YAn - 17) & "' width='54' height='23' rx='11.5' fill='" & _ColSel & "'/><text x='" & FORMAT(_cx, _F1, "en-US") & "' y='" & _YAn & "' text-anchor='middle' font-size='" & _TxtPet & "' font-weight='700' fill='#FFFFFF'>" & T_AnneeAxe[Annee] & "</text>",
			"<text x='" & FORMAT(_cx, _F1, "en-US") & "' y='" & _YAn & "' text-anchor='middle' font-size='" & _TxtPet & "' fill='" & _ColAxe & "'>" & T_AnneeAxe[Annee] & "</text>"),
			"", [@i], ASC)
			VAR _BullesV =
			CONCATENATEX(_Tab,
			VAR _x0 = _PL + [@i] * _StV
			VAR _cx = _x0 + _StV / 2
			VAR _y  = _YV0 - DIVIDE([@v], _Plafond) * (_H - _PT - _PB)
			VAR _PosX = IF(_cx + 12 + _LargeurBulle > _W, _cx - 12 - _LargeurBulle, _cx + 12)
			VAR _PosY = MAX(2, MIN(_y - 24, _YV0 - 76))
			VAR _EvoAn = DIVIDE([@v], [@p]) - 1
			RETURN
			"<g class='pt'><rect x='" & FORMAT(_x0, _F1, "en-US") & "' y='0' width='" & FORMAT(_StV, _F1, "en-US") & "' height='" & _H & "' fill='#000' fill-opacity='0'/>"
			& "<rect class='hl' x='" & FORMAT(_x0 + 2, _F1, "en-US") & "' y='" & (_PT - 8) & "' width='" & FORMAT(_StV - 4, _F1, "en-US") & "' height='" & (_H - _PT - _PB + 8) & "' rx='6' fill='" & _ColSel & "' fill-opacity='.07' pointer-events='none'/>"
			& "<g class='ptip' pointer-events='none'><rect x='" & FORMAT(_PosX, _F1, "en-US") & "' y='" & FORMAT(_PosY, _F1, "en-US") & "' width='" & _LargeurBulle & "' height='72' rx='8' fill='#FFFFFF' stroke='" & [Style Couleur bordure] & "' filter='url(#omb)'/>"
			& "<text x='" & FORMAT(_PosX + 12, _F1, "en-US") & "' y='" & FORMAT(_PosY + 23, _F1, "en-US") & "' font-size='" & _TxtTxt & "' font-weight='700' fill='" & _ColTxt & "'>" & T_AnneeAxe[Annee] & "</text>"
			& "<text x='" & FORMAT(_PosX + 12, _F1, "en-US") & "' y='" & FORMAT(_PosY + 44, _F1, "en-US") & "' font-size='" & _TxtPet & "' fill='" & _ColEtiq & "'>Licences <tspan font-weight='700' fill='" & _ColTxt & "'>" & IF(ISBLANK([@v]), "aucune", FORMAT([@v], "#,0")) & "</tspan></text>"
			& "<text x='" & FORMAT(_PosX + 12, _F1, "en-US") & "' y='" & FORMAT(_PosY + 63, _F1, "en-US") & "' font-size='" & _TxtPet & "' fill='" & _ColEtiq & "'>Sur 1 an <tspan font-weight='700' fill='" & IF(_EvoAn < 0, [Style Couleur baisse], [Style Couleur hausse]) & "'>" & IF(ISBLANK([@p]) || ISBLANK([@v]), "non calculable", FORMAT(_EvoAn, "+0.0 %;-0.0 %;0.0 %")) & "</tspan></text></g></g>",
			"", [@i], ASC)
			-- 6. Vue Base 100 : échelle sur les seules valeurs calculables (jamais négative)
			VAR _Vals =
			UNION(
			SELECTCOLUMNS(FILTER(_Tab, NOT ISBLANK([@s])), "v", [@s]),
			SELECTCOLUMNS(FILTER(_Tab, NOT ISBLANK([@r])), "v", [@r]),
			SELECTCOLUMNS(FILTER(_Tab, NOT ISBLANK([@e])), "v", [@e]))
			VAR _IndiceOk = NOT ISEMPTY(FILTER(_Tab, NOT ISBLANK([@s])))
			VAR _MinI = MINX(_Vals, [v])
			VAR _MaxI = MAXX(_Vals, [v])
			VAR _Lo   = MAX(0, FLOOR(_MinI - 2, 5))
			VAR _Rng  = MAX(CEILING(_MaxI + 2 - _Lo, 20), 20)
			VAR _Hi   = _Lo + _Rng
			VAR _StB  = (_W - _PL - _PR) / (_N - 1)
			VAR _XSel = _PL + _ISel * _StB
			VAR _GrilleB =
			CONCATENATEX(GENERATESERIES(0, 4),
			VAR _t = _Lo + _Rng * [Value] / 4
			VAR _y = _PT + (_Hi - _t) / _Rng * (_H - _PT - _PB)
			RETURN "<line x1='" & _PL & "' x2='" & (_W - _PR + 24) & "' y1='" & FORMAT(_y, _F1, "en-US") & "' y2='" & FORMAT(_y, _F1, "en-US") & "' stroke='" & _ColGril & "'/>"
			& "<text x='" & (_PL - 14) & "' y='" & FORMAT(_y + 5, _F1, "en-US") & "' text-anchor='end' font-size='" & _TxtPet & "' fill='" & _ColAxe & "'>" & FORMAT(_t, "0") & "</text>",
			"", [Value], ASC)
			VAR _Y100  = _PT + (_Hi - 100) / _Rng * (_H - _PT - _PB)
			VAR _Bande = "<rect x='" & FORMAT(_XSel - _StB / 2 + 4, _F1, "en-US") & "' y='" & (_PT - 12) & "' width='" & FORMAT(_StB - 8, _F1, "en-US") & "' height='" & (_H - _PB - _PT + 12) & "' rx='8' fill='" & _ColBand & "'/>"
			VAR _AnneesB =
			CONCATENATEX(_Tab,
			VAR _x = _PL + [@i] * _StB
			RETURN IF([@i] = _ISel,
			"<rect x='" & FORMAT(_x - 27, _F1, "en-US") & "' y='" & (_YAn - 17) & "' width='54' height='23' rx='11.5' fill='" & _ColSel & "'/><text x='" & FORMAT(_x, _F1, "en-US") & "' y='" & _YAn & "' text-anchor='middle' font-size='" & _TxtPet & "' font-weight='700' fill='#FFFFFF'>" & T_AnneeAxe[Annee] & "</text>",
			"<text x='" & FORMAT(_x, _F1, "en-US") & "' y='" & _YAn & "' text-anchor='middle' font-size='" & _TxtPet & "' fill='" & _ColAxe & "'>" & T_AnneeAxe[Annee] & "</text>"),
			"", [@i], ASC)
			-- tracés : un segment ne relie que deux années calculables qui se suivent
			VAR _CheminS = CONCATENATEX(FILTER(_Tab, NOT ISBLANK([@s])), VAR _i = [@i] VAR _Prec = MAXX(FILTER(_Tab, [@i] = _i - 1), [@s]) RETURN IF(ISBLANK(_Prec), "M", "L") & FORMAT(_PL + _i * _StB, _F1, "en-US") & "," & FORMAT(_PT + (_Hi - [@s]) / _Rng * (_H - _PT - _PB), _F1, "en-US"), " ", [@i], ASC)
			VAR _CheminR = CONCATENATEX(FILTER(_Tab, NOT ISBLANK([@r])), VAR _i = [@i] VAR _Prec = MAXX(FILTER(_Tab, [@i] = _i - 1), [@r]) RETURN IF(ISBLANK(_Prec), "M", "L") & FORMAT(_PL + _i * _StB, _F1, "en-US") & "," & FORMAT(_PT + (_Hi - [@r]) / _Rng * (_H - _PT - _PB), _F1, "en-US"), " ", [@i], ASC)
			VAR _CheminE = CONCATENATEX(FILTER(_Tab, NOT ISBLANK([@e])), VAR _i = [@i] VAR _Prec = MAXX(FILTER(_Tab, [@i] = _i - 1), [@e]) RETURN IF(ISBLANK(_Prec), "M", "L") & FORMAT(_PL + _i * _StB, _F1, "en-US") & "," & FORMAT(_PT + (_Hi - [@e]) / _Rng * (_H - _PT - _PB), _F1, "en-US"), " ", [@i], ASC)
			VAR _Traces =
			IF(NOT ISBLANK(_CheminE), "<path d='" & _CheminE & "' fill='none' stroke='" & _ColEns & "' stroke-width='2' stroke-linejoin='round'/>")
			& IF(NOT ISBLANK(_CheminR), "<path d='" & _CheminR & "' fill='none' stroke='" & _ColReg & "' stroke-width='2' stroke-linejoin='round'/>")
			& IF(NOT ISBLANK(_CheminS), "<path d='" & _CheminS & "' fill='none' stroke='" & _ColCourbe & "' stroke-width='3' stroke-linejoin='round'/>")
			VAR _Marqueurs =
			CONCATENATEX(_Tab,
			VAR _x = FORMAT(_PL + [@i] * _StB, _F1, "en-US")
			RETURN
			IF(NOT ISBLANK([@e]), "<circle cx='" & _x & "' cy='" & FORMAT(_PT + (_Hi - [@e]) / _Rng * (_H - _PT - _PB), _F1, "en-US") & "' r='3.5' fill='#FFFFFF' stroke='" & _ColEns & "' stroke-width='2'/>")
			& IF(NOT ISBLANK([@r]), "<circle cx='" & _x & "' cy='" & FORMAT(_PT + (_Hi - [@r]) / _Rng * (_H - _PT - _PB), _F1, "en-US") & "' r='3.5' fill='#FFFFFF' stroke='" & _ColReg & "' stroke-width='2'/>")
			& IF(NOT ISBLANK([@s]), "<circle cx='" & _x & "' cy='" & FORMAT(_PT + (_Hi - [@s]) / _Rng * (_H - _PT - _PB), _F1, "en-US") & "' r='4.5' fill='#FFFFFF' stroke='" & _ColCourbe & "' stroke-width='2.5'/>"),
			"", [@i], ASC)
			-- étiquettes de l'année choisie : à droite du point, réparties verticalement sans chevauchement
			VAR _VS = MAXX(FILTER(_Tab, [@i] = _ISel), [@s])
			VAR _VR = MAXX(FILTER(_Tab, [@i] = _ISel), [@r])
			VAR _VE = MAXX(FILTER(_Tab, [@i] = _ISel), [@e])
			VAR _PtsSel =
			FILTER(
			UNION(ROW("n", 1, "v", _VS, "c", _ColCourbe), ROW("n", 2, "v", _VR, "c", _ColReg), ROW("n", 3, "v", _VE, "c", _ColEns)),
			NOT ISBLANK([v]))
			VAR _PtsSel2 = ADDCOLUMNS(_PtsSel, "@y", _PT + (_Hi - [v]) / _Rng * (_H - _PT - _PB), "@k", RANKX(_PtsSel, [v] + [n] / 1000000, , DESC))
			VAR _Y1  = MAXX(FILTER(_PtsSel2, [@k] = 1), [@y])
			VAR _Y2  = IF(COUNTROWS(_PtsSel2) >= 2, MAX(MAXX(FILTER(_PtsSel2, [@k] = 2), [@y]), _Y1 + _EcartEtiq))
			VAR _Y3  = IF(COUNTROWS(_PtsSel2) >= 3, MAX(MAXX(FILTER(_PtsSel2, [@k] = 3), [@y]), _Y2 + _EcartEtiq))
			VAR _YBas = COALESCE(_Y3, _Y2, _Y1)
			VAR _Recul = MAX(0, _YBas - (_H - _PB - 6))
			VAR _XEtiq = IF(_XSel + 12 + 56 > _W, _XSel - 68, _XSel + 12)
			VAR _Pastilles =
			CONCATENATEX(_PtsSel2,
			VAR _yy = SWITCH([@k], 1, _Y1, 2, _Y2, _Y3) - _Recul
			RETURN "<circle cx='" & FORMAT(_XSel, _F1, "en-US") & "' cy='" & FORMAT([@y], _F1, "en-US") & "' r='6' fill='" & [c] & "' stroke='#FFFFFF' stroke-width='2'/>"
			& IF(ABS(_yy - [@y]) > 3, "<line x1='" & FORMAT(_XSel + 6, _F1, "en-US") & "' x2='" & FORMAT(_XEtiq, _F1, "en-US") & "' y1='" & FORMAT([@y], _F1, "en-US") & "' y2='" & FORMAT(_yy, _F1, "en-US") & "' stroke='" & [c] & "' stroke-width='1.2'/>")
			& "<rect x='" & FORMAT(_XEtiq, _F1, "en-US") & "' y='" & FORMAT(_yy - 11.5, _F1, "en-US") & "' width='56' height='23' rx='5' fill='" & [c] & "'/>"
			& "<text x='" & FORMAT(_XEtiq + 28, _F1, "en-US") & "' y='" & FORMAT(_yy + 5, _F1, "en-US") & "' text-anchor='middle' font-size='" & _TxtPet & "' font-weight='700' fill='#FFFFFF'>" & FORMAT([v], "0.0") & "</text>",
			"", [n], DESC)
			-- bulles au survol (Base 100)
			VAR _NbLignes = 1 + IF(_AvecReg, 1, 0) + IF(_AvecSel, 1, 0)
			VAR _HB = 54 + 21 * _NbLignes
			VAR _LigneB = "<text font-size='" & _TxtPet & "' fill='" & _ColEtiq & "' x='"
			VAR _BullesB =
			CONCATENATEX(_Tab,
			VAR _x = _PL + [@i] * _StB
			VAR _PosX = IF(_x + 12 + _LargeurBulle > _W, _x - 12 - _LargeurBulle, _x + 12)
			VAR _PosY = 2
			VAR _Ligne = "<circle cx='" & FORMAT(_PosX + 16, _F1, "en-US") & "' r='4.5' fill='"
			RETURN
			"<g class='pt'><rect x='" & FORMAT(_x - _StB / 2, _F1, "en-US") & "' y='0' width='" & FORMAT(_StB, _F1, "en-US") & "' height='" & _H & "' fill='#000' fill-opacity='0'/>"
			& "<line class='hl' x1='" & FORMAT(_x, _F1, "en-US") & "' x2='" & FORMAT(_x, _F1, "en-US") & "' y1='" & (_PT - 8) & "' y2='" & (_H - _PB) & "' stroke='" & [Style Couleur neutre] & "' stroke-dasharray='3 3' pointer-events='none'/>"
			& "<g class='ptip' pointer-events='none'><rect x='" & FORMAT(_PosX, _F1, "en-US") & "' y='" & _PosY & "' width='" & _LargeurBulle & "' height='" & _HB & "' rx='8' fill='#FFFFFF' stroke='" & [Style Couleur bordure] & "' filter='url(#omb)'/>"
			& "<text x='" & FORMAT(_PosX + 12, _F1, "en-US") & "' y='" & (_PosY + 23) & "' font-size='" & _TxtTxt & "' font-weight='700' fill='" & _ColTxt & "'>" & T_AnneeAxe[Annee] & "<tspan font-weight='400' font-size='" & _TxtPet & "' fill='" & _ColAxe & "'> · base 100 en " & _A0 & "</tspan></text>"
			& SUBSTITUTE(_Ligne, "r=", "cy='" & (_PosY + 41) & "' r=") & _ColCourbe & "'/>" & _LigneB & FORMAT(_PosX + 27, _F1, "en-US") & "' y='" & (_PosY + 46) & "'>" & _NomSelB & " <tspan font-weight='700' fill='" & _ColTxt & "'>" & IF(ISBLANK([@s]), "n.c.", FORMAT([@s], "0.0")) & "</tspan></text>"
			& IF(_AvecReg, SUBSTITUTE(_Ligne, "r=", "cy='" & (_PosY + 62) & "' r=") & _ColReg & "'/>" & _LigneB & FORMAT(_PosX + 27, _F1, "en-US") & "' y='" & (_PosY + 67) & "'>" & _NomRegB & " <tspan font-weight='700' fill='" & _ColTxt & "'>" & IF(ISBLANK([@r]), "n.c.", FORMAT([@r], "0.0")) & "</tspan></text>")
			& IF(_AvecSel, SUBSTITUTE(_Ligne, "r=", "cy='" & (_PosY + 41 + 21 * IF(_AvecReg, 2, 1)) & "' r=") & _ColEns & "'/>" & _LigneB & FORMAT(_PosX + 27, _F1, "en-US") & "' y='" & (_PosY + 46 + 21 * IF(_AvecReg, 2, 1)) & "'>Ensemble des fédérations <tspan font-weight='700' fill='" & _ColTxt & "'>" & IF(ISBLANK([@e]), "n.c.", FORMAT([@e], "0.0")) & "</tspan></text>")
			& "<text x='" & FORMAT(_PosX + 12, _F1, "en-US") & "' y='" & (_PosY + _HB - 10) & "' font-size='13' fill='" & _ColAxe & "'>" & IF(ISBLANK([@s]), "n.c. : pas de licence en " & _A0 & " ou cette année", "Lecture : " & FORMAT([@s], "0") & " = " & FORMAT([@s] / 100 - 1, "+0 %;-0 %;0 %") & " par rapport à " & _A0) & "</text></g></g>",
			"", [@i], ASC)
			-- 7. Titre et légende
			VAR _Titre =
			"<div style='padding-right:" & _PlaceSegment & "px'>"
			& "<div style='" & [Style CSS ligne titre] & "'>"
			& "<span style='" & [Style CSS rubrique] & "'>ÉVOLUTION</span>"
			& "<span style='" & [Style CSS titre bloc] & "'>Nombre de licences depuis " & _A0 & "</span></div>"
			& "<div style='" & [Style CSS sous-titre] & "'>"
			& IF(_Vue = 1, "Licences par année", "Indice base 100 en " & _A0)
			& " · " & [Libellé territoire] & "</div></div>"
			VAR _Trait = "<span class='tt' style='display:inline-flex;align-items:center;gap:7px'><i style='flex:none;display:inline-block;width:16px;height:3px;border-radius:2px;background:"
			VAR _Carre = "<span style='display:inline-flex;align-items:center;gap:7px'><i style='flex:none;display:inline-block;width:11px;height:11px;border-radius:3px;background:"
			VAR _TipSel = IF(NOT ISBLANK(_Liste), "<span class='tip bas'><b>" & [Sélection nb fédérations] & " fédérations</b><br>" & _Liste & "</span>")
			-- légende FIXE en vue Base 100 : toujours 3 entrées (sélection / regroupement / ensemble),
			-- une entrée sans objet reste à sa place, grisée, avec la raison au survol
			VAR _Gris = "opacity:.4;"
			VAR _PourquoiPasReg =
			SWITCH(_Mode,
			"Ensemble",     "Choisissez une fédération pour la comparer à son regroupement.",
			"Regroupement", "La sélection est déjà un regroupement.",
			"Les fédérations choisies n'appartiennent pas au même regroupement.")
			VAR _EntreeSel =
			IF(_ModeReg,
			SUBSTITUTE(_Trait, "gap:7px", "gap:7px;" & _Gris) & _ColSel & "'></i>Fédération<span class='tip bas'>Aucune fédération choisie :<br>le regroupement entier est sélectionné.</span></span>",
			IF(_IndiceOk,
			_Trait & _ColSel & "'></i>" & _NomSel & _TipSel & "</span>",
			SUBSTITUTE(_Trait, "gap:7px", "gap:7px;" & _Gris) & _ColSel & "'></i>" & _NomSelB & " · n.c."
			& "<span class='tip bas'><b>Indice non calculable</b><br>" & _NomSel & " ne compte aucune licence en " & _A0 & ",<br>année de référence de l'indice.<br><span>Regroupement et ensemble restent affichés ; la vue Volume montre les licences.</span></span></span>"))
			VAR _EntreeReg =
			IF(_ModeReg,
			_Trait & _ColReg & "'></i>" & _NomSelB & "<span class='tip bas'><b>" & _NomSel & "</b><br>Regroupement sélectionné</span></span>",
			IF(_AvecReg,
			_Trait & _ColReg & "'></i>" & _NomRegB & "<span class='tip bas'><b>" & [Niveau choisi] & " · " & _NomReg & "</b><br>Regroupement de la sélection</span></span>",
			SUBSTITUTE(_Trait, "gap:7px", "gap:7px;" & _Gris) & _ColReg & "'></i>Regroupement<span class='tip bas'>" & _PourquoiPasReg & "</span></span>"))
			VAR _EntreeEns =
			IF(_AvecSel,
			_Trait & _ColEns & "'></i>Ensemble des fédérations</span>",
			SUBSTITUTE(_Trait, "gap:7px", "gap:7px;" & _Gris) & _ColEns & "'></i>Ensemble<span class='tip bas'>La sélection est déjà l'ensemble des fédérations.</span></span>")
			VAR _Legende =
			"<div style='display:flex;flex-wrap:nowrap;column-gap:18px;white-space:nowrap;" & [Style CSS légende] & ";margin:10px 0 4px 0;height:22px;align-items:center'>"
			& IF(_Vue = 1,
			_Carre & _ColSel & "'></i>Année choisie (" & _AnSel & ")</span>" & _Carre & _ColBar & "'></i>Autres années</span>"
			& "<span class='tt' style='color:" & _ColAxe & "'>" & _NomSel & _TipSel & "</span>",
			_EntreeSel & _EntreeReg & _EntreeEns)
			& "</div>"
			-- 8. Messages (seulement si rien n'est traçable)
			VAR _Message = "<div style='flex:1;margin-top:14px;border:1.5px dashed " & [Style Couleur bordure forte] & ";border-radius:10px;display:flex;flex-direction:column;gap:4px;align-items:center;justify-content:center;text-align:center;padding:0 30px;font-size:" & _TxtTxt & "px;color:" & [Style Couleur texte libellé] & "'>"
			VAR _SansDonnees = _Message & "<b style='color:" & _ColTxt & "'>Aucune licence pour cette sélection</b><span style='font-size:" & _TxtPet & "px'>Élargissez un filtre (fédération, territoire, public) pour afficher l'évolution.</span></div>"
			VAR _IndiceKo = _Message & "<b style='color:" & _ColTxt & "'>Indice base 100 non calculable</b><span style='font-size:" & _TxtPet & "px'>Aucune licence en " & _A0 & ", année de référence de l'indice. Passez en vue Volume pour voir les licences par année.</span></div>"
			-- 9. Assemblage
			VAR _Svg =
			IF(_Vue = 1,
			_GrilleV & _Barres & _AnneesV & _BullesV,
			_Bande & _GrilleB
			& IF(_Y100 >= _PT && _Y100 <= _H - _PB, "<line x1='" & _PL & "' x2='" & (_W - _PR + 24) & "' y1='" & FORMAT(_Y100, _F1, "en-US") & "' y2='" & FORMAT(_Y100, _F1, "en-US") & "' stroke='" & [Style Couleur bordure forte] & "' stroke-dasharray='3 3'/>")
			& _AnneesB & _Traces & _Marqueurs & _Pastilles & _BullesB)
			VAR _Corps =
			SWITCH(TRUE(),
			_Vue = 1 && ISBLANK(_VMax), _Legende & _SansDonnees,
			_Vue <> 1 && ISEMPTY(_Vals), _Legende & _IndiceKo,
			_Legende
			& "<div style='flex:1;min-height:0'><svg viewBox='0 0 " & _W & " " & _H & "' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' font-family='" & _Police & "' style='display:block;overflow:visible'>" & _Ombre & _Svg & "</svg></div>")
			RETURN
			_Css
			& "<div style='" & [Style CSS cadre] & ";height:" & _HauteurCadre & "px;color:" & _ColTxt & "'>"
			& _Titre & _Corps & "</div>"
		displayFolder: 6. Portrait\HTML
		lineageTag: 513884f8-b6b6-4bf8-86f7-248dcf73c517

	/// En-tête de page sur deux lignes (visuel HTML Content). Ligne 1 = identité : logo, type, nom, famille / sous-famille / groupe. Ligne 2 = barre « Votre sélection » : territoire et année (texte avec icône), genre et âge en pastilles orange s'ils sont choisis.
	measure 'HTML En-tête' =
			-- =====================================================================
			-- HTML En-tête | haut de page Portrait | visuel HTML Content ~1527 x 150 (marges 0)
			-- Ligne 1 : identité de la sélection (logo, nom, rattachement ou nombre de fédérations)
			-- Ligne 2 : barre « Votre sélection » (territoire, année, public)
			-- Mise en page FIXE : mêmes lignes et mêmes emplacements quels que soient les segments.
			-- Hauteur bloquée (100vh + overflow:hidden) : jamais de barre de défilement ;
			-- les infobulles de la ligne 2 s'ouvrent donc vers le haut.
			-- Dépend de : Sélection mode / libellé / liste / nb fédérations, Libellé territoire, charte
			-- =====================================================================
			-- 1. Réglages
			VAR _TailleLogo = 72           -- carré du logo (px)
			VAR _MargeLogo  = 8
			VAR _TailleNom  = 26
			-- 2. Charte
			VAR _Police  = [Style Police]
			VAR _ColTxt  = [Style Couleur texte]
			VAR _ColLib  = [Style Couleur texte libellé]
			VAR _ColDisc = [Style Couleur texte discret]
			VAR _ColBord = [Style Couleur bordure]
			VAR _ColFond = [Style Couleur fond cadre]
			VAR _ColReg  = [Style Couleur regroupement]
			-- 3. Contexte
			VAR _Mode    = [Sélection mode]
			VAR _UneFed  = _Mode = "Fédération"
			VAR _Logo    = IF(_UneFed, SELECTEDVALUE(T_Federation[Logo]))
			VAR _NomLong = IF(_UneFed, SELECTEDVALUE(T_Federation[Federation]), [Sélection libellé])
			VAR _AnRef   = MAX(T_Annee[Annee])
			VAR _Statut  = CALCULATE(MAX(T_Annee[Statut]), REMOVEFILTERS(T_Annee), T_Annee[Annee] = _AnRef)
			VAR _NbFed   = [Sélection nb fédérations]
			VAR _Terr    = [Libellé territoire]
			VAR _Genres  = IF(ISFILTERED(T_Sexe), CONCATENATEX(VALUES(T_Sexe[Genre]), T_Sexe[Genre], " + "))
			VAR _Ages    = IF(ISFILTERED(T_TrancheAge), CONCATENATEX(SUMMARIZE(T_TrancheAge, T_TrancheAge[Catégorie d'âge], T_TrancheAge[Ordre]), T_TrancheAge[Catégorie d'âge], " + ", T_TrancheAge[Ordre], ASC))
			-- 4. Gabarits
			VAR _Gras    = "<b style='color:" & _ColTxt & ";font-weight:600'>"
			VAR _Pastille = "<span class='tt' style='display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 11px;border-radius:13px;background:" & _ColFond & ";border:1px solid " & _ColBord & ";font-size:13px;color:" & _ColLib & ";white-space:nowrap'>"
			VAR _Ico     = "<svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='" & _ColDisc & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>"
			VAR _IcoTerr = _Ico & "<path d='M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z'/><circle cx='12' cy='9.5' r='2.5'/></svg>"
			VAR _IcoAn   = _Ico & "<rect x='4' y='5' width='16' height='15' rx='2'/><path d='M4 10h16M9 3v4M15 3v4'/></svg>"
			VAR _IcoPub  = _Ico & "<circle cx='9' cy='8' r='3.2'/><path d='M3 20c.7-3.4 3-5.2 6-5.2s5.3 1.8 6 5.2'/></svg>"
			VAR _IcoToutes = "<svg width='38' height='38' viewBox='0 0 24 24' fill='none' stroke='" & [Style Couleur icône] & "' stroke-width='1.8'><rect x='4' y='4' width='7' height='7' rx='1.5'/><rect x='13' y='4' width='7' height='7' rx='1.5'/><rect x='4' y='13' width='7' height='7' rx='1.5'/><rect x='13' y='13' width='7' height='7' rx='1.5'/></svg>"
			-- 5. Ligne 1 : identité
			VAR _Visuel =
			    IF(NOT ISBLANK(_Logo) && _Logo <> "",
			        "<img src='" & SUBSTITUTE(_Logo, "'", "%27") & "' style='max-width:" & (_TailleLogo - 2 * _MargeLogo) & "px;max-height:" & (_TailleLogo - 2 * _MargeLogo) & "px;object-fit:contain'/>",
			        _IcoToutes)
			VAR _Rattachement =      -- pastilles sous le nom : rattachement (une fédération) ou nombre de fédérations
			    SWITCH(_Mode,
			        "Fédération",
			            _Pastille & "Famille " & _Gras & SELECTEDVALUE(T_Federation[Famille de fédérations]) & "</b></span>"
			            & _Pastille & "Sous-famille " & _Gras & TRIM(SELECTEDVALUE(T_Federation[Sous-famille de fédérations])) & "</b></span>"
			            & _Pastille & "Groupe " & _Gras & SELECTEDVALUE(T_Federation[Groupe de fédérations]) & "</b></span>",
			        "Regroupement",
			            _Pastille & "<i style='width:8px;height:8px;border-radius:50%;background:" & _ColReg & "'></i>" & [Niveau choisi] & " " & _Gras & _NomLong & "</b></span>"
			            & _Pastille & _Gras & _NbFed & "</b> fédération" & IF(_NbFed > 1, "s") & "<span class='tip bas'>" & [Sélection liste] & "</span></span>",
			        "Plusieurs fédérations",
			            _Pastille & _Gras & _NbFed & "</b> fédérations choisies<span class='tip bas'>" & [Sélection liste] & "</span></span>",
			        _Pastille & _Gras & _NbFed & "</b> fédérations agréées en " & _AnRef & "</span>")
			VAR _Ligne1 =
			    "<div style='display:flex;align-items:center;gap:18px'>"
			    & "<div style='width:" & _TailleLogo & "px;height:" & _TailleLogo & "px;flex:none;border-radius:16px;background:#FFFFFF;border:1px solid " & _ColBord & ";box-shadow:0 1px 2px rgba(16,24,40,.05);display:flex;align-items:center;justify-content:center'>" & _Visuel & "</div>"
			    & "<div style='min-width:0;flex:1'>"
			    & "<div class='tt' style='display:flex;min-width:0'><span class='el' style='font-size:" & _TailleNom & "px;font-weight:700;color:" & _ColTxt & ";line-height:1.2;letter-spacing:-.01em'>" & SUBSTITUTE(_NomLong, "&", "&amp;") & "</span>"
			    & "<span class='tip bas'><b>" & SUBSTITUTE(_NomLong, "&", "&amp;") & "</b>" & IF(_Mode = "Plusieurs fédérations", "<br>" & [Sélection liste]) & "</span></div>"
			    & "<div style='display:flex;gap:8px;flex-wrap:nowrap;overflow:hidden;margin-top:8px'>" & _Rattachement & "</div>"
			    & "</div></div>"
			-- 6. Ligne 2 : votre sélection (territoire, année, public)
			VAR _Elem   = "<span class='tt' style='display:inline-flex;align-items:center;gap:6px;font-size:14px;color:" & _ColLib & ";white-space:nowrap'>"
			VAR _Sep    = "<span style='flex:none;width:4px;height:4px;border-radius:50%;background:" & [Style Couleur bordure forte] & "'></span>"
			VAR _Actif  = "<span style='display:inline-flex;align-items:center;gap:7px;height:26px;padding:0 11px;border-radius:13px;background:" & [Style Couleur filtre actif fond] & ";border:1px solid " & [Style Couleur filtre actif bordure] & ";font-size:13px;color:" & [Style Couleur filtre actif texte] & ";font-weight:600;white-space:nowrap'><i style='width:7px;height:7px;border-radius:50%;background:" & [Style Couleur filtre actif point] & "'></i>"
			VAR _SemiDef = CONTAINSSTRING(_Statut, "semi")
			VAR _Public =
			    IF(ISBLANK(_Genres) && ISBLANK(_Ages),
			        _Elem & _IcoPub & "Tous publics</span>",
			        _Elem & _IcoPub & "Public</span>" & IF(NOT ISBLANK(_Genres), _Actif & _Genres & "</span>") & IF(NOT ISBLANK(_Ages), _Actif & _Ages & "</span>"))
			VAR _Ligne2 =
			    "<div style='display:flex;align-items:center;gap:14px;margin-top:12px;padding:0 14px;height:42px;flex:none;border-radius:10px;background:" & _ColFond & ";border:1px solid " & _ColBord & "'>"
			    & "<span style='font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:" & _ColDisc & ";white-space:nowrap'>Votre sélection</span>"
			    & _Elem & _IcoTerr & _Gras & _Terr & "</b></span>" & _Sep
			    & _Elem & _IcoAn & _Gras & _AnRef & "</b>" & IF(_SemiDef, " · semi-définitive<span class='tip'>Données " & _AnRef & " semi-définitives :<br>elles peuvent encore être légèrement révisées.</span>") & "</span>" & _Sep
			    & _Public
			    & "</div>"
			-- 7. Assemblage (hauteur bloquée : aucun défilement)
			RETURN
			    [Style CSS commun]
			    & "<div style='font-family:" & _Police & ";display:flex;flex-direction:column;justify-content:center;height:100vh;overflow:hidden;padding:1px'>"
			    & _Ligne1 & _Ligne2 & "</div>"
		displayFolder: 2. Affichage
		lineageTag: beec849e-ca2c-46e7-b673-19d01a7e8063

	/// Niveau affiché sur la carte : 1 = régions, 2 = départements (segment T_NiveauGeo). Un département choisi dans le segment Département force le niveau 2.
	measure 'Carte Niveau' =
			VAR _NiveauSegment = SELECTEDVALUE(T_NiveauGeo[Ordre], 1)
			RETURN IF(ISFILTERED(P_TerrDep), 2, _NiveauSegment)
		formatString: 0
		displayFolder: 6. Portrait\Carte
		lineageTag: 96830fee-5c0c-4af5-b580-77e19c2349da

	/// Rôle de la zone : Zone (remplie), Sélection (remplie + contour mis en évidence), Contour (contour seul). Vient de T_CarteAffichage ; un département choisi dans le segment Département passe en Sélection.
	measure 'Carte Rôle' =
			VAR _Niv = [Carte Niveau]
			-- Territoire choisi : segment sur Param_Departement (ou P_TerrChoix), d'où ISCROSSFILTERED
			VAR _RoleTable =
			    IF(ISCROSSFILTERED(P_TerrChoix),
			        CALCULATE(MAX(T_CarteAffichage[Rôle]), T_CarteAffichage[Niveau affiché] = _Niv),
			        "Zone")
			VAR _Ids      = VALUES(T_CarteAffichage[Id carte])
			VAR _DepsZone = SELECTCOLUMNS(FILTER(T_CarteZoneDep, T_CarteZoneDep[Id carte] IN _Ids), "Code_DEP", T_CarteZoneDep[Code_DEP])
			VAR _DepChoisi =
			    ISFILTERED(P_TerrDep)
			        && LEFT(SELECTEDVALUE(T_CarteAffichage[Id carte]), 1) = "D"
			        && NOT ISEMPTY(INTERSECT(_DepsZone, VALUES(T_Territoire[Code_DEP])))
			RETURN IF(HASONEVALUE(T_CarteAffichage[Id carte]), IF(_DepChoisi, "Sélection", _RoleTable))
		displayFolder: 6. Portrait\Carte
		lineageTag: e8977879-f5fb-406c-99b9-23d3d40ef20f

	/// Couleur du contour des zones (Azure Maps, fx valeur de champ) : bleu nuit pour la sélection, blanc sinon.
	measure 'Carte Contour couleur' = ```
			-- Charte commune (dossier 0. Style)
			-- Sélection : bleu nuit foncé, lisible sur les palettes indigo, rouge/vert et gris
			VAR _CouleurSelection = "#0B1B4D"
			VAR _CouleurZone      = "rgba(0, 0, 0, 0.1)"
			RETURN SWITCH([Carte Rôle], "Sélection", _CouleurSelection, "Contour", _CouleurSelection, _CouleurZone)
			
			```
		displayFolder: 6. Portrait\Carte
		lineageTag: 96f6af54-861d-4b53-bae1-6b338ac28b5b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Charte commune des visuels HTML : police.
	measure 'Style Police' = "Segoe UI, sans-serif"
		displayFolder: 0. Style\Couleurs et police
		lineageTag: 60db0db5-cc39-49c9-b4a8-1e883efac808

	/// Charte : texte principal (titres, valeurs).
	measure 'Style Couleur texte' = "#101828"
		displayFolder: 0. Style\Couleurs et police
