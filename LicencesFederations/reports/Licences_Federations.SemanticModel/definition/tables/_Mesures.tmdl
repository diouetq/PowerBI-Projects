	/// Licences de l'année de référence sur les seules fédérations à champ constant (T_Federation[Champ constant] = Oui), base de toutes les évolutions. Si la sélection ne contient aucune fédération à champ constant (une fédération récente seule), on garde toutes ses licences : son évolution reste la sienne.
	measure 'Licences champ constant' =
			-- Base des évolutions : fédérations présentes chaque année de la période (champ constant, méthode INJEP).
			-- Les volumes affichés ([NB Licences]) restent sur toutes les fédérations.
			VAR _AvecCC = NOT ISEMPTY(CALCULATETABLE(VALUES(F_Licences[CodeReference]), REMOVEFILTERS(T_Annee), KEEPFILTERS(T_Federation[Champ constant] = "Oui")))
			RETURN IF(_AvecCC, CALCULATE([NB Licences], KEEPFILTERS(T_Federation[Champ constant] = "Oui")), [NB Licences])
		formatString: #,0
		displayFolder: 02. Évolutions
		lineageTag: 12032609-0447-4d17-8f6d-bc4804c7d45f

	/// Phrase affichée sous les évolutions quand la sélection contient des fédérations hors champ constant : nombre de fédérations retenues, fédérations exclues et leurs licences (pour qu'un lecteur qui refait la somme retrouve le total). Vide sinon.
	measure 'Champ constant mention' =
			VAR _AnMin  = MINX(ALL(T_Annee[Annee]), VALUE(T_Annee[Annee]))
			VAR _AnMax  = MAXX(ALL(T_Annee[Annee]), VALUE(T_Annee[Annee]))
			VAR _An     = MAX(T_Annee[Annee])
			VAR _NbCC   = CALCULATE(DISTINCTCOUNT(F_Licences[CodeReference]), REMOVEFILTERS(T_Annee), KEEPFILTERS(T_Federation[Champ constant] = "Oui"))
			VAR _NbHors = CALCULATE(DISTINCTCOUNT(F_Licences[CodeReference]), KEEPFILTERS(T_Federation[Champ constant] = "Non"))
			VAR _LicHors = CALCULATE([NB Licences], KEEPFILTERS(T_Federation[Champ constant] = "Non"))
			RETURN
			    IF(_NbCC > 0 && _NbHors > 0,
			        "Évolutions à champ constant (méthode INJEP) : " & _NbCC & " fédérations présentes chaque année de " & _AnMin & " à " & _AnMax & ". "
			        & IF(_NbHors > 1, _NbHors & " fédérations hors champ constant sont exclues des évolutions", "1 fédération hors champ constant est exclue des évolutions")
			        & " (" & FORMAT(_LicHors, "#,0") & " licences en " & _An & "), mais comptées dans les volumes.")
		displayFolder: 02. Évolutions
		lineageTag: cce59521-374b-4458-abf6-0601186268ba

	/// Licences à champ constant pour l'année de l'axe T_AnneeAxe (base de l'évolution sur 1 an dans les bulles du graphique Évolution).
	measure 'Evo Licences champ constant' =
			CALCULATE(
			    [Licences champ constant],
			    REMOVEFILTERS(T_Annee),
			    TREATAS(VALUES(T_AnneeAxe[Annee]), T_Annee[Annee])
			)
		formatString: #,0
		isHidden
		displayFolder: 07. Page Portrait\Évolution
		lineageTag: bee52411-e1f2-4cd6-bbb1-6d294c975c28

	/// Version courte (HTML, 2 lignes) de Champ constant mention, pour les infobulles des blocs HTML (Chiffres clés, Évolution). Vide quand la sélection ne contient aucune fédération hors champ constant.
	measure 'Champ constant note' =
			VAR _AnMin  = MINX(ALL(T_Annee[Annee]), VALUE(T_Annee[Annee]))
			VAR _AnMax  = MAXX(ALL(T_Annee[Annee]), VALUE(T_Annee[Annee]))
			VAR _An     = MAX(T_Annee[Annee])
			VAR _NbCC   = CALCULATE(DISTINCTCOUNT(F_Licences[CodeReference]), REMOVEFILTERS(T_Annee), KEEPFILTERS(T_Federation[Champ constant] = "Oui"))
			VAR _NbHors = CALCULATE(DISTINCTCOUNT(F_Licences[CodeReference]), KEEPFILTERS(T_Federation[Champ constant] = "Non"))
			VAR _LicHors = CALCULATE([NB Licences], KEEPFILTERS(T_Federation[Champ constant] = "Non"))
			RETURN
			    IF(_NbCC > 0 && _NbHors > 0,
			        "Évolution à champ constant (méthode INJEP) : " & _NbCC & " fédérations présentes de " & _AnMin & " à " & _AnMax & ".<br>"
			        & "Hors champ constant : " & _NbHors & IF(_NbHors > 1, " fédérations", " fédération") & " (" & FORMAT(_LicHors, "#,0") & " licences en " & _An & ").")
		displayFolder: 02. Évolutions
		lineageTag: 58e93db1-7a25-4578-8105-a4feae5093d9

	/// Colonne technique (table de mesures).
	column _
		isHidden
		lineageTag: d2cf5779-78ce-4624-8c0d-6ed2b896cdd8
		isNameInferred
		sourceColumn: [_]

	partition _Mesures = calculated
		mode: import
		source = ROW("_", BLANK())

