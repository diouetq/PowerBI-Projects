	/// Tableau HTML interactif de comparaison des territoires (même moteur [HTML Tableau JS] et mêmes styles [HTML Comparaison CSS] que HTML Comparaison Federations).
	measure 'HTML Comparaison Territoires' =
			-- =====================================================================
			-- HTML Comparaison Territoires | visuel HTML Content (edition standard, scripts actifs)
			-- Meme moteur ([HTML Tableau JS]) et memes styles ([HTML Comparaison CSS]) que HTML Comparaison Federations.
			-- Lignes = departements regroupes par region ; DROM, COM et Autres forment chacun une categorie. Tous les departements sont affiches, meme a 0.
			-- Metropole / Metropole + DROM choisis = tableau limite a ce perimetre ; region (avec ou sans departement) choisie = par region (choix en haut, deplie,
			-- departement surligne) ; departement seul = surligne dans la liste. Niveau geo = Region -> liste des regions (sauf departement / DROM / COM / Autres choisi).
			-- Segment Region / zone = Param_Departement (relie a P_TerrChoix) ; segment Departement = P_TerrDep.
			-- Les segments federation filtrent les chiffres. Colonne finale : Specificite (selection de federations) ou 1re federation (ensemble).
			-- TAILLE : rester sous ~31 000 caracteres (verifier LEN apres modification).
			-- =====================================================================
			VAR _AnRef  = 2019
			VAR _An     = VALUE(MAX(T_Annee[Annee]))
			VAR _Sx     = IF(ISFILTERED(T_Sexe), CONCATENATEX(VALUES(T_Sexe[Sexe]), T_Sexe[Sexe], ","))
			VAR _Ag     = IF(ISFILTERED(T_TrancheAge), CONCATENATEX(VALUES(T_TrancheAge[Ordre]), T_TrancheAge[Ordre], ","))
			VAR _GeL    = IF(ISFILTERED(T_Sexe), CONCATENATEX(VALUES(T_Sexe[Genre]), T_Sexe[Genre], " + "))
			VAR _AgL    = IF(ISFILTERED(T_TrancheAge), CONCATENATEX(SUMMARIZE(T_TrancheAge, T_TrancheAge[Catégorie d'âge], T_TrancheAge[Ordre]), T_TrancheAge[Catégorie d'âge], " + ", T_TrancheAge[Ordre], ASC))
			VAR _B64    = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-_"
			VAR _DepSel = ISFILTERED(P_TerrDep)
			VAR _IdSel  = IF(ISFILTERED(Param_Departement) || ISFILTERED(P_TerrChoix), SELECTEDVALUE(P_TerrChoix[Id territoire]))
			VAR _RegCh  = NOT ISBLANK(_IdSel) && NOT (_IdSel IN {"TOT", "MDR", "MET"})
			VAR _Fil    = ISCROSSFILTERED(T_Territoire) && (_DepSel || _RegCh)
			VAR _SelSet = VALUES(T_Territoire[Code_DEP])
			-- par region si une region (ou DROM / COM / Autres) est choisie, avec ou sans departement ; departement seul = liste
			VAR _RG     = _Fil && (_RegCh || NOT _DepSel)
			VAR _LV     = IF(SELECTEDVALUE(T_NiveauGeo[Ordre], 2) = 1 && [Segment Niveau géo masqué] <> 1, "g", "i")
			VAR _NSel   = CALCULATE(DISTINCTCOUNT(F_Licences[CodeReference]), REMOVEFILTERS(T_Territoire), REMOVEFILTERS(P_TerrChoix), REMOVEFILTERS(P_TerrAppartenance), REMOVEFILTERS(P_TerrDep), REMOVEFILTERS(Param_Departement), REMOVEFILTERS(T_Annee), F_Licences[Annee] = _An)
			VAR _NAll   = CALCULATE(DISTINCTCOUNT(F_Licences[CodeReference]), REMOVEFILTERS(T_Territoire), REMOVEFILTERS(P_TerrChoix), REMOVEFILTERS(P_TerrAppartenance), REMOVEFILTERS(P_TerrDep), REMOVEFILTERS(Param_Departement), REMOVEFILTERS(T_Federation), REMOVEFILTERS(P_Federation), REMOVEFILTERS(P_Niveaux), REMOVEFILTERS(P_Appartenance), REMOVEFILTERS(Param_Federation), REMOVEFILTERS(T_Annee), F_Licences[Annee] = _An)
			VAR _FS     = _NSel < _NAll
			-- departements et categorie (region de metropole ; DROM ; COM ; Autres = Monaco, etranger, non reparti)
			VAR _D =
			    ADDCOLUMNS(
			        FILTER(ALL(T_Territoire[Code_DEP], T_Territoire[Departement], T_Territoire[Region], T_Territoire[Code_GDEREG]), NOT ISBLANK(T_Territoire[Code_DEP])),
			        "@g", VAR _r = T_Territoire[Code_GDEREG]
			              RETURN SWITCH(TRUE(), _r = "COM", "Collectivités d'outre-mer", _r IN {"980", "ETR", "NR"}, "Autres (Monaco, étranger, non réparti)",
			                         _r IN {"01", "02", "03", "04", "06"}, "DROM", TRIM(MID(T_Territoire[Region], SEARCH(" - ", T_Territoire[Region], 1, 0) + 3, 100))),
			        "@k", VAR _r = T_Territoire[Code_GDEREG] RETURN SWITCH(TRUE(), _r IN {"01", "02", "03", "04", "06"}, "D", _r IN {"COM", "980", "ETR", "NR"}, "A", "M"))
			-- perimetre : Metropole (MET) ou Metropole + DROM (MDR) choisis = seulement ces departements ; sinon tous
			VAR _D2 = FILTER(_D, SWITCH(_IdSel, "MET", [@k] = "M", "MDR", [@k] <> "A", TRUE()))
			VAR _DC = SELECTCOLUMNS(_D2, "@d", T_Territoire[Code_DEP])
			VAR _TN = SWITCH(_IdSel, "MET", "Métropole", "MDR", "Métropole + DROM", "Total")
			-- champ constant (methode INJEP) : la selection compte-t-elle des federations presentes chaque annee ?
			VAR _CCA = NOT ISEMPTY(CALCULATETABLE(VALUES(F_Licences[CodeReference]), REMOVEFILTERS(T_Territoire), REMOVEFILTERS(P_TerrChoix), REMOVEFILTERS(P_TerrAppartenance), REMOVEFILTERS(P_TerrDep), REMOVEFILTERS(Param_Departement), REMOVEFILTERS(T_Annee), KEEPFILTERS(T_Federation[Champ constant] = "Oui")))
			VAR _S =
			    ADDCOLUMNS(
			        CALCULATETABLE(
			            SUMMARIZECOLUMNS(F_Licences[Code_DEP], F_Licences[Annee], "@n", SUM(F_Licences[NbLicences]), "@x", CALCULATE(SUM(F_Licences[NbLicences]), KEEPFILTERS(T_Federation[Champ constant] = "Non"))),
			            REMOVEFILTERS(T_Territoire), REMOVEFILTERS(P_TerrChoix), REMOVEFILTERS(P_TerrAppartenance), REMOVEFILTERS(P_TerrDep), REMOVEFILTERS(Param_Departement), REMOVEFILTERS(T_Annee)),
			        "@b", (VAR _n0 = INT([@n] + 0) RETURN MID(MID(_B64, MOD(INT(_n0 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n0 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n0 / 64), 64) + 1, 1) & MID(_B64, MOD(_n0, 64) + 1, 1), (_n0 < 262144) + (_n0 < 4096) + (_n0 < 64) + 1, 4)), "@bx", (VAR _nx = INT([@x] + 0) RETURN MID(MID(_B64, MOD(INT(_nx / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_nx / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_nx / 64), 64) + 1, 1) & MID(_B64, MOD(_nx, 64) + 1, 1), (_nx < 262144) + (_nx < 4096) + (_nx < 64) + 1, 4)))
			VAR _P =
			    ADDCOLUMNS(
			        CALCULATETABLE(
			            SUMMARIZECOLUMNS(F_Licences[Code_DEP],
			                "@f", CALCULATE(SUM(F_Licences[NbLicences]), REMOVEFILTERS(T_Sexe), F_Licences[Sexe] = "F"),
			                "@h", CALCULATE(SUM(F_Licences[NbLicences]), REMOVEFILTERS(T_Sexe), F_Licences[Sexe] = "H"),
			                "@a1", CALCULATE(SUM(F_Licences[NbLicences]), REMOVEFILTERS(T_TrancheAge), T_TrancheAge[Ordre] = "1"),
			                "@a2", CALCULATE(SUM(F_Licences[NbLicences]), REMOVEFILTERS(T_TrancheAge), T_TrancheAge[Ordre] = "2"),
			                "@a3", CALCULATE(SUM(F_Licences[NbLicences]), REMOVEFILTERS(T_TrancheAge), T_TrancheAge[Ordre] = "3"),
			                "@a4", CALCULATE(SUM(F_Licences[NbLicences]), REMOVEFILTERS(T_TrancheAge), T_TrancheAge[Ordre] = "4"),
			                "@np", CALCULATE(SUM(F_Licences[NbLicences]), KEEPFILTERS(TREATAS(ALL(F_Population[Code_DEP]), T_Territoire[Code_DEP])))),
			            REMOVEFILTERS(T_Territoire), REMOVEFILTERS(P_TerrChoix), REMOVEFILTERS(P_TerrAppartenance), REMOVEFILTERS(P_TerrDep), REMOVEFILTERS(Param_Departement), REMOVEFILTERS(T_Annee), F_Licences[Annee] = _An),
			        "@b", (VAR _n1 = INT([@f] + 0) RETURN MID(MID(_B64, MOD(INT(_n1 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n1 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n1 / 64), 64) + 1, 1) & MID(_B64, MOD(_n1, 64) + 1, 1), (_n1 < 262144) + (_n1 < 4096) + (_n1 < 64) + 1, 4)) & "." & (VAR _n2 = INT([@h] + 0) RETURN MID(MID(_B64, MOD(INT(_n2 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n2 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n2 / 64), 64) + 1, 1) & MID(_B64, MOD(_n2, 64) + 1, 1), (_n2 < 262144) + (_n2 < 4096) + (_n2 < 64) + 1, 4)) & "." & (VAR _n3 = INT([@a1] + 0) RETURN MID(MID(_B64, MOD(INT(_n3 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n3 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n3 / 64), 64) + 1, 1) & MID(_B64, MOD(_n3, 64) + 1, 1), (_n3 < 262144) + (_n3 < 4096) + (_n3 < 64) + 1, 4)) & "." & (VAR _n4 = INT([@a2] + 0) RETURN MID(MID(_B64, MOD(INT(_n4 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n4 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n4 / 64), 64) + 1, 1) & MID(_B64, MOD(_n4, 64) + 1, 1), (_n4 < 262144) + (_n4 < 4096) + (_n4 < 64) + 1, 4)) & "." & (VAR _n5 = INT([@a3] + 0) RETURN MID(MID(_B64, MOD(INT(_n5 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n5 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n5 / 64), 64) + 1, 1) & MID(_B64, MOD(_n5, 64) + 1, 1), (_n5 < 262144) + (_n5 < 4096) + (_n5 < 64) + 1, 4)) & "." & (VAR _n6 = INT([@a4] + 0) RETURN MID(MID(_B64, MOD(INT(_n6 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n6 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n6 / 64), 64) + 1, 1) & MID(_B64, MOD(_n6, 64) + 1, 1), (_n6 < 262144) + (_n6 < 4096) + (_n6 < 64) + 1, 4)) & "." & (VAR _n7 = INT([@np] + 0) RETURN MID(MID(_B64, MOD(INT(_n7 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n7 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n7 / 64), 64) + 1, 1) & MID(_B64, MOD(_n7, 64) + 1, 1), (_n7 < 262144) + (_n7 < 4096) + (_n7 < 64) + 1, 4)))
			VAR _Q =
			    ADDCOLUMNS(
			        CALCULATETABLE(
			            SUMMARIZECOLUMNS(T_Territoire[Code_DEP], "@q", [Population],
			                "@t", CALCULATE(SUM(F_Licences[NbLicences]), REMOVEFILTERS(T_Federation), REMOVEFILTERS(P_Federation), REMOVEFILTERS(P_Niveaux), REMOVEFILTERS(P_Appartenance), REMOVEFILTERS(Param_Federation), REMOVEFILTERS(T_Annee), F_Licences[Annee] = _An)),
			            REMOVEFILTERS(T_Territoire), REMOVEFILTERS(P_TerrChoix), REMOVEFILTERS(P_TerrAppartenance), REMOVEFILTERS(P_TerrDep), REMOVEFILTERS(Param_Departement)),
			        "@b", (VAR _n8 = INT([@q] + 0) RETURN MID(MID(_B64, MOD(INT(_n8 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n8 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n8 / 64), 64) + 1, 1) & MID(_B64, MOD(_n8, 64) + 1, 1), (_n8 < 262144) + (_n8 < 4096) + (_n8 < 64) + 1, 4)) & IF(_FS, "." & (VAR _n9 = INT([@t] + 0) RETURN MID(MID(_B64, MOD(INT(_n9 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n9 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n9 / 64), 64) + 1, 1) & MID(_B64, MOD(_n9, 64) + 1, 1), (_n9 < 262144) + (_n9 < 4096) + (_n9 < 64) + 1, 4)), ""))
			VAR _Yrs = FILTER(SELECTCOLUMNS(ALL(T_Annee[Annee]), "@y", VALUE(T_Annee[Annee])), VAR _yy = [@y] RETURN SUMX(FILTER(_S, F_Licences[Annee] = _yy), [@n]) > 0)
			-- tous les departements presents dans les donnees, meme a 0 pour la selection (ligne toujours affichee)
			VAR _AllD = CALCULATETABLE(VALUES(F_Licences[Code_DEP]), REMOVEFILTERS())
			VAR _B = FILTER(ADDCOLUMNS(_D2, "@Lic", VAR _k = T_Territoire[Code_DEP] RETURN SUMX(FILTER(_S, F_Licences[Code_DEP] = _k && F_Licences[Annee] = _An), [@n]) + 0), T_Territoire[Code_DEP] IN _AllD)
			VAR _Cats = DISTINCT(SELECTCOLUMNS(_B, "@c", [@g]))
			VAR _G = CONCATENATEX(_Cats, "'" & SUBSTITUTE([@c], "'", "\'") & "'", ",", [@c], ASC)
			-- 1re federation (seulement sans selection de federations), dans le perimetre
			VAR _TF =
			    FILTER(CALCULATETABLE(
			        SUMMARIZECOLUMNS(F_Licences[Code_DEP], F_Licences[CodeReference], "@n", SUM(F_Licences[NbLicences])),
			        REMOVEFILTERS(T_Territoire), REMOVEFILTERS(P_TerrChoix), REMOVEFILTERS(P_TerrAppartenance), REMOVEFILTERS(P_TerrDep), REMOVEFILTERS(Param_Departement), REMOVEFILTERS(T_Annee), F_Licences[Annee] = _An), F_Licences[Code_DEP] IN _DC)
			VAR _TFG =
			    GROUPBY(
			        ADDCOLUMNS(_TF, "@g", VAR _k = F_Licences[Code_DEP] RETURN MAXX(FILTER(_D, T_Territoire[Code_DEP] = _k), [@g])),
			        [@g], F_Licences[CodeReference], "@s", SUMX(CURRENTGROUP(), [@n]))
			VAR _TFT = GROUPBY(_TF, F_Licences[CodeReference], "@s", SUMX(CURRENTGROUP(), [@n]))
			VAR _TopD = ADDCOLUMNS(SELECTCOLUMNS(_B, "@d", T_Territoire[Code_DEP]), "@c", VAR _k = [@d] RETURN MAXX(TOPN(1, FILTER(_TF, F_Licences[Code_DEP] = _k), [@n], DESC), F_Licences[CodeReference]), "@v", VAR _k = [@d] RETURN MAXX(FILTER(_TF, F_Licences[Code_DEP] = _k), [@n]))
			VAR _TopG = ADDCOLUMNS(_Cats, "@tc", VAR _g = [@c] RETURN MAXX(TOPN(1, FILTER(_TFG, [@g] = _g), [@s], DESC), F_Licences[CodeReference]), "@tv", VAR _g = [@c] RETURN MAXX(FILTER(_TFG, [@g] = _g), [@s]))
			VAR _TopT = TOPN(1, _TFT, [@s], DESC)
			VAR _Codes = DISTINCT(UNION(SELECTCOLUMNS(_TopD, "@x", [@c]), SELECTCOLUMNS(_TopG, "@x", [@tc]), SELECTCOLUMNS(_TopT, "@x", F_Licences[CodeReference])))
			VAR _FN = IF(_FS, "", CONCATENATEX(_Codes, "'" & SUBSTITUTE(COALESCE(LOOKUPVALUE(T_Federation[Nom court], T_Federation[CodeReference], [@x]), LOOKUPVALUE(T_Federation[Federation], T_Federation[CodeReference], [@x]), [@x]), "'", "\'") & "'", ",", [@x], ASC))
			VAR _GT = IF(_FS, "", CONCATENATEX(_Cats, VAR _g = [@c] VAR _tc = MAXX(FILTER(_TopG, [@c] = _g), [@tc]) VAR _tv = MAXX(FILTER(_TopG, [@c] = _g), [@tv])
			            RETURN IF(ISBLANK(_tc), "''", "'" & COUNTROWS(FILTER(_Codes, [@x] < _tc)) + 0 & "." & (VAR _n10 = INT(_tv + 0) RETURN MID(MID(_B64, MOD(INT(_n10 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n10 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n10 / 64), 64) + 1, 1) & MID(_B64, MOD(_n10, 64) + 1, 1), (_n10 < 262144) + (_n10 < 4096) + (_n10 < 64) + 1, 4)) & "'"), ",", [@c], ASC))
			VAR _TT = IF(_FS, "", VAR _tc = MAXX(_TopT, F_Licences[CodeReference]) VAR _tv = MAXX(_TopT, [@s]) RETURN COUNTROWS(FILTER(_Codes, [@x] < _tc)) + 0 & "." & (VAR _n11 = INT(_tv + 0) RETURN MID(MID(_B64, MOD(INT(_n11 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n11 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n11 / 64), 64) + 1, 1) & MID(_B64, MOD(_n11, 64) + 1, 1), (_n11 < 262144) + (_n11 < 4096) + (_n11 < 64) + 1, 4)))
			VAR _F =
			    CONCATENATEX(_B,
			        VAR _k  = T_Territoire[Code_DEP]
			        VAR _c  = [@g]
			        VAR _ci = COUNTROWS(FILTER(_Cats, [@c] < _c)) + 0
			        VAR _se = CONCATENATEX(_Yrs, VAR _yy = [@y] RETURN COALESCE(MAXX(FILTER(_S, F_Licences[Code_DEP] = _k && F_Licences[Annee] = _yy), [@b]), "0"), ".", [@y], ASC)
			        VAR _pp = COALESCE(MAXX(FILTER(_P, F_Licences[Code_DEP] = _k), [@b]), "0.0.0.0.0.0.0")
			        VAR _qt = COALESCE(MAXX(FILTER(_Q, T_Territoire[Code_DEP] = _k), [@b]), "0")
			        VAR _tp = IF(_FS, "", VAR _tc = MAXX(FILTER(_TopD, [@d] = _k), [@c]) VAR _tv = MAXX(FILTER(_TopD, [@d] = _k), [@v])
			                    RETURN IF(ISBLANK(_tc), "", COUNTROWS(FILTER(_Codes, [@x] < _tc)) + 0 & "." & (VAR _n12 = INT(_tv + 0) RETURN MID(MID(_B64, MOD(INT(_n12 / 262144), 64) + 1, 1) & MID(_B64, MOD(INT(_n12 / 4096), 64) + 1, 1) & MID(_B64, MOD(INT(_n12 / 64), 64) + 1, 1) & MID(_B64, MOD(_n12, 64) + 1, 1), (_n12 < 262144) + (_n12 < 4096) + (_n12 < 64) + 1, 4))))
			        -- licences des federations hors champ constant (annee, annee - 1, 2019), retirees des evolutions par le moteur
			        VAR _x1 = COALESCE(MAXX(FILTER(_S, F_Licences[Code_DEP] = _k && F_Licences[Annee] = _An), [@bx]), "0")
			        VAR _x2 = COALESCE(MAXX(FILTER(_S, F_Licences[Code_DEP] = _k && F_Licences[Annee] = _An - 1), [@bx]), "0")
			        VAR _x3 = COALESCE(MAXX(FILTER(_S, F_Licences[Code_DEP] = _k && F_Licences[Annee] = _AnRef), [@bx]), "0")
			        VAR _xs = IF(_x3 <> "0", _x1 & "." & _x2 & "." & _x3, IF(_x2 <> "0", _x1 & "." & _x2, IF(_x1 <> "0", _x1, "")))
			        RETURN "['" & SUBSTITUTE(SUBSTITUTE(T_Territoire[Departement], "\", "\\"), "'", "\'") & "',''," & _ci & "," & IF(_Fil && _k IN _SelSet, 1, 0) & ",'" & _se & "." & _pp & "." & _qt & "','" & _tp & "'" & IF(_CCA && _xs <> "", ",'" & _xs & "'") & "]",
			        ",", [@Lic], DESC)
			VAR _Data =
			    "var Y=[" & CONCATENATEX(_Yrs, [@y], ",", [@y], ASC) & "],AN=" & _An & ",REF=" & _AnRef
			    & ",AP=" & IF(ISFILTERED(T_TrancheAge), 1, 0)
			    & ",SX='" & _Sx & "',AG='" & _Ag & "',GE='" & SUBSTITUTE(_GeL, "'", "\'") & "',AGL='" & SUBSTITUTE(_AgL, "'", "\'") & "'"
			    & ",CCA=" & IF(_CCA, 1, 0) & ",K='T',TI='Comparaison des territoires',IL='Département',NV='Région',LV='" & _LV & "',RG=" & IF(_RG, 1, 0) & ",FS=" & IF(_FS, 1, 0) & ",POP=0"
			    & ",TN='" & _TN & "',B1='" & SUBSTITUTE([Sélection libellé], "'", "\'") & "',FN=[" & _FN & "],GT=[" & _GT & "],TT='" & _TT & "'"
			    & ",G=[" & _G & "],F=[" & _F & "];"
			RETURN
			    "<style>" & [HTML Comparaison CSS] & "</style><div id=hd></div><div id=sf>Chargement… (nécessite l'édition standard de HTML Content)</div><div id=sftip></div>"
			    & "<script>" & _Data & [HTML Tableau JS] & "</script>"
		displayFolder: 08. Pages Comparer
		lineageTag: 0f68d315-07e6-47c6-ae28-3ec0401c4dc8

	/// Date de dernière actualisation du modèle (table T_MAJ), au format jj/mm/aaaa.
	measure 'Date MAJ' =
			VAR _d = MAX(T_MAJ[Actualisé le])
			RETURN IF(NOT ISBLANK(_d), FORMAT(_d, "dd/mm/yyyy"))
		displayFolder: 05. Sélection et libellés
		lineageTag: a426aa3c-30cb-4c75-afc8-92b7dc37c13e

	/// Bloc Sources du panneau gauche (HTML Content ~230 x 230, fond transparent). Liens cliquables : activer Autoriser l'ouverture des URL dans le format du visuel.
	measure 'HTML Sources' =
			-- =====================================================================
			-- HTML Sources | panneau gauche (fond bleu nuit) | visuel HTML Content ~230 x 330, arrière-plan transparent
			-- Liens cliquables : Format du visuel > Mise en forme du contenu > Autoriser l'ouverture des URL = Activé
			-- =====================================================================
			VAR _Auteur   = "Quentin Diouet"
			VAR _UrlInjep = "https://injep.fr/donnee/recensement-des-licences-et-clubs-sportifs-2025/#tab02"
			VAR _UrlInsee = "https://www.insee.fr/fr/statistiques/8721456"
			VAR _AnMin    = MINX(ALL(T_Annee[Annee]), VALUE(T_Annee[Annee]))
			VAR _AnMax    = MAXX(ALL(T_Annee[Annee]), VALUE(T_Annee[Annee]))
			VAR _Statut   = CALCULATE(MAX(T_Annee[Statut]), REMOVEFILTERS(T_Annee), T_Annee[Annee] = FORMAT(_AnMax, "0"))
			VAR _Semi     = CONTAINSSTRING(_Statut, "semi")
			VAR _Maj      = [Date MAJ]
			-- styles
			VAR _Tit  = "font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#C7D0FB;display:flex;align-items:center;gap:6px;margin-bottom:10px"
			VAR _Item = "font-size:13px;line-height:1.45;color:#E4E7EC;margin-bottom:12px"
			VAR _Btn  = "display:inline-flex;align-items:center;gap:5px;margin-top:5px;padding:3px 10px;border-radius:999px;background:#4361EE;color:#FFFFFF;font-size:12px;font-weight:600;text-decoration:none"
			VAR _Fl   = "<svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='#FFFFFF' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'><path d='M7 17L17 7M9 7h8v8'/></svg>"
			VAR _Pet  = "font-size:12px;line-height:1.45;color:#A9B4D9"
			VAR _Ico  = "<svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='#C7D0FB' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 4h12l4 4v12H4z'/><path d='M8 12h8M8 16h6'/></svg>"
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;padding:2px 4px'>"
			    & "<div style='" & _Tit & "'>" & _Ico & "Sources</div>"
			    & "<div style='" & _Item & "'><b style='color:#FFFFFF'>INJEP-MEDES</b> · Recensement des licences et clubs sportifs, fédérations agréées, " & _AnMin & "-" & _AnMax & IF(_Semi, " (" & _AnMax & " semi-définitif)") & ".<br><a href='" & _UrlInjep & "' target='_blank' style='" & _Btn & "'>Voir la source " & _Fl & "</a></div>"
			    & "<div style='" & _Item & "'><b style='color:#FFFFFF'>Insee</b> · Estimation de la population au 1er janvier, par département, sexe et âge (parution du 13/01/2026).<br><a href='" & _UrlInsee & "' target='_blank' style='" & _Btn & "'>Voir la source " & _Fl & "</a></div>"
			    & "<div style='" & _Pet & "'>Traitements : " & _Auteur & ". Les chiffres présentés et leur interprétation n'engagent que leur auteur.</div>"
			    & IF(NOT ISBLANK(_Maj), "<div style='" & _Pet & ";margin-top:8px;color:#C7D0FB'>Mise à jour : <b style='color:#FFFFFF'>" & _Maj & "</b></div>")
			    & "</div>"
		displayFolder: 09. Panneau gauche
		lineageTag: 079d1620-31eb-497a-913f-fb30fcfc8b81

	/// Carte Auteur du panneau gauche (HTML Content ~230 x 200, fond transparent) : nom, titre, lien LinkedIn (à renseigner) et projet GitHub, e-mail. Liens : activer Autoriser l'ouverture des URL ; e-mail sélectionnable : activer Autoriser la sélection de texte.
	measure 'HTML Auteur' =
			-- =====================================================================
			-- HTML Auteur | panneau gauche (fond bleu nuit) | visuel HTML Content ~230 x 220, arrière-plan transparent
			-- Carte blanche pour ressortir sur le bandeau bleu.
			-- Liens : Format du visuel > Mise en forme du contenu > Autoriser l'ouverture des URL = Activé
			-- E-mail copiable : Autoriser la sélection de texte = Activé (le lien mailto n'est pas ouvert par le visuel)
			-- =====================================================================
			VAR _Nom       = "Quentin Diouet"
			VAR _Initiales = "QD"
			VAR _Titre     = "Consultant indépendant<br>Data Analyst · Power BI"
			VAR _LinkedIn  = "https://www.linkedin.com/in/quentin-diouet"
			VAR _Projet    = "https://github.com/diouetq/PowerBI-Projects/tree/main/LicencesFederations"
			VAR _Mail      = "diouet.pro@gmail.com"
			-- styles
			VAR _Btn = "display:flex;align-items:center;justify-content:center;gap:7px;flex:1;height:36px;border-radius:8px;font-size:14px;font-weight:600;text-decoration:none;color:#FFFFFF"
			VAR _IcoIn  = "<svg width='16' height='16' viewBox='0 0 24 24' fill='#FFFFFF'><path d='M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z'/></svg>"
			VAR _IcoGh  = "<svg width='17' height='17' viewBox='0 0 24 24' fill='#FFFFFF'><path d='M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3'/></svg>"
			VAR _IcoMail = "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#475467' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='5' width='18' height='14' rx='2'/><path d='M3 7l9 6 9-6'/></svg>"
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#101828;padding:14px;border-radius:12px;background:#FFFFFF;box-shadow:0 4px 14px rgba(0,0,0,.25)'>"
			    & "<div style='display:flex;align-items:center;gap:12px'>"
			    & "<div style='flex:none;width:46px;height:46px;border-radius:50%;background:#4361EE;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:17px'>" & _Initiales & "</div>"
			    & "<div style='min-width:0'><div style='font-size:18px;font-weight:700;line-height:1.2'>" & _Nom & "</div>"
			    & "<div style='font-size:14px;color:#475467;line-height:1.35;margin-top:3px'>" & _Titre & "</div></div></div>"
			    & "<div style='display:flex;gap:6px;margin-top:12px'>"
			    & IF(_LinkedIn <> "", "<a href='" & _LinkedIn & "' target='_blank' style='" & _Btn & ";background:#0A66C2'>" & _IcoIn & "LinkedIn</a>")
			    & "<a href='" & _Projet & "' target='_blank' style='" & _Btn & ";background:#0B1C4F'>" & _IcoGh & "GitHub</a>"
			    & "</div>"
			    & "<div style='display:flex;align-items:center;gap:7px;margin-top:10px;font-size:14px;color:#344054;user-select:all'>" & _IcoMail & _Mail & "</div>"
			    & "</div>"
		displayFolder: 09. Panneau gauche
		lineageTag: f8cbfa55-b7e1-4e03-ab06-3117e84ec0db

	/// Assistant : feuille de style (minifiée) du panneau. Les couleurs et tailles sont des variables --as-* posées par HTML Assistant UI depuis la charte. Source lisible : src/html/assistant/src/assistant.css (régénérer avec src/html/assistant/build.js). Ne pas utiliser de guillemets doubles.
	measure 'HTML Assistant CSS' =
			"html,body{margin:0;padding:0;background:transparent}#as{--as-v2:#7C5CF6;--as-grad:linear-gradient(135deg,var(--as-accent),var(--as-v2));position:fixed;inset:0;display:flex;flex-direction:column;font-family:var(--as-police);font-size:calc(var(--as-t) + 3px);color:var(--as-texte);background:linear-gradient(180deg,#F5F3FF 0%,#EEF2FF 45%,#F8FAFF 100%);box-sizing:border-box;overflow:hidden;border-radius:18px}#as *{box-sizing:border-box}#as button{font-family:inherit;cursor:pointer}#as b{font-weight:650}.as-tete{display:flex;align-items:center;gap:14px;padding:18px 18px 14px}.as-logo{flex:none;width:46px;height:46px;border-radius:14px;background:var(--as-grad);display:flex;align-items:center;justify-content:center;box-shadow:0 6px 16px rgba(91,76,240,.35)}.as-id{flex:1;min-width:0}.as-titre{display:flex;align-items:center;flex-wrap:wrap;gap:8px;font-size:calc(var(--as-t) + 8px);font-weight:700;line-height:1.15;color:var(--as-marine)}.as-badge{font-size:calc(var(--as-p) - 1px);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--as-v2);background:#fff;border:1.5px solid var(--as-v2);border-radius:999px;padding:2px 9px;line-height:1.3}.as-sous{font-size:calc(var(--as-p) + 1px);color:var(--as-texte2);margin-top:4px;line-height:1.35}.as-nouv{flex:none;width:42px;height:42px;border-radius:12px;border:1px solid #DCD7FE;background:#fff;color:var(--as-v2);display:flex;align-items:center;justify-content:center;transition:all .15s}.as-nouv:hover{background:var(--as-grad);color:#fff;border-color:transparent}.as-fil{flex:1;overflow-y:auto;padding:6px 18px 16px;display:flex;flex-direction:column;gap:14px;scroll-behavior:smooth}.as-fil::-webkit-scrollbar{width:8px}.as-fil::-webkit-scrollbar-thumb{background:#D6D1FB;border-radius:8px}.as-accueil{display:flex;flex-direction:column;gap:14px}.as-hero{display:flex;align-items:flex-start;gap:12px}.as-robot{flex:none;width:84px;height:84px;filter:drop-shadow(0 8px 14px rgba(67,97,238,.28))}.as-bienv{flex:1;background:rgba(255,255,255,.85);border:1px solid #E4E0FD;border-radius:18px;border-top-left-radius:6px;padding:14px 16px;line-height:1.5;box-shadow:0 4px 18px rgba(67,56,202,.08)}.as-bienv .as-h{font-size:calc(var(--as-t) + 6px);font-weight:700;color:var(--as-marine);margin-bottom:6px}.as-bienv p{margin:0 0 8px}.as-bienv p:last-child{margin:0}.as-sim{display:flex;gap:8px;align-items:flex-start;background:#F3F0FF;border:1px dashed #B9AEFB;border-radius:12px;padding:9px 11px;font-size:calc(var(--as-p) + 1px);color:#4B3FA8;line-height:1.4}.as-sim svg{flex:none;margin-top:2px}.as-ex{font-weight:700;color:var(--as-marine);margin-top:2px}.as-onglets{display:flex;flex-wrap:wrap;gap:8px}.as-onglet{border:1px solid #DCD7FE;background:rgba(255,255,255,.8);color:var(--as-texte2);border-radius:999px;padding:6px 14px;font-size:calc(var(--as-p) + 1px);transition:all .15s}.as-onglet:hover{border-color:var(--as-v2);color:var(--as-v2)}.as-onglet.as-on{background:var(--as-grad);border-color:transparent;color:#fff;box-shadow:0 4px 10px rgba(91,76,240,.3)}.as-liste{display:flex;flex-direction:column;gap:9px}.as-rel{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.as-sugg{display:inline-flex;align-items:center;gap:10px;align-self:flex-start;max-width:100%;text-align:left;border:1px solid #E1DCFD;background:#fff;color:var(--as-marine);border-radius:999px;padding:9px 16px;font-size:calc(var(--as-t) + 1px);line-height:1.3;box-shadow:0 2px 6px rgba(67,56,202,.07);transition:all .15s}.as-sugg::before{content:'\2192';flex:none;color:var(--as-v2);font-weight:700}.as-sugg:hover{border-color:var(--as-v2);background:#F6F4FF;transform:translateX(2px)}.as-rel .as-sugg{padding:6px 13px;font-size:calc(var(--as-p) + 1px)}.as-ligne{display:flex;gap:10px;align-items:flex-start}.as-av{flex:none;width:34px;height:34px;border-radius:11px;background:var(--as-grad);display:flex;align-items:center;justify-content:center;margin-top:2px}.as-msg{line-height:1.5;border-radius:18px;padding:12px 15px}.as-msg p{margin:0 0 8px}.as-msg p:last-child{margin-bottom:0}.as-moi{align-self:flex-end;background:var(--as-grad);color:#fff;border-bottom-right-radius:6px;max-width:85%;box-shadow:0 4px 12px rgba(91,76,240,.25)}.as-ia{flex:1;min-width:0;background:#fff;border:1px solid #E8E5FD;border-top-left-radius:6px;box-shadow:0 4px 16px rgba(67,56,202,.07)}.as-appar{animation:asIn .3s ease-out}@keyframes asIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}.as-attente{flex:none;display:flex;gap:5px;padding:14px 16px}.as-attente span{width:8px;height:8px;border-radius:50%;background:var(--as-v2);animation:asPt 1s infinite}.as-attente span:nth-child(2){animation-delay:.15s}.as-attente span:nth-child(3){animation-delay:.3s}@keyframes asPt{0%,80%,100%{opacity:.25;transform:translateY(0)}40%{opacity:1;transform:translateY(-3px)}}.as-chapo{color:var(--as-discret);font-size:var(--as-t)}.as-info{color:var(--as-texte2);font-size:var(--as-t);border-left:3px solid var(--as-v2);padding-left:9px}.as-note{color:var(--as-discret);font-size:calc(var(--as-p) + 0px);margin-top:8px!important}.as-up{color:var(--as-hausse);font-weight:650}.as-down{color:var(--as-baisse);font-weight:650}.as-neutre{color:var(--as-texte2)}.as-tab{width:100%;border-collapse:collapse;margin:8px 0 6px;font-size:calc(var(--as-p) + 1px);background:#FBFAFF;border-radius:10px;overflow:hidden}.as-tab th{text-align:left;font-weight:650;color:var(--as-discret);padding:7px 8px;border-bottom:1px solid #E4E0FD;white-space:nowrap}.as-tab td{padding:6px 8px;border-bottom:1px solid #EFEDFB;vertical-align:middle}.as-tab tr:last-child td{border-bottom:0}.as-tab td:first-child{max-width:210px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.as-num{text-align:right!important;white-space:nowrap;font-variant-numeric:tabular-nums}.as-barre{width:20%;min-width:44px}.as-barre span{display:block;height:8px;border-radius:5px;background:var(--as-grad)}.as-barre span.as-neg{background:var(--as-baisse)}.as-serie{display:flex;align-items"
			& ":flex-end;gap:5px;height:100px;margin:10px 0 8px;padding:0 2px}.as-serie div{flex:1;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center}.as-serie span{width:100%;background:var(--as-grad);border-radius:4px 4px 0 0}.as-serie i{font-style:normal;font-size:calc(var(--as-p) - 2px);color:var(--as-discret);margin-top:4px}.as-graph{margin:10px 0 6px;background:#FBFAFF;border:1px solid #EFEDFB;border-radius:12px;padding:8px 8px 6px}.as-svg{display:block;width:100%;height:auto;max-height:300px}.as-carte .as-svg{max-width:460px;max-height:340px;margin:0 auto}.as-ax{font-size:11px;fill:#8A94A6}.as-tk{font-size:13px;font-weight:700}.as-tv{font-size:12.5px;font-weight:600}.as-leg{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:6px 14px;font-size:calc(var(--as-p) - 1px);color:var(--as-texte2);margin-top:4px}.as-leg i{display:inline-block;width:12px;height:4px;border-radius:2px;margin-right:6px;vertical-align:middle}.as-ech{display:inline-block;width:120px;height:9px;border-radius:5px}.as-analyse{display:flex;gap:9px;align-items:flex-start;background:linear-gradient(90deg,#F3F0FF,#F8F7FF);border-radius:12px;padding:10px 12px;margin-top:10px!important;color:#3F3592;font-size:var(--as-t);line-height:1.45}.as-analyse svg{flex:none;margin-top:1px;color:var(--as-v2)}.as-ctx{background:#fff;border:1px solid #DCD7FE;border-left:4px solid var(--as-v2);border-radius:14px;padding:12px 14px;display:flex;flex-direction:column;gap:10px}.as-ctx-t{display:flex;gap:8px;align-items:center;color:var(--as-marine)}.as-ctx-t svg{color:var(--as-v2);flex:none}.as-saviez{background:linear-gradient(135deg,#FFF8E6,#FFF3D6);border:1px solid #F5DFA6;border-radius:14px;padding:12px 14px}.as-saviez-t{display:flex;gap:7px;align-items:center;color:#8A5A00;margin-bottom:4px}.as-saviez-t svg{color:#D69B00}.as-saviez p{margin:0 0 6px;line-height:1.45}.as-lien{border:0;background:none;color:var(--as-v2);font-weight:650;padding:0;font-size:calc(var(--as-p) + 1px)}.as-lien:hover{text-decoration:underline}.as-calc{margin-top:10px;border-top:1px dashed #E4E0FD;padding-top:8px}.as-calc summary{cursor:pointer;color:var(--as-v2);font-size:calc(var(--as-p) + 0px);font-weight:600;list-style:none}.as-calc summary::before{content:'\24D8';margin-right:6px}.as-calc-c{margin-top:6px;background:#FBFAFF;border-radius:10px;padding:9px 12px;font-size:var(--as-t);line-height:1.45}.as-fiche-t{font-size:calc(var(--as-t) + 6px);font-weight:700;color:var(--as-marine);margin-bottom:2px!important}.as-sect{font-weight:700;color:var(--as-marine);margin-top:14px!important;padding-top:10px;border-top:1px solid #EFEDFB}.as-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin:10px 0}.as-kpi{background:#FBFAFF;border:1px solid #EFEDFB;border-radius:12px;padding:9px 11px;display:flex;flex-direction:column;gap:2px}.as-kpi span{font-size:calc(var(--as-p) - 1px);color:var(--as-discret)}.as-kpi b{font-size:calc(var(--as-t) + 7px);color:var(--as-marine);line-height:1.2}.as-kpi i{font-style:normal;font-size:calc(var(--as-p) - 1px);color:var(--as-texte2)}.as-pied{padding:10px 16px 12px}.as-saisie{display:flex;gap:10px;align-items:center;background:#fff;border:1.5px solid #DCD7FE;border-radius:18px;padding:7px 7px 7px 16px;box-shadow:0 6px 18px rgba(67,56,202,.10);transition:all .15s}.as-saisie:focus-within{border-color:var(--as-v2);box-shadow:0 0 0 4px rgba(124,92,246,.15)}.as-saisie textarea{flex:1;resize:none;border:0;background:transparent;padding:8px 0;font-family:inherit;font-size:calc(var(--as-t) + 2px);color:var(--as-texte);line-height:1.35;outline:none;max-height:110px}.as-saisie textarea::placeholder{color:#98A2B3}.as-env{width:46px;height:46px;border-radius:50%;border:0;background:var(--as-grad);color:#fff;display:flex;align-items:center;justify-content:center;flex:none;box-shadow:0 4px 12px rgba(91,76,240,.35);transition:transform .15s}.as-env:hover{transform:scale(1.06)}.as-avert{display:flex;gap:7px;align-items:flex-start;justify-content:center;margin:10px 4px 0;font-size:var(--as-p);color:var(--as-discret);line-height:1.35;text-align:center}.as-avert svg{flex:none;margin-top:2px}@media (min-width:760px){.as-tete{padding:20px max(28px,calc((100% - 1040px) / 2)) 14px}.as-fil{padding:6px max(28px,calc((100% - 1040px) / 2)) 18px}.as-pied{padding:10px max(28px,calc((100% - 1040px) / 2)) 14px}.as-robot{width:96px;height:96px}.as-liste{flex-direction:row;flex-wrap:wrap}.as-moi{max-width:70%}.as-ligne{max-width:88%}.as-serie{max-width:640px}}"
		displayFolder: 10. Assistant
		lineageTag: def4516a-dc03-49d9-96e6-6e97943aa1fb

	/// Assistant : textes rédigés (définitions, méthode, usage du rapport, fiches). Format : clé|question|mots-clés séparés par des virgules|réponse HTML, enregistrements séparés par ~. Clés : def:, info:, use:, fiche:<code fédération>. Source lisible : src/html/assistant/src/assistant-textes.txt. Ne pas utiliser de guillemets doubles, ni | ni ~ dans les textes.
	measure 'HTML Assistant Textes' =
			"<script type='text/plain' class='as-d' data-t='txt'>def:licence|Une licence, c’est quoi ?|une licence,licence c est,licencie,une personne,licence personne,c est une personne,nombre de sportif,pratiquant|Une <b>licence</b> est l’adhésion annuelle à une fédération sportive, prise le plus souvent dans un club. Les chiffres comptent donc des licences et non des personnes : une personne inscrite dans deux fédérations est comptée deux fois. La pratique sportive en dehors des fédérations n’est pas couverte.~def:p100|Licences pour 1 000 habitants|pour 1000,pour mille,1000 habitant,pour 100,par habitant,100 habitant,taux de licence,densite|Les <b>licences pour 1 000 habitants</b> rapportent le nombre de licences à la population Insee au 1er janvier de la même année, pour le même sexe et la même tranche d’âge. Seuls les départements qui ont une population Insee entrent dans le calcul : les COM, Monaco, l’étranger et les licences non réparties sont exclus. C’est l’indicateur le plus juste pour comparer des territoires de tailles différentes.~def:indice|Indice de spécificité|specificite,indice,surrepresent,sur represent,typique|L’<b>indice de spécificité</b> compare le poids d’une fédération dans un territoire à son poids dans l’ensemble des licences (tous territoires confondus). Exemple : si le rugby pèse 3 % des licences en Occitanie et 1,5 % au total, l’indice vaut 2 : le rugby y est deux fois plus présent que la moyenne. Un indice de 1 signifie le même poids qu’au total, en dessous de 1 un poids plus faible.~def:part|Part dans l’ensemble|part dans l ensemble,part,poids,pourcentage|La <b>part dans l’ensemble</b> est le poids de la sélection parmi toutes les licences du même territoire, de la même année et du même public. Elle se lit avec l’indice de spécificité, qui compare cette part à celle de l’ensemble des licences.~def:evo|Évolutions|evolution,evol,variation,1 an,sur un an,progression|Deux évolutions sont calculées : <b>sur 1 an</b>, par rapport à l’année précédente, et <b>depuis 2019</b>, la dernière saison complète avant la crise sanitaire. Elles comparent les licences à filtres identiques (territoire, sexe, âge). Pour un regroupement, un territoire ou le total, elles sont calculées <b>à champ constant</b> (méthode INJEP) : seules les fédérations présentes chaque année de la période comptent ; une fédération seule garde sa propre évolution.~info:2019|Pourquoi comparer à 2019 ?|pourquoi 2019,pourquoi comparer a 2019,comparer a 2019,pourquoi compare,2019,covid,crise sanitaire,avant covid,reference|<b>2019</b> est la dernière année complète avant la crise sanitaire. Les licences ont fortement chuté avec les confinements et la fermeture des équipements, puis sont remontées. Comparer à 2019 permet de savoir si une fédération a retrouvé, dépassé ou non son niveau d’avant crise.~def:femmes|Part de femmes|part de femme,femme,feminin,mixite,feminisation|La <b>part de femmes</b> est le nombre de licences féminines divisé par l’ensemble des licences, y compris les quelques licences dont le sexe n’est pas renseigné. Elle ne tient pas compte du segment Sexe.~def:age|Âge moyen et tranches d’âge|age moyen,age,tranche,enfant,senior,jeune|L’<b>âge moyen</b> est l’âge au 1er janvier, pondéré par le nombre de licences ; les licences sans âge sont exclues. Les tranches suivent les grandes catégories de l’INJEP : enfants (1-13 ans), jeunes (14-20), adultes (21-55) et seniors (56 et plus).~info:nr|Licences non réparties|non reparti,non repartie,nr,sans departement,comparable,fiabilite|Une partie des licences n’a pas de sexe, d’âge ou de département connu : elles sont classées <b>non réparties</b>. Elles comptent dans le total France mais dans aucun territoire. L’INJEP prévient que les répartitions par sexe, âge et territoire sont moins comparables dans le temps à cause de ces non-répartis.~info:sources|D’où viennent les données ?|source,donnee,d ou vien,injep,insee,medes,fiable,origine|Les licences viennent du <b>recensement des licences sportives de l’INJEP-MEDES</b> (licences annuelles 2016-2025, millésime 2025), qui couvre plus d’une centaine de fédérations agréées. La population vient de l’<b>Insee</b> (estimations au 1er janvier par département, sexe et âge). Les liens sont dans le bloc Sources du panneau de gauche.~info:maj|Mise à jour|mise a jour,a jour,actualis,date,quand,recent,derniere annee|Les données sont annuelles : la dernière année disponible est 2025. La date de la dernière actualisation du rapport est affichée en bas du panneau de gauche.~def:annee|Que représente une année ?|annee,saison,millesime,recensement|L’année est celle du recensement : selon les fédérations, elle correspond à la saison N ou à la saison N-1/N. Les années sont comparables entre elles pour une même fédération.~def:regroupement|Familles, sous-familles et groupes|famille,sous famille,groupe,regroupement,olympique,affinitaire,delegataire,categorie|Les fédérations sont classées à trois niveaux : la <b>famille</b> (sports collectifs, sports de nature…), la <b>sous-famille</b> (sports raquettes, arts martiaux…) et le <b>groupe</b> : olympique, délégataire non olympique, affinitaire (multisports), para-sport et scolaire. Le segment Niveau choisit lequel utiliser.~def:territoire|Zones et territoires|zone,territoire,drom,com,metropole,outre mer,monaco,etranger,france entiere|Le territoire <b>Total</b> regroupe toutes les licences. Il se découpe en Métropole (13 régions), DROM (Guadeloupe, Martinique, Guyane, La Réunion, Mayotte), COM (collectivités d’outre-mer), Autres (Monaco, étranger) et non répartis. Les COM et les Autres n’ont pas de population Insee.~def:base100|Vue Base 100|base 100,indice 100,volume,graphique d evolution|La vue <b>Base 100</b> du graphique d’évolution ramène chaque courbe à 100 la première année. Elle compare des rythmes d’évolution entre la sélection, son regroupement et l’ensemble, quelle que soit leur taille. La vue Volume montre les nombres de licences.~use:federation|Comment choisir une fédération ?|c"
			& "hoisir une federation,choisir un sport,selectionner une federation,filtrer,changer de federation,choisir federation,segment federation|Dans le panneau de gauche, choisissez d’abord le <b>Niveau</b> (famille, sous-famille ou groupe), puis un <b>Regroupement</b>, puis une ou plusieurs <b>Fédérations</b>. Choisir un regroupement réduit la liste des fédérations. « Ensemble » revient à toutes les fédérations.~use:territoire|Comment choisir un territoire ?|choisir un departement,choisir une region,choisir un territoire,selectionner un departement,filtrer par region,changer de region,departement|Dans le panneau de gauche, choisissez une <b>Région ou zone</b>, puis si besoin un <b>Département</b>. La carte de la page Portrait passe alors au niveau des départements de ce territoire.~use:annee|Comment changer d’année ?|choisir une annee,changer d annee,annee,segment annee|Le segment <b>Année</b> du panneau de gauche choisit l’année affichée. Si plusieurs années sont cochées, le rapport prend la plus récente, pour ne jamais additionner des années entre elles. Le graphique d’évolution montre toujours toute la période.~use:public|Comment filtrer par sexe ou par âge ?|sexe,age,filtrer les femmes,tranche d age,public|Les segments <b>Sexe</b> et <b>Âge</b> du panneau de gauche filtrent tout le rapport. Ils apparaissent en pastilles orange dans l’en-tête de la page Portrait quand ils sont actifs. Mes réponses, elles, portent toujours sur l’ensemble des licences.~use:carte|Comment changer l’indicateur de la carte ?|carte,indicateur de la carte,changer d indicateur,niveau geographique,region ou departement|Au-dessus de la carte de la page Portrait, choisissez l’<b>indicateur</b> (licences, pour 1 000 habitants, évolutions, indice de spécificité…) et le niveau <b>Région</b> ou <b>Département</b>. Survolez une zone pour voir sa valeur.~use:comparer|Comment comparer des fédérations ou des territoires ?|comparer,comparaison,page comparer,tableau,trier,classer|Les pages <b>Comparer les fédérations</b> et <b>Comparer les territoires</b> présentent un tableau interactif : cliquez sur un en-tête pour trier, survolez une ligne pour le détail. Vous pouvez aussi me demander directement « compare le judo et le karaté » ou « compare la Bretagne et la Normandie ».~use:reinit|Comment effacer les filtres ?|effacer,reinitialis,enlever les filtre,supprimer les filtre,remettre a zero,tout deselectionner|Survolez un segment et cliquez sur la petite gomme en haut à droite pour l’effacer. Sans aucun choix, le rapport montre l’ensemble des fédérations sur le territoire Total.~use:evolution|Comment lire le graphique d’évolution ?|lire le graphique,graphique d evolution,courbe,volume ou base 100|Le graphique d’évolution de la page Portrait trace trois courbes : votre <b>sélection</b>, son <b>regroupement</b> et l’<b>ensemble</b> des fédérations. Le bouton Volume / Base 100 change l’échelle.~info:assistant|Qui suis-je ?|assistant,qui es tu,ia,intelligence artificielle,robot,comment tu fonctionne|Je suis un simulateur d’assistant IA, intégré au rapport. Je ne suis pas une IA générative : je reconnais les mots de votre question (sport, territoire, indicateur, période) et je calcule la réponse sur les données mêmes du rapport. Mes chiffres sont donc identiques à ceux des pages. Je ne connais rien en dehors de ces données.~info:auteur|Qui a réalisé ce rapport ?|auteur,qui a fait,qui a realise,contact,createur,quentin|Ce rapport a été conçu par <b>Quentin Diouet</b>, consultant indépendant Data Analyst et Power BI. Ses coordonnées sont sur la carte Auteur du panneau de gauche.~info:limites|Ce que je ne sais pas faire|limite,tu ne sai pas,pourquoi le,cause,explique pourquoi,raison|Je calcule des chiffres, je n’explique pas les causes : une hausse peut venir d’un effet de mode, de grands événements, d’un changement de règle de licence… Je ne connais pas non plus les clubs, les résultats sportifs ni la pratique hors licence.~def:federation|Fédérations délégataires et affinitaires|federation affinitaire,federation delegataire,c est quoi une federation,delegataire,affinitaire,agree,multisport,difference entre|Une fédération <b>délégataire</b> a reçu de l’État la délégation d’une discipline : elle organise les compétitions officielles et délivre les titres. Une fédération <b>affinitaire</b> propose plusieurs sports, souvent dans une logique de loisir, d’entreprise ou d’affinité (UFOLEP, FSGT…). Les fédérations scolaires et universitaires forment un groupe à part.~def:champ|C’est quoi le champ constant ?|champ constant,a champ constant,constant,federation recente,federations recentes,nouvelle federation,total ne correspond,somme des federation,different de l injep,chiffre injep|Les <b>évolutions</b> sont calculées <b>à champ constant</b>, comme dans les publications de l’INJEP : seules les fédérations présentes chaque année de la période comptent. Sinon, une fédération qui entre dans le recensement (licences annuelles depuis 2022 ou 2023 : clubs omnisports, UCPA, sports canins…) ferait monter l’évolution sans aucun licencié de plus. Les <b>volumes</b>, eux, portent sur toutes les fédérations : pour un regroupement ou un territoire, le nombre de licences d’une année est donc un peu supérieur à la base des évolutions. Une fédération seule garde toujours sa propre évolution.</script>"
		displayFolder: 10. Assistant
		lineageTag: fa271bd5-9783-48f9-9e4b-c97657bb5036

	/// Assistant : moteur (minifié), partie 1. Lit les blocs de données (script.as-d de T_Assistant_Bloc), construit le modèle, calcule les indicateurs avec les règles des mesures du rapport, analyse la question. Partage ses fonctions par document.__as. Source lisible : src/html/assistant/src/assistant-1-moteur.js (régénérer avec src/html/assistant/build.js). Ne pas utiliser de guillemets doubles.
