	/// Charte : style du cadre blanc d'un bloc (fond, bordure, arrondi, marges). La hauteur est ajoutée par chaque visuel.
	measure 'Style CSS cadre' =
			-- Cadre blanc d'un bloc HTML (HTML Évolution, HTML Carte, HTML Qui).
			-- height:100vh!important : le cadre prend TOUJOURS la hauteur réelle du visuel (redimensionnement libre,
			-- jamais de barre de défilement). La valeur _HauteurCadre des mesures ne sert plus que de repère.
			"box-sizing:border-box;width:100%;height:100vh!important;display:flex;flex-direction:column;overflow:hidden;font-family:" & [Style Police]
			    & ";background:" & [Style Couleur fond cadre]
			    & ";border:1px solid " & [Style Couleur bordure]
			    & ";border-radius:14px;padding:16px 16px 12px 16px"
		displayFolder: 0. Style\Blocs CSS
		lineageTag: 9e62fb3a-e68f-42ec-a346-e22f046b7d17

	/// Charte : ligne qui porte la pastille de rubrique et le titre du bloc.
	measure 'Style CSS ligne titre' = "display:flex;align-items:center;gap:10px;flex-wrap:wrap"
		displayFolder: 0. Style\Blocs CSS
		lineageTag: 2adf02bc-40ae-4b27-addc-2fff3df43f61

	/// Charte : pastille de rubrique (COMBIEN, OÙ, QUI…).
	measure 'Style CSS rubrique' =
			-- Pastille de thème d'un bloc (ÉVOLUTION, TERRITOIRES, PROFIL)
			"font-size:13px;font-weight:700;letter-spacing:.08em;color:" & [Style Couleur accent]
			    & ";background:" & [Style Couleur accent fond] & ";border-radius:6px;padding:4px 9px"
		displayFolder: 0. Style\Blocs CSS
		lineageTag: 2d91bbbd-71df-49cb-a529-960fccd6e95c

	/// Charte : titre d'un bloc.
	measure 'Style CSS titre bloc' =
			-- Titre d'un bloc
			"font-size:" & [Style Taille titre] & "px;font-weight:600;letter-spacing:-.01em;color:" & [Style Couleur texte]
		displayFolder: 0. Style\Blocs CSS
		lineageTag: 9009f3d2-9698-4496-b32c-64ef67ae15f1

	/// Charte : sous-titre d'un bloc.
	measure 'Style CSS sous-titre' =
			-- Sous-titre d'un bloc (ce que montre le bloc, périmètre)
			"font-size:" & [Style Taille petit] & "px;color:" & [Style Couleur texte discret] & ";margin-top:4px;line-height:1.35"
		displayFolder: 0. Style\Blocs CSS
		lineageTag: 14e02863-d89d-469c-9c6c-ac4938ad6cba

	/// Charte : texte des légendes.
	measure 'Style CSS légende' =
			-- Texte des légendes
			"font-size:" & [Style Taille texte] & "px;line-height:1.3;color:" & [Style Couleur texte secondaire]
		displayFolder: 0. Style\Blocs CSS
		lineageTag: ca8961a5-ab1f-4844-be6b-d37a148cc620

	/// Cadre du bloc TERRITOIRES (visuel HTML Content placé sous la carte Azure Maps) : titre, sous-titre, légende des couleurs (même rendu que la carte), case « sans donnée », territoire choisi, message hors carte. Charte : dossier 0. Style.
	measure 'HTML Carte' =
			-- =====================================================================
			-- HTML Carte | bloc TERRITOIRES | page Portrait | visuel HTML Content ~745 x 500
			-- Visuel placé SOUS la carte Azure Maps (marges intérieures 0, arrière-plan désactivé) :
			-- la carte (fond transparent) se pose dans la zone vide entre le titre et la légende.
			-- =====================================================================
			-- 1. Réglages
			VAR _HauteurCadre   = 572      -- hauteur du visuel - 20 environ (barre de défilement sinon)
			VAR _PlaceSegments  = 380      -- place libre en haut à droite (segments Indicateur et Niveau géo)
			VAR _LargeurDegrade = 180      -- largeur de la barre de couleurs
			VAR _OpaciteCarte   = ".85"    -- même opacité que le remplissage des zones dans Azure Maps (à caler sur la carte)
			-- 2. Charte
			VAR _ColTxt  = [Style Couleur texte]
			VAR _ColSel  = [Style Couleur marine]          -- contour du territoire choisi sur la carte
			VAR _ColVide = [Style Couleur sans donnée]
			VAR _TxtPet  = [Style Taille petit]
			-- 3. Données
			VAR _Ind    = SELECTEDVALUE(T_CarteIndicateur[Ordre], 1)
			VAR _Nom    = SELECTEDVALUE(T_CarteIndicateur[Indicateur], "Licences")
			VAR _Diverg = _Ind IN {2, 3, 5}
			VAR _Centre = IF(_Ind = 5, 1, 0)
			VAR _Fmt    = SWITCH(_Ind, 1, "#,0", 4, "0.0 %", 5, "0.00", "+0.0 %;-0.0 %;0.0 %")
			VAR _Lo     = [Carte Min]
			VAR _Hi     = [Carte Max]
			VAR _Amp    = MAX(ABS(_Hi - _Centre), ABS(_Lo - _Centre))
			VAR _Pal    = [Carte Palette]
			VAR _C1     = LEFT(_Pal, 7)
			VAR _C2     = MID(_Pal, 9, 7)
			VAR _C3     = RIGHT(_Pal, 7)
			VAR _Niv    = [Carte Niveau]
			VAR _Force  = ISFILTERED(P_TerrDep) && SELECTEDVALUE(T_NiveauGeo[Ordre], 1) = 1
			VAR _Annee  = VALUE(MAX(T_Annee[Annee]))   -- T_Annee[Annee] est un texte
			VAR _Terr   = [Libellé territoire]
			VAR _SurCarte = NOT ISEMPTY(FILTER(ALL(T_CarteAffichage[Id carte]), [Carte Visible] = 1))
			VAR _SousTitre =
			    _Nom & IF(_Ind IN {1, 4, 5}, " " & _Annee, " (" & _Annee & ")")
			    & " · " & [Sélection libellé]
			    & " · " & IF(_Niv = 1, "par région", "par département" & IF(_Force, " (département choisi)"))
			VAR _L1 = IF(_Diverg, FORMAT(_Centre - _Amp, _Fmt), FORMAT(_Lo, _Fmt))
			VAR _L2 = IF(_Diverg, "<span>" & FORMAT(_Centre, _Fmt) & "</span>", "")
			VAR _L3 = IF(_Diverg, FORMAT(_Centre + _Amp, _Fmt), FORMAT(_Hi, _Fmt))
			-- 4. Note de lecture par indicateur (infobulle de la légende) et raison d'un calcul impossible
			VAR _Lecture =
			    SWITCH(_Ind,
			        1, "Nombre de licences de la sélection dans chaque zone.",
			        2, "Évolution des licences entre " & (_Annee - 1) & " et " & _Annee & " : vert = hausse, rouge = baisse.",
			        3, "Évolution des licences depuis 2019 (avant Covid) : vert = hausse, rouge = baisse.",
			        4, "Part des femmes parmi les licences de la zone.",
			        5, "Indice de spécificité : poids de la sélection dans la zone rapporté à son poids national.<br>Au-dessus de 1 = plus représentée qu'en moyenne.",
			        "")
			VAR _Raison =
			    SWITCH(_Ind,
			        2, "aucune licence en " & (_Annee - 1) & " pour comparer",
			        3, IF(_Annee <= 2019, "l'année choisie est antérieure ou égale à 2019", "aucune licence en 2019 pour comparer"),
			        "aucune licence pour cette sélection")
			-- 5. Titre
			VAR _Titre =
			    "<div style='padding-right:" & _PlaceSegments & "px'>"
			    & "<div style='" & [Style CSS ligne titre] & "'>"
			    & "<span style='" & [Style CSS rubrique] & "'>TERRITOIRES</span>"
			    & "<span style='" & [Style CSS titre bloc] & "'>Répartition territoriale</span></div>"
			    & "<div style='" & [Style CSS sous-titre] & "'>" & _SousTitre & "</div></div>"
			-- 6. Zone de la carte (vide : la carte Azure Maps se pose dessus) ou message hors carte
			VAR _Zone =
			    IF(_SurCarte,
			        "<div style='flex:1;min-height:0'></div>",
			        "<div style='flex:1;margin:14px 0 4px 0;border:1.5px dashed " & [Style Couleur bordure forte] & ";border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;padding:0 24px;" & [Style CSS légende] & "'>"
			        & "<b style='color:" & _ColTxt & ";font-size:" & [Style Taille texte] & "px'>Territoire hors carte</b>"
			        & "<span>La carte couvre la métropole. Les chiffres de la page portent sur : <b style='color:" & _ColTxt & "'>" & _Terr & "</b></span></div>")
			-- 7. Légende : chiffres AU-DESSUS du dégradé ; le dégradé est aligné en bas avec les autres éléments
			--    (case « sans donnée », territoire choisi) ; même opacité que la carte
			VAR _Choix =
			    IF(_Terr <> "Tous territoires",
			        "<div style='display:flex;align-items:center;gap:8px'><i style='flex:none;display:inline-block;width:16px;height:11px;border:2.5px solid " & _ColSel & ";border-radius:2px'></i>"
			        & "<span>Territoire choisi : <b style='color:" & _ColTxt & "'>" & _Terr & "</b></span></div>")
			VAR _CaseVide =
			    "<div class='tt' style='display:flex;align-items:center;gap:8px'><i style='flex:none;display:inline-block;width:16px;height:11px;border-radius:2px;background:" & _ColVide & ";opacity:" & _OpaciteCarte & "'></i><span>" & IF(_Ind = 1, "Aucune licence", "Non calculable") & "</span>"
			    & "<span class='tip'>" & IF(_Ind = 1, "Zone sans licence pour cette sélection.", "Indicateur non calculable dans la zone :<br>" & _Raison & ".") & "</span></div>"
			VAR _Degrade =
			    "<div class='tt' style='width:" & _LargeurDegrade & "px'>"
			    & IF(_Diverg, "<div style='display:flex;justify-content:space-between;font-size:13px;color:" & [Style Couleur texte discret] & "'><span>" & IF(_Ind = 5, "moins représentée", "baisse") & "</span><span>" & IF(_Ind = 5, "plus représentée", "hausse") & "</span></div>")
			    & "<div style='display:flex;justify-content:space-between;font-size:" & _TxtPet & "px;margin-bottom:4px'><span class='nb'>" & _L1 & "</span>" & _L2 & "<span class='nb'>" & _L3 & "</span></div>"
			    & "<div style='height:10px;margin-bottom:4px;border-radius:5px;opacity:" & _OpaciteCarte & ";background:linear-gradient(90deg," & _C1 & "," & _C2 & "," & _C3 & ")'></div>"
			    & "<span class='tip'><b>Note de lecture</b><br>" & _Lecture & "</span></div>"
			VAR _Alerte =
			    "<div class='tt' style='display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:8px;background:" & [Style Couleur filtre actif fond] & ";color:" & [Style Couleur filtre actif texte] & ";font-size:" & _TxtPet & "px'>"
			    & "<svg width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round'><circle cx='12' cy='12' r='9'/><path d='M12 8v5M12 16.5v.5'/></svg>"
			    & "<span><b style='font-weight:600'>" & _Nom & " non calculable</b> : " & _Raison & "</span>"
			    & "<span class='tip'>Les zones sont grisées. Choisissez un autre indicateur<br>ou élargissez la sélection.</span></div>"
			VAR _Legende =
			    IF(_SurCarte,
			        "<div style='display:flex;align-items:flex-end;justify-content:space-between;gap:10px 22px;flex-wrap:wrap;margin-top:8px;" & [Style CSS légende] & "'>"
			        & "<div style='display:flex;align-items:flex-end;gap:22px'>"
			        & IF(ISBLANK(_Hi), _Alerte, _Degrade & _CaseVide) & "</div>"
			        & _Choix
			        & "</div>")
			-- 8. Assemblage
			RETURN
			    [Style CSS commun]
			    & "<div style='" & [Style CSS cadre] & ";height:" & _HauteurCadre & "px;color:" & _ColTxt & "'>"
			    & _Titre & _Zone & _Legende & "</div>"
		displayFolder: 6. Portrait\HTML
		lineageTag: d1571e21-2e73-46f0-a9f0-356131150e8a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

