			displayFolder: Sport


		measure 'COULEUR_(Tableau Sport Police)' =
				
				
				SWITCH(
				    TRUE(),
				
				    ISINSCOPE(Dim_Sport[Sport]), "",
				
				    ISINSCOPE(Dim_Sport[Type_Sport]) && SELECTEDVALUE(Dim_Sport[Type_Sport]) = "Sports de NICHE", "blach",
				
				    ISINSCOPE(Dim_Sport[Type_Sport]) && SELECTEDVALUE(Dim_Sport[Type_Sport]) = "Sports MAJEURS", "blach",
				
				    "white"
				)
			displayFolder: Sport


