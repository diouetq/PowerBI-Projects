createOrReplace

	ref table Mesure

		measure 'COULEUR_(Tableau Sport KPI 0 Paris)' = ```
				
				
				-- 1. Identification du KPI sélectionné
				VAR _KPI_Actuel = SELECTEDVALUE(Dim_KPI[Nom_KPI])
				VAR _EstROI = (_KPI_Actuel = "KPI_(Paris)")
				
				-- 2. Logique de couleurs pour le ROI (Ta nouvelle palette)
				VAR PaletteViolet = 
				    SWITCH(TRUE(),
				        ISINSCOPE(Dim_Sport[Sport]), [COULEUR_(KPI Tableau Fond Ss Cat)],
				        ISINSCOPE(Dim_Sport[Type_Sport]) && SELECTEDVALUE(Dim_Sport[Type_Sport]) = "Sports de NICHE", [COULEUR_(KPI Tableau Fond Cat)],
				        ISINSCOPE(Dim_Sport[Type_Sport]) && SELECTEDVALUE(Dim_Sport[Type_Sport]) = "Sports MAJEURS", [COULEUR_(KPI Tableau Fond Cat)],
				        [COULEUR_(KPI Tableau Fond Total)]
				    )
				
				-- 3. Logique de couleurs standard (Ton ancienne palette - À AJUSTER)
				VAR PaletteStandard = 
				    SWITCH(TRUE(),
				        ISINSCOPE(Dim_Sport[Sport]), [COULEUR_(KPI No Tableau Fond Ss Cat)],
				        ISINSCOPE(Dim_Sport[Type_Sport]) && SELECTEDVALUE(Dim_Sport[Type_Sport]) = "Sports de NICHE", [COULEUR_(KPI No Tableau Fond Cat)],
				        ISINSCOPE(Dim_Sport[Type_Sport]) && SELECTEDVALUE(Dim_Sport[Type_Sport]) = "Sports MAJEURS", [COULEUR_(KPI No Tableau Fond Cat)],
				        [COULEUR_(KPI No Tableau Fond Total)]
				    )
				
				-- 4. Choix de la palette selon le contexte
				RETURN
				IF(_EstROI,  PaletteViolet,PaletteStandard)
				```
			displayFolder: Sport


